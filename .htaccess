<IfModule mod_rewrite.c>
        RewriteEngine On
        # Force HTTPS
        RewriteCond %{HTTPS} off
        RewriteCond %{HTTP:X-Forwarded-SSL} !on
        RewriteRule ^(.*)$ "https://%{HTTP_HOST}%{REQUEST_URI}" [R=301,L]
</IfModule>
### AutoSSL-Satellite Don't Edit Above This Line ###

# ---------------------------------------------------------------------------
# Kemet — served from the repo root of `main` (single-branch deployment).
# The built site and the Astro source live side by side; this file makes sure
# visitors only ever see the site, and fixes the SEO redirects.
#
# IMPORTANT: cPanel's AutoSSL writes its HTTPS-force block at the VERY TOP of
# this file. It must stay there (with its markers, above) so AutoSSL detects
# its own block and never prepends a duplicate — a duplicate dirties the git
# checkout and blocks `git pull` on the server.
# ---------------------------------------------------------------------------

Options -Indexes

# Branded 404 page.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# PERFORMANCE — compression + caching.
# Without these the server ships every page raw and re-validates every asset on
# every navigation, which is what makes a fast static site feel heavy.
# Everything is wrapped in <IfModule> so the site still serves correctly if a
# module is missing.
# ---------------------------------------------------------------------------

# --- Compression: HTML pages here average ~46KB and compress ~75%. ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Never re-compress formats that are already compressed.
  SetEnvIfNoCase Request_URI \.(?:woff2?|jpe?g|png|webp|avif|gif|ico|mp4|zip|gz)$ no-gzip dont-vary
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Caching ---
# Fonts, images and hashed CSS/JS never change under the same URL, so they are
# cached for a year. HTML is deliberately NOT cached long: pages must stay
# fresh for both visitors and crawlers after a publish, so it revalidates on
# every request (a 304 with no body, not a re-download).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2|webp|avif|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Sitemaps, llms.txt and robots.txt: fresh within the hour.
  <FilesMatch "\.(?:xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Content-encoding varies by client — keep proxy caches honest.
  Header append Vary Accept-Encoding

  # The PHP endpoints are machinery, not pages: the analytics collector, the
  # contact-form handler and the private dashboard. None of them belongs in a
  # search result, and the dashboard lists customer names, emails and phone
  # numbers — a single external link to it is enough for a crawler to find it.
  #
  # Sent as a HEADER, not only as a <meta> tag, because a meta robots tag is
  # only obeyed on an HTML response that the crawler renders; a POST handler or
  # a redirect never gets that far. And deliberately NOT a robots.txt Disallow:
  # that blocks the crawl, so the noindex would never be read, and Google can
  # still list a blocked URL it found from an external link. Crawlable and
  # explicitly noindex is the combination that actually keeps a URL out.
  <FilesMatch "\.php$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>

  # The machine-readable files — the sitemaps, llms.txt and llms-full.txt, the
  # search index, the season feed and the build stamp — are read by crawlers
  # and assistants, never meant to be a search result. Without this Search
  # Console files them under "Crawled – currently not indexed" beside real
  # pages, which reads like a problem and hides the pages that are one.
  # "noindex" alone (links still followed): Google keeps processing a sitemap
  # that carries it, and it has no bearing on assistants that fetch llms.txt.
  # robots.txt and the site-verification files are deliberately left alone.
  <FilesMatch "^(?:sitemap[a-z0-9-]*\.xml|llms(?:-full)?\.txt|search-index\.json|seasons\.json|build\.txt)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# Send the first byte before the whole page is assembled.
<IfModule mod_env.c>
  SetEnv no-gzip-flush 0
</IfModule>

RewriteEngine On

# REQUIRED. Without it, a relative rewrite target in a .htaccess file is
# resolved against the filesystem, and Apache emits the absolute server path in
# the Location header — /cuisine was 301'ing to
# https://kemet-travel.com/home/<user>/public_html/cuisine.html, which both 404s
# and discloses the account path. Reproduced on Apache 2.4 and fixed here.
RewriteBase /

# Basic-Auth credentials do not reach PHP under CGI/FastCGI: the web server
# consumes the Authorization header and PHP_AUTH_PW is never populated. Passing
# it through explicitly is what lets the password gate on stats.php see the
# password at all — without this line the dashboard rejects every attempt,
# including the right one.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# www → apex domain (301), keeping one canonical host.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Repo internals are not part of the website — hide them completely (404).
RewriteRule ^(?:\.git|src|scripts|public|node_modules|dist|\.claude|\.astro|_stats)(/|$) - [R=404,L]

# Project/config files that sit in the repo root must never be downloadable.
# Answered 404 rather than 403 on purpose: a crawler treats 403 as "exists but
# temporarily refused" and keeps coming back (Search Console was reporting
# /tsconfig.json as a blocked URL); a 404 makes it drop the URL for good.
RewriteRule ^(?:package(?:-lock)?\.json|astro\.config\.mjs|tsconfig\.json|README\.md|DEPLOYMENT\.md|ARCHITECTURE\.md|\.env.*|\.gitignore|\.publish-manifest)$ - [R=404,L]

# Astro source that co-lives in the repo root must never be served, even if a
# new source file ever lands outside the folders blocked above.
RewriteRule \.(?:ts|astro|mjs|sh)$ - [R=404,L]

# Shared PHP includes are never a URL. lib-auth.php holds the password gate; it
# is meant to be included by the private pages, never fetched, and a 404 is the
# right answer to anyone who asks for it directly. Including it still works —
# an include reads the filesystem, not the web server.
RewriteRule ^lib-[a-z-]+\.php$ - [R=404,L]

# A directory index has ONE public URL: the directory. /index.html and
# /de/index.html are 301'd to / and /de/ so the same document is never served
# at two addresses. Every internal link, canonical, hreflang and sitemap entry
# already uses the directory form (utils/links → publicPath), so these only
# ever catch an old bookmark or an external link.
RewriteRule ^index(?:\.html)?$ / [R=301,L]
RewriteRule ^([a-z]{2})/index\.html$ /$1/ [R=301,L]

# ── RETIRED: the visa section ───────────────────────────────────────────────
# visa.html, 50 per-nationality pages under visa/, the English visa guide and
# seven localised visa pages were removed. All 59 were indexed, so they are
# 301'd rather than left to 404: a redirect passes on whatever authority the
# URL had, a 404 throws it away, and Search Console counts 59 errors either
# way until the index catches up.
#
# The nationality pages go to the FAQ, which still answers "do I need a visa";
# each localised page goes to its own language's home page, because sending a
# Russian or Indonesian reader to an English FAQ is worse than the 404.
RewriteRule ^visa/[a-z-]+\.html$ /faq.html [R=301,L]
RewriteRule ^visa\.html$ /faq.html [R=301,L]
RewriteRule ^guides/egypt-visa-guide\.html$ /guides/egypt-travel-guide.html [R=301,L]
RewriteRule ^de/aegypten-visum\.html$ /de/ [R=301,L]
RewriteRule ^it/visto-egitto\.html$ /it/ [R=301,L]
RewriteRule ^es/visado-egipto\.html$ /es/ [R=301,L]
RewriteRule ^fr/visa-egypte\.html$ /fr/ [R=301,L]
RewriteRule ^ru/viza-v-egipet\.html$ /ru/ [R=301,L]
RewriteRule ^id/visa-mesir\.html$ /id/ [R=301,L]
RewriteRule ^ms/visa-mesir-untuk-rakyat-malaysia\.html$ /ms/ [R=301,L]

# Section names are BOTH a page and a folder: destinations.html is the page,
# destinations/ holds the detail pages. Left alone, Apache answers a bare
# /destinations by redirecting to /destinations/, finding no index.html inside,
# and — with indexes off — returning 403. Search Console reported exactly that.
# Turning DirectorySlash off lets the rule below route these itself.
DirectorySlash Off

# Canonical URLs are the real .html files. Internal links, canonicals and the
# sitemap all use .html, so crawlers never hit a redirect. As a courtesy, a
# manually-typed extensionless URL (/tours) or a bare section name
# (/destinations) is 301'd to its .html page. The first condition makes sure a
# folder that has its own index.html is never hijacked.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^.]+?)/?$ /$1.html [R=301,L]

# A folder that HAS its own index.html — /de, /it, /es — needs the trailing
# slash restored. DirectorySlash normally does this; with it off, Apache
# answered /de with a 403 because it would neither redirect nor serve the
# directory. Put the redirect back explicitly for exactly this case.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Any other bare folder — /images, /fonts — has no page behind it. Answer 404
# rather than the 403 that "indexes off" would otherwise produce, for the same
# crawler reason as above. The document root is excluded: it has an index.html.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# Fallback if mod_rewrite is ever unavailable: the blocks above are all
# rewrite-based, so keep a hard authz denial as a safety net in that case only.
# (When mod_rewrite IS present this block is skipped, so the 404s above win.)
<IfModule !mod_rewrite.c>
  <FilesMatch "^(package(-lock)?\.json|astro\.config\.mjs|tsconfig\.json|README\.md|DEPLOYMENT\.md|ARCHITECTURE\.md|\.env.*|\.gitignore|\.publish-manifest)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(ts|astro|mjs|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
