---
// /when-to-go.html — the twelve-month hub. Answers "when is the best time to
// visit Egypt" directly, then hands off to the month a reader actually has.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import AnswerBox from "@/components/aeo/AnswerBox.astro";
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import LeadCapture from "@/components/conversion/LeadCapture.astro";
import { months } from "@/data/months";
import { canonical } from "@/utils/links";
import { site, SITE_URL } from "@/config/site";
import { breadcrumb, answerPageSchema } from "@/schemas/jsonld";

const ROUTE = "when-to-go.html";

const faqs = [
  { q: "When is the best time to visit Egypt?", a: "October to April, and within that October, February and March are the strongest. October gives warm days plus a Red Sea still at summer temperature; February is the most comfortable month for the monuments; March offers nearly February's weather at lower prices. December and January have the best sightseeing weather of all, and the highest prices and crowds to match." },
  { q: "What is the cheapest month to visit Egypt?", a: "June, July and August inland, when Upper Egypt is very hot and hotel, boat and journey prices fall to their annual floor. The exception is the coast: the Red Sea and the Mediterranean North Coast are at their busiest and most expensive in exactly those months, driven by Egyptian, Gulf and European holidays." },
  { q: "What is the hottest month in Egypt?", a: "July, with 42–45°C common in Aswan and the low forties in Luxor. August is barely behind. The heat is dry, which makes it more bearable than the same figures elsewhere, but it requires an itinerary built around dawn starts and long afternoons indoors." },
  { q: "When is the best time for a Nile cruise?", a: "October to April. November through February gives the most comfortable temperatures on deck; October and March give nearly the same conditions with fewer people and lower prices. Some operators reduce sailings in high summer, so a June to August cruise needs checking early." },
  { q: "When is the best time for Red Sea diving?", a: "May, June, September and October. Water reaches 27–30°C through the summer and visibility is at its best in autumn. September and October are the sweet spot — warm water left over from summer, with the school-holiday crowds gone." },
  { q: "Should I avoid Ramadan when visiting Egypt?", a: "No — but plan for it. Sites and museums stay open, often on reduced hours, and the rhythm of the day shifts: quiet afternoons, then the whole country comes alive at sunset for iftar. Many travellers who happen to visit during Ramadan describe it as the most memorable part of the trip. Ramadan moves about eleven days earlier each year, so check the dates for yours." },
  { q: "Is Egypt busy at Christmas and New Year?", a: "It is the peak of the year. Weather is excellent, and prices for Nile boats and good hotel rooms can double over the New Year week — which is booked up to a year ahead. Coptic Christmas on 7 January extends the season a further fortnight." },
];

// The direct answer, written to survive being lifted out of the page: it
// restates its subject, answers in the first sentence, and carries its own
// figures. See components/aeo/AnswerBox for the rules.
const ANSWER_Q = "When is the best time to visit Egypt?";
const ANSWER_A =
  "October to April is the best time to visit Egypt. The second half of October is the month we recommend most for a first visit, and the first three weeks of March are the best value in the Egyptian year. From May to September, Upper Egypt is punishing at midday but the Red Sea is at its best.";
const answerLd = answerPageSchema({
  route: ROUTE,
  name: "When to visit Egypt, month by month",
  description: "Egypt month by month — temperatures, crowds, prices and festivals, with a verdict on each of the twelve.",
  question: ANSWER_Q,
  answer: ANSWER_A,
});

const jsonld: Record<string, unknown>[] = [
  answerLd,
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "When to Visit Egypt — Month by Month",
    description:
      "Egypt month by month: temperatures for Cairo, Luxor, Aswan and the Red Sea, crowd and price levels, festivals, and an honest verdict on each month.",
    url: canonical(ROUTE),
    inLanguage: "en",
    about: { "@type": "Country", name: "Egypt" },
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: months.length,
      itemListElement: months.map((m, i) => ({
        "@type": "ListItem", position: i + 1, name: `Egypt in ${m.name}`,
        url: canonical(`when-to-go/${m.slug}.html`),
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question", name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumb([["Home", "index.html"], ["When to go", ROUTE]]),
];
---
<Base
  title="When to Visit Egypt — Month by Month Guide | Kemet"
  description="Egypt month by month — temperatures for Cairo, Luxor, Aswan and the Red Sea, crowd and price levels, festivals and an honest verdict on each of the twelve."
  active={ROUTE}
  jsonld={jsonld}
  keywords="best time to visit egypt, egypt weather by month, when to go to egypt, egypt temperature january, egypt in summer, nile cruise best time, red sea diving season"
>
  <PageHero
    crumb="When to go"
    symbol="sun"
    title="When to visit Egypt"
    text="Timing changes an Egyptian journey more than any other single decision — what you pay, how crowded the Valley of the Kings is at nine, and whether noon in Aswan is pleasant or punishing."
  />

  <section style="padding-top:26px">
    <div class="wrap wg-wrap">

      <AnswerBox question={ANSWER_Q} answer={ANSWER_A} />
      <p class="wg-lede">
        The short answer is October to April. The useful answer is that Egypt has two climates running
        at once — the monuments inland and the reefs on the coast — and they peak at opposite ends of
        the year. October is the one month where both are close to their best, which is why we
        recommend it more than any other.
      </p>

      <div class="wg-grid">
        {months.map((m) => (
          <a class={`wg-card reveal wg-${m.crowds.toLowerCase()}`} href={`when-to-go/${m.slug}.html`}>
            <div class="wg-head">
              <h2>{m.name}</h2>
              <span class="wg-badge">{m.crowds}</span>
            </div>
            <div class="wg-temp">{m.temps.luxor} <em>Luxor</em></div>
            <p>{m.shortSummary}</p>
          </a>
        ))}
      </div>

      <Frieze />

      <Faq items={faqs} heading="Timing questions, answered" />
    </div>
  </section>

  <LeadCapture
    variant="planning"
    heading="Not sure which month?"
    subtext="Tell us what you want the trip to be — monuments, the reef, a cruise, or all three — and roughly when you can travel. We will tell you which month actually serves it."
    whatsappMessage="Hello Kemet — I'd like help choosing when to travel to Egypt."
    emailSubject="Enquiry — when to visit Egypt"
  />
</Base>

<style>
  .wg-wrap { max-width: 940px; }
  .wg-lede { font-family: var(--ff-display); font-weight: 300; font-size: 1.3rem;
    line-height: 1.7; color: var(--bone); max-width: 820px; margin: 0 0 40px; }

  .wg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .wg-card { display: block; border: 1px solid var(--line); border-radius: 2px;
    padding: 24px 22px; position: relative; overflow: hidden;
    background: linear-gradient(165deg, rgba(30,25,18,.9), rgba(14,17,21,.68));
    transition: transform .5s cubic-bezier(.22,.61,.36,1), border-color .5s; }
  .wg-card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: var(--wgc, var(--gold)); opacity: .55; transition: opacity .5s; }
  .wg-card:hover { transform: translateY(-5px); border-color: var(--gold); }
  .wg-card:hover::before { opacity: 1; }
  .wg-quiet { --wgc: #9CCBA2; }
  .wg-moderate { --wgc: #D9B45A; }
  .wg-busy { --wgc: #E8A33D; }
  .wg-peak { --wgc: #C06B3A; }

  .wg-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .wg-card h2 { font-size: 1.28rem; color: var(--bone); margin: 0; }
  .wg-badge { font-size: .58rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--wgc, var(--gold)); border: 1px solid currentColor; border-radius: 20px;
    padding: 4px 9px; white-space: nowrap; }
  .wg-temp { font-family: var(--ff-display); font-size: 1.24rem; color: var(--gold-bright);
    margin: 8px 0 10px; }
  .wg-temp em { font-style: normal; font-family: var(--ff-body); font-size: .64rem;
    letter-spacing: .22em; text-transform: uppercase; color: var(--muted-2); margin-left: 6px; }
  .wg-card p { color: var(--muted); font-size: .9rem; line-height: 1.7; margin: 0; }

  @media(max-width:900px){ .wg-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:680px){
    .wg-lede { font-size: 1.15rem; margin-bottom: 30px; }
    .wg-grid { grid-template-columns: 1fr; gap: 14px; }
    .wg-card { padding: 22px 20px; }
  }
</style>
