---
// Comparison pages (/compare/<slug>.html) — the decision a traveller is making
// at the moment they are about to commit. Data-only from data/comparisons.ts.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import TourCard from "@/components/TourCard.astro";
import LeadCapture from "@/components/conversion/LeadCapture.astro";
import { comparisons } from "@/data/comparisons";
import type { Comparison } from "@/data/comparisons";
import { tours } from "@/data/tours";
import { canonical } from "@/utils/links";
import { site, SITE_URL } from "@/config/site";
import { breadcrumb } from "@/schemas/jsonld";

export function getStaticPaths() {
  return comparisons.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

interface Props { c: Comparison }
const { c } = Astro.props;
const route = `compare/${c.slug}.html`;
const base = "../";

const picks = [...tours]
  .filter((t) => /day/i.test(t.durationLabel) && t.price >= 900)
  .sort((a, b) => b.price - a.price)
  .slice(0, 3);

const others = comparisons.filter((x) => x.slug !== c.slug);

const jsonld: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: c.title,
    description: c.metaDescription,
    url: canonical(route),
    inLanguage: "en",
    about: { "@type": "Country", name: "Egypt" },
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    publisher: { "@type": "TravelAgency", name: site.name, url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faqs.map((f) => ({
      "@type": "Question", name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumb([["Home", "index.html"], ["Compare", "compare.html"], [c.label, route]]),
];

const title = `${c.title} | Kemet`;
---
<Base
  title={title.length <= 65 ? title : `${c.label} — Egypt | Kemet`}
  description={c.metaDescription}
  active={route}
  jsonld={jsonld}
  keywords={c.keywords.join(", ")}
>
  <PageHero crumb={c.label} symbol={c.symbol} base={base} title={c.title} text={c.shortSummary} />

  <section style="padding-top:var(--s-4)">
    <div class="wrap cp-wrap">

      {/* The answer first. A comparison page that withholds its verdict is worse
          than no page at all. */}
      <div class="cp-verdict">
        <span class="cp-vlabel">The short answer</span>
        <p>{c.verdict}</p>
      </div>

      <p class="cp-lede">{c.lede}</p>

      <div class="cp-scroll">
        <table class="cp-table">
          <thead>
            <tr>
              <th scope="col"><span class="sr-head">{c.optionA} / {c.optionB}</span></th>
              <th scope="col">{c.optionA}</th>
              <th scope="col">{c.optionB}</th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map((r) => (
              <tr>
                <th scope="row">{r.aspect}</th>
                <td data-label={c.optionA}>{r.a}</td>
                <td data-label={c.optionB}>{r.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="cp-cols">
        <div class="cp-col">
          <h2>{c.chooseA.heading}</h2>
          <ul>{c.chooseA.points.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="cp-col cp-col--b">
          <h2>{c.chooseB.heading}</h2>
          <ul>{c.chooseB.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </div>

      <Frieze />

      <div class="cp-sections">
        {c.sections.map((s, i) => (
          <div class="cp-sec reveal">
            <span class="cp-n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </div>
          </div>
        ))}
      </div>

      <Frieze />

      <Faq items={c.faqs} heading={`${c.label} — questions`} />

      <div class="cp-others">
        <h2>Other decisions</h2>
        <div class="cp-others-grid">
          {others.map((x) => (
            <a href={`${x.slug}.html`} class="cp-other">
              <h3>{x.title}</h3>
              <p>{x.shortSummary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow">Journeys</div>
        <h2>Either way, privately</h2>
        <div class="rule"></div>
        <p>
          Led by a licensed Egyptologist, with no shared coaches and no fixed departures. Tell us
          which way you are leaning and we will build the itinerary around it.
        </p>
      </div>
      <div class="grid-3">{picks.map((t) => <TourCard tour={t} base={base} />)}</div>
    </div>
  </section>

  <LeadCapture
    variant="consultation"
    heading="Still deciding?"
    subtext="Tell us your dates, your party and what you want out of the trip. We will tell you which way we would go and why — including when the answer is the cheaper one."
    whatsappMessage={`Hello Kemet — I'd like advice on ${c.title.replace(/\?$/, "").toLowerCase()}.`}
    emailSubject={`Enquiry — ${c.label}`}
  />
</Base>

<style>
  .cp-wrap { max-width: 940px; }

  .cp-verdict { border: 1px solid var(--gold); border-radius: 2px; padding:var(--s-5) var(--s-5);
    background: rgba(217,180,90,.07); position: relative; overflow: hidden; }
  .cp-verdict::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .cp-vlabel { display: inline-block; font-size:var(--t-nano); letter-spacing: .3em;
    text-transform: uppercase; color: var(--ink); background: var(--gold);
    padding:var(--s-1) var(--s-2); border-radius: 2px; font-weight: 500; margin-bottom:var(--s-3); }
  .cp-verdict p { margin: 0; color: var(--bone); font-size:var(--t-base); line-height: 1.82; }

  .cp-lede { font-family: var(--ff-display); font-weight: 300; font-size:var(--t-md);
    line-height: 1.7; color: var(--muted); margin:var(--s-5) 0 var(--s-5); }

  /* Wide table scrolls inside its own box — the page never scrolls sideways. */
  .cp-scroll { overflow-x: auto; margin-bottom:var(--s-5); }
  .cp-table { width: 100%; border-collapse: collapse; min-width: 620px; }
  .cp-table th, .cp-table td { text-align: left; vertical-align: top;
    padding:var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--line); }
  .cp-table thead th { font-family: var(--ff-display); font-weight: 400; font-size:var(--t-base);
    color: var(--gold-bright); border-bottom-color: var(--line-2); padding-bottom:var(--s-2); }
  .cp-table tbody th { font-weight: 400; color: var(--muted-2); font-size:var(--t-tiny);
    letter-spacing: .1em; text-transform: uppercase; width: 26%; }
  .cp-table td { color: var(--muted); font-size:var(--t-sm); line-height: 1.7; }
  /* On a phone the table was 620px wide inside a 342px column: the second
     option sat off-screen with nothing to say it was there. Each row becomes
     a small card instead — the aspect on top, the two options side by side,
     each named. The header row stays for screen readers only. */
  @media (max-width: 680px) {
    .cp-table { min-width: 0; }
    .cp-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .cp-table tr { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-1) var(--s-3);
      padding: var(--s-3) 0; border-bottom: 1px solid var(--line); }
    .cp-table tbody th { grid-column: 1 / -1; width: auto; border: 0; padding: 0 0 var(--s-1); }
    .cp-table td { border: 0; padding: 0; }
    .cp-table td::before { content: attr(data-label); display: block; margin-bottom: 4px;
      font-size: var(--t-micro); letter-spacing: .14em; text-transform: uppercase; color: var(--gold); }
  }

  .cp-cols { display: grid; grid-template-columns: 1fr 1fr; gap:var(--s-4); }
  .cp-col { border: 1px solid var(--line); border-radius: 2px; padding:var(--s-4) var(--s-4);
    background: rgba(217,180,90,.05); }
  .cp-col--b { background: rgba(255,255,255,.015); }
  .cp-col h2 { font-size:var(--t-micro); letter-spacing: .28em; text-transform: uppercase;
    font-family: var(--ff-body); font-weight: 400; color: var(--gold); margin:0 0 var(--s-3); }
  .cp-col--b h2 { color: var(--muted-2); }
  .cp-col ul { list-style: none; margin: 0; padding: 0; }
  .cp-col li { position: relative; padding-left:var(--s-3); color: var(--muted);
    font-size:var(--t-sm); line-height: 1.75; margin-bottom:var(--s-2); }
  .cp-col li:last-child { margin-bottom: 0; }
  .cp-col li::before { content: ""; position: absolute; left: 0; top: .68em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--gold); opacity: .8; }
  .cp-col--b li::before { background: var(--muted-2); opacity: .55; }

  .cp-sec { display: grid; grid-template-columns: 58px 1fr; gap:var(--s-4);
    padding:var(--s-4) 0; border-bottom: 1px solid var(--line); }
  .cp-sec:last-child { border-bottom: 0; }
  .cp-n { font-family: var(--ff-display); font-size: 1.7rem; color: var(--gold);
    line-height: 1.2; width: 58px; }
  .cp-sec h2 { font-size:var(--t-md); color: var(--bone); margin:0 0 var(--s-2); }
  .cp-sec p { color: var(--muted); font-size:var(--t-base); line-height: 1.88; margin: 0; }

  .cp-others { margin-top:var(--s-6); }
  .cp-others h2 { font-size:var(--t-lg); color: var(--bone); margin-bottom:var(--s-3); }
  .cp-others-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap:var(--s-3); }
  @media (min-width: 681px) {
    /* Five decisions in two columns: the fifth sits centred under the others. */
    .cp-others-grid > :last-child:nth-child(odd) { grid-column: 1 / -1; justify-self: center; width: calc(50% - var(--s-3) / 2); }
  }
  .cp-other { display: block; border: 1px solid var(--line); border-radius: 2px;
    padding:var(--s-4) var(--s-3); transition: border-color .4s, transform .4s cubic-bezier(.22,.61,.36,1); }
  .cp-other:hover { border-color: var(--gold); transform: translateY(-4px); }
  .cp-other h3 { font-size:var(--t-base); color: var(--bone); margin:0 0 var(--s-1); font-weight: 500; }
  .cp-other:hover h3 { color: var(--gold-bright); }
  .cp-other p { color: var(--muted-2); font-size:var(--t-sm); line-height: 1.65; margin: 0; }

  @media(max-width:680px){
    .cp-verdict { padding:var(--s-4) var(--s-3); }
    .cp-verdict p { font-size:var(--t-base); }
    .cp-lede { font-size: 1.1rem; }
    .cp-cols { grid-template-columns: 1fr; gap:var(--s-3); }
    .cp-col { padding:var(--s-4) var(--s-3); }
    .cp-others-grid { grid-template-columns: 1fr; }
    /* Site-wide phone rule: the numeral goes above its heading. */
    .cp-sec { display: block; padding:var(--s-4) 0; }
    .cp-n { display: block; width: auto; font-size:var(--t-md); margin-bottom:var(--s-1); }
  }
</style>
