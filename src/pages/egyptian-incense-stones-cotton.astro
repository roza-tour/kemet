---
// The Sacred Senses of Egypt — incense, stones, cotton and linen. Added
// October 2026, in English first; the words live in data/sacred.ts so the
// other languages can follow set by set.
//
// For readers who come to Egypt for its spirit as much as its monuments:
// people looking for real incense, for the stones the pharaohs held sacred,
// and for clothes of pure Egyptian cotton and linen. Both ways to have them
// are offered — on a journey, with a guide or shopping companion, or ordered
// on WhatsApp and shipped home.
//
// THE DESIGN — the owner's brief: calm, spiritual, and real.
//   · It opens at night in the temple: smoke, candlelight, and the circle of
//     the Dendera zodiac turning slowly in fine gold — the heavens the
//     priests timed their incense by.
//   · Then it lightens into soft auras — lavender, peach, sage — the colours
//     of calm, with the grain of paper over them.
//   · Every picture is a PHOTOGRAPH: resin, smoke, the stones and the cloth
//     themselves, and the jewellery of Middle Kingdom princesses (the
//     Metropolitan Museum's open-access photographs). Nothing is drawn to
//     stand in for a thing: where a photograph is still missing, the thing's
//     own name is set in Arabic calligraphy instead.
// Animation is slow and stops under prefers-reduced-motion.
import Base from "@/layouts/Base.astro";
import Faq from "@/components/Faq.astro";
import Placeholder from "@/components/Placeholder.astro";
import { breadcrumb } from "@/schemas/jsonld";
import { canonical, whatsappLink, mailtoLink } from "@/utils/links";
import { incenses, templeDay, stones, oils, sacredFaqs, sacredPhotos as PH } from "@/data/sacred";
import { creditFor, type PhotoCredit } from "@/data/photoCredits";

const route = "egyptian-incense-stones-cotton.html";
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  url: canonical(route),
  inLanguage: "en",
  mainEntity: sacredFaqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const jsonld = [
  breadcrumb([["Home", "index.html"], ["Incense, stones & cotton", route]]),
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "The Sacred Senses of Egypt — incense, stones, cotton and linen",
    url: canonical(route),
    inLanguage: "en",
    about: [
      { "@type": "Thing", name: "Egyptian incense" },
      { "@type": "Thing", name: "Gemstones of ancient Egypt" },
      { "@type": "Thing", name: "Egyptian cotton" },
      { "@type": "Thing", name: "Egyptian linen" },
    ],
  },
  faqLd,
];

const order = whatsappLink("Hello Kemet — I'd like to order from the Sacred Senses page: ");
const orderIncense = whatsappLink("Hello Kemet — I'd like to order incense: ");
const orderStones = whatsappLink("Hello Kemet — I'm looking for a stone: ");
const orderCloth = whatsappLink("Hello Kemet — I'd like Egyptian cotton / linen: ");
const orderOils = whatsappLink("Hello Kemet — I'm looking for a natural oil: ");
const journey = mailtoLink("Incense, stones & cotton on my journey", "Hello Kemet,\n\nI'd like to add incense, stones or cotton and linen to my journey in Egypt.\n\nDates:\nTravellers:\n\nThank you.");

// The ring of the Dendera zodiac, in fine gold line: 36 decans, 12 signs.
const SIGNS = ["♈", "♉", "♊", "♋", "♌", "♍", "♎", "♏", "♐", "♑", "♒", "♓"];
const ring = (n: number, r1: number, r2: number, off = 0) =>
  [...Array(n)].map((_, i) => {
    const a = (i / n) * Math.PI * 2 + off;
    return `M${(Math.cos(a) * r1).toFixed(1)} ${(Math.sin(a) * r1).toFixed(1)} L${(Math.cos(a) * r2).toFixed(1)} ${(Math.sin(a) * r2).toFixed(1)}`;
  }).join(" ");
const DECANS = ring(36, 262, 276);
const SPOKES = ring(12, 120, 205, Math.PI / 12);
const signAt = (i: number) => {
  const a = (i / 12) * Math.PI * 2 - Math.PI / 2;
  return { x: (Math.cos(a) * 240).toFixed(1), y: (Math.sin(a) * 240 + 7).toFixed(1) };
};

// Credits. The small round photographs have no room for a credit on the
// image, so every borrowed photograph on the page is credited here, at the
// foot, linked to its source — the condition of its licence.
const usedSrcs = [PH.hero, PH.resin, PH.jewel, PH.tray, PH.linen, PH.cotton, PH.flax, PH.souk, PH.parcel,
  PH.oilsArch, PH.oilsSlab, PH.massage, PH.ownOils,
  ...Object.values(PH.incense ?? {}), ...Object.values(PH.stone ?? {}), ...Object.values(PH.oil ?? {}), ...(PH.ownStones ?? [])]
  .map((p) => p?.src).filter((x): x is string => !!x);
const creditList: PhotoCredit[] = [...new Set(usedSrcs)]
  .map((src) => creditFor(src))
  .filter((c): c is PhotoCredit => !!c && !/^(CC0|Public)/i.test(c.license));
// One entry per photographer and licence, each photograph still linked.
const credits = [...creditList.reduce((m, c) => {
  const k = `${c.creator}|${c.license}`;
  m.set(k, { creator: c.creator, license: c.license, sources: [...(m.get(k)?.sources ?? []), c.source] });
  return m;
}, new Map<string, { creator: string; license: string; sources: string[] }>()).values()];
const usesMet = [PH.jewel, PH.tray, PH.linen, PH.oilsArch, PH.oilsSlab].some((p) => p?.src);

/** Long Arabic names are set smaller so they stay on one line in their circle. */
const calliSize = (ar: string) => (ar.length > 8 ? "font-size:1.45em" : ar.length > 5 ? "font-size:1.8em" : undefined);

/** The aura colour behind each stone. */
const STONE_GLOW: Record<string, string> = {
  Turquoise: "#3FD0C0", "Lapis lazuli": "#4C6FE0", Carnelian: "#E8673F", Peridot: "#A9CF45", Amethyst: "#A57AD8", Garnet: "#C8304A",
};
---
<Base
  title="Egyptian Incense, Oils, Sacred Stones & Cotton | Kemet"
  description="Myrrh, luban dakar and oud; Egyptian jasmine and sacred oils; the stones the pharaohs held sacred; cotton and linen — on your journey or sent home."
  active={route}
  jsonld={jsonld}
  keywords="egyptian incense, luban dakar, egyptian frankincense, myrrh incense egypt, oud bakhoor egypt, ancient egyptian gemstones, sinai turquoise, egyptian cotton clothing, egyptian linen, khan el khalili incense, egyptian essential oils, egyptian jasmine oil, black seed oil, natural massage oil"
>
<div class="ss">

  <!-- ================= Night in the temple ================= -->
  <header class:list={["ss-hero", PH.hero && "ss-hero--photo"]}>
    {PH.hero && (
      <div class="ss-hero-photo">
        <Placeholder src={PH.hero.src} alt={PH.hero.alt} width={PH.hero.width} height={PH.hero.height} loading="eager" label="Incense" />
      </div>
    )}
    <div class="ss-hero-veil" aria-hidden="true"></div>
    <svg class="ss-zodiac" viewBox="-320 -320 640 640" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <circle r="300" /><circle r="282" /><circle r="262" /><circle r="212" stroke-dasharray="2 6" /><circle r="120" />
        <path d={DECANS} /><path d={SPOKES} />
      </g>
      {SIGNS.map((g, i) => <text x={signAt(i).x} y={signAt(i).y} text-anchor="middle">{g}&#xFE0E;</text>)}
    </svg>
    <div class="wrap ss-hero-in">
      <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> · <span>Incense, stones &amp; cotton</span></nav>
      <div class="ss-over">Incense <span>·</span> Oils <span>·</span> Stones <span>·</span> Cotton &amp; linen</div>
      <h1>The Sacred <em>Senses</em><br /> of Egypt</h1>
      <p class="ss-lede">Incense burned since the pharaohs, the oils of the temples and the Delta, the stones they held sacred, and the cotton and linen Egypt still grows — for a home that feels lighter, and a calmer you.</p>
      <div class="ss-actions">
        <a class="btn btn-solid" href={order} target="_blank" rel="noopener">Order on WhatsApp</a>
        <a class="btn btn-ghost" href="#incense">Begin with the incense</a>
      </div>
    </div>
  </header>

  <!-- ================= The word ================= -->
  <section class="ss-aura ss-word">
    <i class="ss-blob b1"></i><i class="ss-blob b2"></i><i class="ss-blob b3"></i>
    <div class="wrap">
      <p class="ss-word-q reveal"><em>senetjer</em></p>
      <p class="ss-word-t reveal">The ancient Egyptian word for incense is usually translated <b>“that which makes divine.”</b> Scent, stone and cloth were never only things here: they were how a person, a home and a temple were made ready.</p>
    </div>
  </section>

  <!-- ================= I. Incense ================= -->
  <section class="ss-aura ss-ch" id="incense">
    <i class="ss-blob b2"></i><i class="ss-blob b4"></i>
    <div class="wrap ss-open">
      <figure class="ss-arch reveal">
        {PH.resin ? (
          <Placeholder src={PH.resin.src} alt={PH.resin.alt} width={PH.resin.width} height={PH.resin.height} sizes="half" label="Frankincense and myrrh" />
        ) : <div class="ss-calli"><span lang="ar" dir="rtl">بخور</span></div>}
      </figure>
      <div class="ss-open-t reveal">
        <div class="ss-num">I</div>
        <div class="eyebrow">Incense</div>
        <h2>The incense of the temples</h2>
        <p>Every morning the temples of Egypt woke to smoke. The priests burned incense as the sun crossed the sky — a ritual timed by the heavens, and one that never quite left Egyptian homes.</p>
        <ol class="ss-sun">
          {templeDay.map((d) => (
            <li><small>{d.when}</small><b>{d.what}</b><span>{d.note}</span></li>
          ))}
        </ol>
        <p class="ss-src">The priests' day, as Plutarch records it in <i>On Isis and Osiris</i>. The recipe for kyphi is still carved on the walls of the laboratory at Edfu temple.</p>
      </div>
    </div>

    <div class="wrap">
      <div class="ss-shelf-head reveal">
        <h3>Six scents of an Egyptian home</h3>
        <p>Each as Cairo's incense sellers know it — where it comes from, and how it is used at home.</p>
      </div>
      <ul class="ss-apoth">
        {incenses.map((x) => {
          const ph = PH.incense?.[x.name];
          return (
            <li class="reveal">
              <div class="ss-dish">
                {ph ? <Placeholder src={ph.src} alt={ph.alt} width={ph.width} height={ph.height} sizes="card" label={x.name} /> : <span lang="ar" dir="rtl" style={calliSize(x.ar)}>{x.ar}</span>}
              </div>
              <div>
                <h4>{x.name}<span lang="ar" dir="rtl">{x.ar}</span></h4>
                <p>{x.story}</p>
                <p class="ss-home"><b>At home</b>{x.home}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="ss-aura ss-belief">
    <i class="ss-blob b1"></i><i class="ss-blob b3"></i>
    <div class="wrap reveal">
      <blockquote>In Egyptian homes to this day, incense is burned after a guest has gone, before a new beginning, and against <i>hasad</i> — the evil eye.</blockquote>
      <p>These beliefs are older than any of us, and we share them as Egyptians live them. Whatever you believe, the ritual does what rituals do: it slows the hour down, and leaves a room feeling cared for.</p>
      <div class="ss-ritual">
        <h3>How to burn it</h3>
        <ol>
          <li><span>1</span>Light a charcoal disc in a heatproof dish, and wait until it turns grey.</li>
          <li><span>2</span>Lay a pea-sized piece of resin, wood or blend on top.</li>
          <li><span>3</span>Open a window. A little smoke goes a long way — incense should scent a room, not fill it.</li>
        </ol>
        <a class="btn btn-solid" href={orderIncense} target="_blank" rel="noopener">Order incense on WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- ================= II. Oils ================= -->
  <section class="ss-aura ss-aura--honey ss-ch" id="oils">
    <i class="ss-blob b4"></i><i class="ss-blob b2"></i>
    <div class="wrap ss-open">
      <figure class="ss-arch reveal">
        {PH.oilsArch ? (
          <Placeholder src={PH.oilsArch.src} alt={PH.oilsArch.alt} width={PH.oilsArch.width} height={PH.oilsArch.height} sizes="half" label="An ancient perfume bottle" />
        ) : <div class="ss-calli"><span lang="ar" dir="rtl">زيوت</span></div>}
      </figure>
      <div class="ss-open-t reveal">
        <div class="ss-num">II</div>
        <div class="eyebrow">Oils</div>
        <h2>Oils of the temples and the Delta</h2>
        <p>Egypt's perfumers were famous across the ancient world. They steeped flowers, resins and spices in oil to make perfumes and ointments, and the temples kept seven sacred oils for their rituals — at Edfu, the recipes for ointments are carved beside those for incense.</p>
        <p>The craft never left. The Nile Delta still grows jasmine picked by hand before dawn, and small presses still press sesame and black seed cold, the way they always have.</p>
        {PH.oilsArch && <p class="ss-cap">Left: a perfume bottle of blue glass, made in Egypt about 3,300 years ago. The Metropolitan Museum of Art.</p>}
      </div>
    </div>

    <div class="wrap">
      {PH.oilsSlab && (
        <figure class="ss-slab reveal">
          <Placeholder src={PH.oilsSlab.src} alt={PH.oilsSlab.alt} width={PH.oilsSlab.width} height={PH.oilsSlab.height} sizes="half" label="The seven sacred oils" />
          <figcaption><b>The seven sacred oils.</b> An offering slab carved for Ankhwadjes in the Old Kingdom: each hollow held one of the oils named above it. The Metropolitan Museum of Art.</figcaption>
        </figure>
      )}

      <div class="ss-shelf-head reveal">
        <h3>Seven oils of Egypt</h3>
        <p>For scent, for the skin and for massage — each pressed or distilled the way Egypt has always done it.</p>
      </div>
      <ul class="ss-apoth">
        {oils.map((x) => {
          const ph = PH.oil?.[x.name];
          return (
            <li class="reveal">
              <div class="ss-dish ss-dish--oil">
                {ph ? <Placeholder src={ph.src} alt={ph.alt} width={ph.width} height={ph.height} sizes="card" label={x.name} /> : <span lang="ar" dir="rtl" style={calliSize(x.ar)}>{x.ar}</span>}
              </div>
              <div>
                <h4>{x.name}<span lang="ar" dir="rtl">{x.ar}</span></h4>
                <p>{x.story}</p>
                <p class="ss-home"><b>Use</b>{x.home}</p>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="ss-massage reveal">
        {PH.massage && (
          <div class="ss-massage-img">
            <Placeholder src={PH.massage.src} alt={PH.massage.alt} width={PH.massage.width} height={PH.massage.height} sizes="half" label="Massage oils" />
          </div>
        )}
        <div class="ss-massage-t">
          <h3>A massage, the Egyptian way</h3>
          <p>A massage oil is simple: a carrier — sesame, sweet almond or moringa — and a few drops of an essential oil such as jasmine, geranium or chamomile. Warm it between your palms, breathe it in, and work slowly.</p>
          <p class="ss-safe">Essential oils are strong. Always dilute them in a carrier oil, test on a small patch of skin first, keep them away from the eyes, and ask your doctor before using them if you are pregnant.</p>
        </div>
      </div>

      <div class="ss-ours reveal">
        {PH.ownOils && (
          <div class="ss-ours-img">
            <Placeholder src={PH.ownOils.src} alt={PH.ownOils.alt} width={PH.ownOils.width} height={PH.ownOils.height} sizes="card" label="Natural oils" />
          </div>
        )}
        <div>
          <h3>Our oils</h3>
          <p>Natural oils, pressed and distilled the Egyptian way. Tell us what you are looking for — an oil for the skin, for massage or for scent — and we send photographs and a price.</p>
          <a class="btn btn-solid" href={orderOils} target="_blank" rel="noopener">Ask about oils</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= III. Stones, at night ================= -->
  <section class="ss-ch ss-velvet" id="stones">
    <div class="wrap ss-open ss-open--rev">
      <div class="ss-open-t reveal">
        <div class="ss-num">III</div>
        <div class="eyebrow">Stones</div>
        <h2>Stones the pharaohs held sacred</h2>
        <p>To the ancient Egyptians a stone's colour was its power. Green and turquoise were new life, red was blood and vitality, deep blue was the night sky. They set them into amulets and collars, buried them with their kings — and Egyptians still wear them for the same reasons.</p>
        {PH.jewel && <p class="ss-cap">Right: the pectoral of Princess Sithathoryunet — gold, turquoise, lapis lazuli and carnelian, made about 3,900 years ago. The Metropolitan Museum of Art.</p>}
      </div>
      <figure class="ss-arch ss-arch--gold reveal">
        {PH.jewel ? (
          <Placeholder src={PH.jewel.src} alt={PH.jewel.alt} width={PH.jewel.width} height={PH.jewel.height} sizes="half" label="Ancient Egyptian jewellery" />
        ) : <div class="ss-calli ss-calli--night"><span lang="ar" dir="rtl">أحجار</span></div>}
      </figure>
    </div>

    <div class="wrap">
      <ul class="ss-stones">
        {stones.map((s) => {
          const ph = PH.stone?.[s.name];
          return (
            <li class="reveal" style={`--glow:${STONE_GLOW[s.name]}`}>
              <div class="ss-stone-img">
                {ph ? <Placeholder src={ph.src} alt={ph.alt} width={ph.width} height={ph.height} sizes="card" label={s.name} /> : <em>{s.called}</em>}
              </div>
              <h3>{s.name}</h3>
              <div class="ss-called"><i>{s.called}</i> · {s.calledIn}</div>
              <p>{s.origin}</p>
              <p class="ss-meaning">{s.meaning}</p>
            </li>
          );
        })}
      </ul>

      {PH.tray && (
        <figure class="ss-tray reveal">
          <Placeholder src={PH.tray.src} alt={PH.tray.alt} width={PH.tray.width} height={PH.tray.height} sizes="full" label="Middle Kingdom jewellery" />
          <figcaption>A princess's girdle and bracelets — gold, carnelian, turquoise and lapis lazuli — from the reign of Amenemhat III. The Metropolitan Museum of Art.</figcaption>
        </figure>
      )}

      <p class="ss-today reveal">The blue bead against the evil eye, the carnelian ring, the scarab worn for luck — Egypt never stopped.</p>
      {PH.ownStones && PH.ownStones.length > 0 && (
        <ul class="ss-gallery reveal" aria-label="Our stones">
          {PH.ownStones.map((g) => (
            <li>
              <Placeholder src={g.src} alt={g.alt} width={g.width} height={g.height} sizes="card" label={g.name} />
              <span>{g.name}</span>
            </li>
          ))}
        </ul>
      )}
      <div class="ss-pieces reveal">
        <p><b>Our stones.</b> Natural stones, chosen one by one. Tell us which stone you are looking for and how you will wear it, and we send photographs of the actual pieces, with a price.</p>
        <a class="btn btn-ghost" href={orderStones} target="_blank" rel="noopener">Ask about a stone</a>
      </div>
    </div>
  </section>

  <!-- ================= IV. Cotton & linen ================= -->
  <section class="ss-aura ss-aura--sage ss-ch" id="cloth">
    <i class="ss-blob b3"></i><i class="ss-blob b4"></i>
    <div class="wrap ss-open">
      <figure class="ss-arch reveal">
        {PH.linen ? (
          <Placeholder src={PH.linen.src} alt={PH.linen.alt} width={PH.linen.width} height={PH.linen.height} sizes="half" label="Linen" />
        ) : <div class="ss-calli"><span lang="ar" dir="rtl">كتان</span></div>}
      </figure>
      <div class="ss-open-t reveal">
        <div class="ss-num">IV</div>
        <div class="eyebrow">Cotton &amp; linen</div>
        <h2>Cloth grown by the Nile</h2>
        <p>Egypt has dressed in linen for five thousand years. Its priests, Herodotus noticed, wore nothing else, and Tutankhamun was buried with chests of linen shirts and tunics. Today the same river grows some of the finest cotton in the world.</p>
        {PH.linen && <p class="ss-cap">Left: an Egyptian linen sheet woven about 3,500 years ago, its fringe still soft. The Metropolitan Museum of Art.</p>}
      </div>
    </div>

    <div class="wrap">
      <div class="ss-fibres">
        <article class="ss-fibre reveal">
          {PH.cotton && <div class="ss-fibre-img"><Placeholder src={PH.cotton.src} alt={PH.cotton.alt} width={PH.cotton.width} height={PH.cotton.height} sizes="card" label="Cotton" /></div>}
          <h3>Egyptian cotton <span lang="ar" dir="rtl">قطن</span></h3>
          <p>Egyptian cotton is <b>extra-long staple</b>: each fibre is longer than ordinary cotton's, so it spins into a finer, stronger, softer yarn — one that grows softer with every wash. It has been grown in the Nile Delta since the 1820s, when Muhammad Ali planted it for the world.</p>
        </article>
        <article class="ss-fibre reveal">
          {PH.flax && <div class="ss-fibre-img"><Placeholder src={PH.flax.src} alt={PH.flax.alt} width={PH.flax.width} height={PH.flax.height} sizes="card" label="Linen" /></div>}
          <h3>Egyptian linen <span lang="ar" dir="rtl">كتان</span></h3>
          <p>Spun from flax grown by the Nile, linen is cool, strong and better with age. It breathes in the heat, softens as it is worn, and lasts for years — the cloth Egypt chose for its priests and its kings.</p>
        </article>
      </div>

      <div class="ss-natural reveal">
        <h3>Natural — and still elegant</h3>
        <p>Pure cotton and linen against the skin, with nothing synthetic in between: the closest a garment gets to nature. Cut in modern, comfortable lines, so you never trade elegance for comfort.</p>
        <a class="btn btn-solid" href={orderCloth} target="_blank" rel="noopener">Ask about cotton &amp; linen</a>
      </div>
    </div>
  </section>

  <!-- ================= Two ways, and questions ================= -->
  <section class="ss-aura ss-ways">
    <i class="ss-blob b1"></i><i class="ss-blob b2"></i>
    <div class="wrap">
      <div class="ss-center reveal">
        <div class="eyebrow">Two ways to have them</div>
        <h2>In Egypt, or wherever you are</h2>
      </div>
      <div class="ss-way-grid">
        <article class="ss-way reveal">
          {PH.souk && <div class="ss-way-img"><Placeholder src={PH.souk.src} alt={PH.souk.alt} width={PH.souk.width} height={PH.souk.height} sizes="half" label="Khan el-Khalili" /></div>}
          <h3>On your journey</h3>
          <p>Add an afternoon to your journey: Cairo's incense, perfume and oil sellers in Khan el-Khalili with your guide, and a shopping companion for stones, cotton and linen. On a Nile journey, stand in the laboratory at Edfu temple, where the recipes for incense are carved into the walls.</p>
          <a class="btn btn-ghost" href={journey}>Add it to my journey</a>
        </article>
        <article class="ss-way reveal">
          {PH.parcel && <div class="ss-way-img"><Placeholder src={PH.parcel.src} alt={PH.parcel.alt} width={PH.parcel.width} height={PH.parcel.height} sizes="half" label="Sent home" /></div>}
          <h3>Sent to your home</h3>
          <p>Write to us on WhatsApp with what you are looking for — an incense, an oil, a stone, a size or a colour. We send photographs of the actual pieces and a price with shipping to your country. Pay by bank transfer, card or PayPal.</p>
          <a class="btn btn-solid" href={order} target="_blank" rel="noopener">Order on WhatsApp</a>
        </article>
      </div>

      <div class="ss-faq">
        <Faq items={sacredFaqs} heading="Asked about incense, oils, stones and cotton" />
      </div>
    </div>
  </section>

  <!-- ================= Evening ================= -->
  <section class="ss-evening">
    <div class="wrap ss-center reveal">
      <p class="ss-close">Light it slowly.</p>
      <a class="btn btn-solid" href={order} target="_blank" rel="noopener">Order on WhatsApp</a>
      {(credits.length > 0 || usesMet) && (
        <p class="ss-credits">Photographs:
          {usesMet && <> ancient jewellery and linen, <a href="https://www.metmuseum.org/about-the-met/policies-and-documents/open-access" target="_blank" rel="noopener nofollow">The Metropolitan Museum of Art</a> (public domain){credits.length ? " ·" : ""}</>}
          {credits.map((c, i) => (
            <> <a href={c.sources[0]} target="_blank" rel="noopener nofollow">{c.creator}</a>{c.sources.slice(1).map((src, k) => <>, <a href={src} target="_blank" rel="noopener nofollow">{k + 2}</a></>)} ({c.license}){i < credits.length - 1 ? " ·" : ""}</>
          ))}
        </p>
      )}
    </div>
  </section>
</div>
</Base>

<style>
