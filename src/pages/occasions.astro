---
// /occasions.html — the hub for journeys defined by the reason for travelling.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import StandardOfTravel from "@/components/trust/StandardOfTravel.astro";
import LeadCapture from "@/components/conversion/LeadCapture.astro";
import SymbolIcon from "@/components/SymbolIcon.astro";
import { occasions } from "@/data/occasions";
import { canonical } from "@/utils/links";
import { site, SITE_URL } from "@/config/site";
import { breadcrumb } from "@/schemas/jsonld";

const ROUTE = "occasions.html";

const jsonld: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Egypt Journeys by Occasion",
    description:
      "Private Egypt journeys planned around the reason for travelling — a proposal, a milestone, a private group, a second visit, three generations.",
    url: canonical(ROUTE),
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: occasions.length,
      itemListElement: occasions.map((o, i) => ({
        "@type": "ListItem", position: i + 1, name: o.title,
        url: canonical(`occasions/${o.slug}.html`),
      })),
    },
  },
  breadcrumb([["Home", "index.html"], ["Occasions", ROUTE]]),
];
---
<Base
  title="Egypt Journeys by Occasion | Kemet"
  description="Private Egypt journeys planned around the reason for travelling — a proposal, a milestone birthday, a private group, a second visit, three generations."
  active={ROUTE}
  jsonld={jsonld}
  keywords="egypt special occasion travel, proposal in egypt, milestone birthday egypt, private group egypt, second trip to egypt, multigenerational egypt"
>
  <PageHero
    crumb="Occasions"
    symbol="ankh"
    title="When the trip is the occasion"
    text="Some journeys are a holiday. Others are marking something — and that changes what the itinerary should be, not just where it goes."
  />

  <section style="padding-top:26px">
    <div class="wrap">
      <p class="oh-lede">
        A proposal is planned backwards from a quarter of an hour. A sixtieth birthday wants fewer
        sites and better ones. Three generations need days that can fork. A second visit is about
        the country nobody queues for. These are the occasions we are asked for most, and each one
        changes the plan in a specific way.
      </p>

      <div class="oh-grid">
        {occasions.map((o) => (
          <a class="oh-card reveal" href={`occasions/${o.slug}.html`}>
            <div class="oh-sym" aria-hidden="true"><SymbolIcon name={o.symbol} /></div>
            <h2>{o.title}</h2>
            <p>{o.shortSummary}</p>
            <span class="oh-more">Explore <i aria-hidden="true"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <StandardOfTravel
        eyebrow="The standard"
        heading="What every journey here is"
      />
    </div>
  </section>

  <LeadCapture
    variant="consultation"
    heading="Tell us what is being marked"
    subtext="One sentence about the occasion changes the itinerary more than any list of sites. Send it with your dates and who is travelling."
    whatsappMessage="Hello Kemet — I'm planning a journey in Egypt to mark a special occasion."
    emailSubject="Enquiry — a special occasion in Egypt"
  />
</Base>

<style>
  .oh-lede { font-family: var(--ff-display); font-weight: 300; font-size: 1.3rem;
    line-height: 1.7; color: var(--bone); max-width: 820px; margin: 0 0 44px; }

  .oh-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .oh-card {
    display: block; padding: 34px 30px 30px; border: 1px solid var(--line);
    border-radius: 2px; position: relative; overflow: hidden;
    background: linear-gradient(165deg, rgba(30,25,18,.92), rgba(14,17,21,.72));
    transition: transform .5s cubic-bezier(.22,.61,.36,1), border-color .5s, box-shadow .5s;
  }
  .oh-card::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: .5; transition: opacity .5s;
  }
  .oh-card:hover { transform: translateY(-6px); border-color: var(--gold);
    box-shadow: 0 24px 60px rgba(0,0,0,.5); }
  .oh-card:hover::before { opacity: 1; }
  .oh-sym { width: 50px; height: 58px; margin-bottom: 18px;
    filter: drop-shadow(0 6px 16px rgba(217,180,90,.24)); }
  .oh-sym :global(svg) { width: 100%; height: 100%; }
  .oh-card h2 { font-size: 1.28rem; color: var(--bone); margin: 0 0 9px; }
  .oh-card p { color: var(--muted); font-size: .93rem; line-height: 1.72; margin: 0; }
  .oh-more { display: inline-flex; align-items: center; gap: 12px; margin-top: 20px;
    font-size: .64rem; letter-spacing: .3em; text-transform: uppercase; color: var(--gold); }
  .oh-more i { width: 30px; height: 1px; background: currentColor;
    transition: width .5s cubic-bezier(.22,.61,.36,1); }
  .oh-card:hover .oh-more i { width: 52px; }

  @media(max-width:1000px){ .oh-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:640px){ .oh-grid { grid-template-columns: 1fr; } }
  @media(max-width:680px){
    .oh-lede { font-size: 1.15rem; margin-bottom: 32px; }
    .oh-card { padding: 26px 20px 24px; }
  }
</style>
