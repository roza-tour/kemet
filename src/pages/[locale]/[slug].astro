---
// Localised pages — /de/…, /it/…, /es/…, /fr/…, /ru/…, /id/…, /ms/…
//
// One template for every language. Every page is generated from a data
// record whose route comes from the translation registry, so the URL, the
// canonical, the hreflang set and the sitemap entry are all derived from the
// same object and cannot disagree with each other.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import LangSwitch from "@/components/LangSwitch.astro";
import { de } from "@/data/i18n/de";
import { it } from "@/data/i18n/it";
import { es } from "@/data/i18n/es";
import { fr } from "@/data/i18n/fr";
import { ru } from "@/data/i18n/ru";
import { id } from "@/data/i18n/id";
import { ms } from "@/data/i18n/ms";
import type { LocalizedPage } from "@/data/i18n/types";
import {
  TRANSLATION_GROUPS, TRANSLATED_LOCALES, LOCALE_META,
} from "@/config/i18n";
import type { TranslatedLocale } from "@/config/i18n";
import { canonical, publicPath, whatsappLink, mailtoLink } from "@/utils/links";
import { personRef } from "@/schemas/jsonld";
import { site, SITE_URL } from "@/config/site";

export function getStaticPaths() {
  const sets: Record<TranslatedLocale, LocalizedPage[]> = { de, it, es, fr, ru, id, ms };
  const paths: Array<{ params: { locale: string; slug: string }; props: Record<string, unknown> }> = [];
  for (const locale of TRANSLATED_LOCALES) {
    for (const page of sets[locale]) {
      const group = TRANSLATION_GROUPS.find((g) => g.key === page.groupId);
      if (!group) continue;
      // "de/aegypten-visum.html" → slug "aegypten-visum"
      const slug = group[locale].split("/")[1].replace(/\.html$/, "");
      paths.push({ params: { locale, slug }, props: { page, locale } });
    }
  }
  return paths;
}

interface Props { page: LocalizedPage; locale: TranslatedLocale }
const { page, locale } = Astro.props;

const group = TRANSLATION_GROUPS.find((g) => g.key === page.groupId)!;
const route = group[locale];
const base = "../";
const lang = LOCALE_META[locale].tag;

const wa = whatsappLink(page.cta.whatsapp);
const mail = mailtoLink(page.cta.emailSubject, `${page.cta.whatsapp}\n\n`);

const jsonld: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: page.h1,
    description: page.description,
    url: canonical(route),
    inLanguage: lang,
    about: { "@type": "Country", name: "Egypt" },
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    publisher: { "@type": "TravelAgency", name: site.name, url: SITE_URL },
    reviewedBy: personRef(),
  },
  // Breadcrumbs in the page's own language. These pages render a visible
  // crumb trail but had no BreadcrumbList behind it, so the trail was invisible
  // to a crawler — 21 of the 24 pages missing breadcrumb markup were localised.
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: LOCALE_META[locale].home, item: canonical(`${locale}/index.html`) },
      { "@type": "ListItem", position: 2, name: page.crumb, item: canonical(route) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: page.faqs.map((f) => ({
      "@type": "Question", name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<Base
  title={page.title}
  description={page.description}
  active={route}
  jsonld={jsonld}
  keywords={page.keywords}
>
  <PageHero
    rootLabel={LOCALE_META[locale].home}
    rootHref={`/${locale}/`}
    crumb={page.crumb}
    symbol={page.symbol}
    base={base}
    title={page.h1}
    text={page.standfirst}
  />

  <section style="padding-top:22px">
    <div class="wrap lz-wrap">
      <LangSwitch route={route} />

      {page.facts && (
        <div class="lz-facts">
          {page.facts.map((f) => (
            <div><span>{f.label}</span><b>{f.value}</b></div>
          ))}
        </div>
      )}

      <p class="lz-lede">{page.lede}</p>

      <div class="lz-sections">
        {page.sections.map((s, i) => (
          <div class="lz-sec reveal">
            <span class="lz-n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
            </div>
          </div>
        ))}
      </div>

      {page.highlights && (
        <div class="lz-high reveal">
          <h2>{page.highlights.heading}</h2>
          <ul>{page.highlights.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      )}

      <Frieze />

      <Faq items={page.faqs} heading={page.crumb} />

      <div class="lz-cta reveal">
        <h2>{page.cta.heading}</h2>
        <p>{page.cta.text}</p>
        <div class="lz-actions">
          <a class="btn btn-solid" href={wa} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn-ghost" href={mail}>E-Mail</a>
        </div>
      </div>

      <div class="lz-more reveal">
        <h2>{page.moreLabel}</h2>
        <p>{page.moreText}</p>
        <a class="lz-morelink" href={`${base}${publicPath(group.en)}` || "/"}>
          {group.en === "index.html" ? "kemet-travel.com" : `kemet-travel.com/${group.en}`}
          <i aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lz-wrap { max-width: 940px; }

  .lz-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: 2px;
    overflow: hidden; margin: 26px 0 30px; }
  .lz-facts > div { background: var(--ink-2); padding: 20px 16px; text-align: center; }
  .lz-facts span { display: block; font-size: .6rem; letter-spacing: .22em;
    text-transform: uppercase; color: var(--muted-2); margin-bottom: 8px; }
  .lz-facts b { font-family: var(--ff-display); font-weight: 400; font-size: 1.15rem;
    line-height: 1.25; color: var(--gold-bright); }

  .lz-lede { font-family: var(--ff-display); font-weight: 300; font-size: 1.28rem;
    line-height: 1.7; color: var(--bone); margin: 0 0 32px; }

  .lz-sec { display: grid; grid-template-columns: 58px 1fr; gap: 22px;
    padding: 26px 0; border-bottom: 1px solid var(--line); }
  .lz-sec:last-child { border-bottom: 0; }
  .lz-n { font-family: var(--ff-display); font-size: 1.7rem; color: var(--gold);
    line-height: 1.2; width: 58px; }
  .lz-sec h2 { font-size: 1.22rem; color: var(--bone); margin: 0 0 10px; }
  .lz-sec p { color: var(--muted); font-size: .96rem; line-height: 1.88; margin: 0; }

  .lz-high { margin-top: 24px; padding: 26px 28px; border-left: 2px solid var(--gold);
    background: rgba(217,180,90,.05); }
  .lz-high h2 { font-size: .68rem; letter-spacing: .28em; text-transform: uppercase;
    font-family: var(--ff-body); font-weight: 400; color: var(--gold); margin: 0 0 14px; }
  .lz-high ul { list-style: none; margin: 0; padding: 0; }
  .lz-high li { position: relative; padding-left: 18px; color: var(--muted);
    font-size: .93rem; line-height: 1.75; margin-bottom: 11px; }
  .lz-high li:last-child { margin-bottom: 0; }
  .lz-high li::before { content: ""; position: absolute; left: 0; top: .68em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--gold); opacity: .8; }

  .lz-cta { margin-top: 34px; padding: 32px 34px; border: 1px solid var(--line-2);
    border-radius: 2px; background: linear-gradient(165deg, rgba(30,25,18,.92), rgba(14,17,21,.7)); }
  .lz-cta h2 { font-size: 1.5rem; color: var(--bone); margin: 0 0 10px; }
  .lz-cta p { color: var(--muted); font-size: .97rem; line-height: 1.8; margin: 0 0 22px;
    max-width: 640px; }
  .lz-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  .lz-more { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--line); }
  .lz-more h2 { font-size: .68rem; letter-spacing: .28em; text-transform: uppercase;
    font-family: var(--ff-body); font-weight: 400; color: var(--gold); margin: 0 0 10px; }
  .lz-more p { color: var(--muted-2); font-size: .9rem; line-height: 1.75; margin: 0 0 12px;
    max-width: 680px; }
  .lz-morelink { display: inline-flex; align-items: center; gap: 12px; color: var(--gold);
    font-size: .88rem; }
  .lz-morelink i { width: 30px; height: 1px; background: currentColor; transition: width .5s; }
  .lz-morelink:hover i { width: 50px; }

  @media(max-width:820px){ .lz-facts { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:680px){
    .lz-lede { font-size: 1.14rem; }
    .lz-facts > div { padding: 16px 12px; }
    .lz-high { padding: 22px 20px 22px 19px; }
    .lz-cta { padding: 26px 20px; }
    .lz-actions .btn { width: 100%; text-align: center; }
    /* Site-wide phone rule: numeral above its heading. */
    .lz-sec { display: block; padding: 22px 0; }
    .lz-n { display: block; width: auto; font-size: 1.25rem; margin-bottom: 8px; }
  }
</style>
