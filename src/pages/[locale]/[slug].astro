---
// Every localised page — /de/…, /it/…, /es/…, /fr/…, /ru/…, /id/…, /ms/…,
// /pt/…, /ar/… — lives at this one flat route, and there are three kinds:
//
//   · the eight funnel pages, one per locale  (data/i18n/<locale>.ts)
//   · pages that exist in one language only   (data/i18n/standalone.ts)
//   · translated journeys from the catalogue  (data/tours-i18n/<locale>.ts)
//
// They share a URL shape and nothing else, so this file only decides WHICH
// body to render. The bodies are components: LocalizedArticle for the first
// two, LocalizedTour for the third. A journey is flat inside the locale
// folder like everything else rather than under a /journeys/ subfolder,
// because that folder's own name would have to be in English.
import LocalizedArticle from "@/components/i18n/LocalizedArticle.astro";
import LocalizedTour from "@/components/tour/LocalizedTour.astro";
import { de } from "@/data/i18n/de";
import { it } from "@/data/i18n/it";
import { es } from "@/data/i18n/es";
import { fr } from "@/data/i18n/fr";
import { ru } from "@/data/i18n/ru";
import { id } from "@/data/i18n/id";
import { ms } from "@/data/i18n/ms";
import { pt } from "@/data/i18n/pt";
import { ar } from "@/data/i18n/ar";
import type { LocalizedPage } from "@/data/i18n/types";
import { STANDALONE_PAGES, standaloneRoute } from "@/data/i18n/standalone";
import { TRANSLATION_GROUPS, TRANSLATED_LOCALES } from "@/config/i18n";
import type { TranslatedLocale } from "@/config/i18n";
import { TRANSLATED_TOURS } from "@/config/tour-i18n";
import { tours as allTours } from "@/data/tours";
import type { TourText } from "@/data/tours-i18n/types";
import type { Tour } from "@/types";

/**
 * One of the three shapes this route renders. Typed here rather than left as
 * Record<string, unknown>: with getStaticPaths present, Astro infers
 * Astro.props from what the paths carry, so an untyped props bag makes every
 * field `unknown` at the point of use.
 */
type LocaleProps =
  | { page: LocalizedPage; tourText?: undefined; locale: TranslatedLocale; route: string }
  | { page?: undefined; tourText: TourText; locale: TranslatedLocale; route: string };

export function getStaticPaths() {
  const sets: Record<TranslatedLocale, LocalizedPage[]> = { de, it, es, fr, ru, id, ms, pt, ar };
  const paths: Array<{ params: { locale: string; slug: string }; props: LocaleProps }> = [];

  for (const locale of TRANSLATED_LOCALES) {
    for (const page of sets[locale]) {
      const group = TRANSLATION_GROUPS.find((g) => g.key === page.groupId);
      if (!group) continue;
      // "de/aegypten-visum.html" → slug "aegypten-visum"
      const slug = group[locale].split("/")[1].replace(/\.html$/, "");
      paths.push({ params: { locale, slug }, props: { page, locale, route: group[locale] } });
    }
  }

  for (const p of STANDALONE_PAGES) {
    paths.push({
      params: { locale: p.locale, slug: p.slug },
      props: { page: p.page, locale: p.locale, route: standaloneRoute(p) },
    });
  }

  for (const t of TRANSLATED_TOURS) {
    paths.push({
      params: { locale: t.locale, slug: t.text.localeSlug },
      props: { tourText: t.text, locale: t.locale, route: t.route },
    });
  }

  return paths;
}

const { page, tourText, locale, route } = Astro.props;

// The English journey a translated one hangs off: its price, its photographs
// and its day numbering. There is one price for a journey, not one per
// language. config/tour-i18n.ts has already refused to build a translation
// whose journey does not exist, so this cannot be undefined in practice —
// the check is here so the type says so too.
const englishTour: Tour | undefined = tourText
  ? allTours.find((t) => t.slug === tourText.slug)
  : undefined;
---
{tourText && englishTour
  ? <LocalizedTour tour={englishTour} text={tourText} locale={locale} route={route} />
  : <LocalizedArticle page={page!} locale={locale} route={route} />}
