---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import Frieze from "@/components/Frieze.astro";
import CustomerGallery from "@/components/CustomerGallery.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SymbolIcon from "@/components/SymbolIcon.astro";
import TourCard from "@/components/TourCard.astro";
import SeasonalStrip from "@/components/collection/SeasonalStrip.astro";
import StandardOfTravel from "@/components/trust/StandardOfTravel.astro";
import { multidayTours, dayTours } from "@/data/tours";
import { identities } from "@/data/identities";
import { destinations } from "@/data/destinations";
import { getExperience } from "@/data/experiences";
import { breadcrumb } from "@/schemas/jsonld";
import { pad2 } from "@/utils/format";

// Six featured cards: the four flagship multi-day journeys plus two day tours.
const featured = [...multidayTours.slice(0, 4), ...dayTours.slice(0, 2)];

// [symbol, title, blurb, href] for the four section pillars.
const pillars: ReadonlyArray<readonly [string, string, string, string]> = [
  ["ankh", "The 8 Identities", "Eight cultural worlds along one river — Pharaonic, Nubian, Coptic, Islamic and more.", "identities.html"],
  ["sun", "Activities", "Dawn balloons over Luxor, sunset feluccas at Aswan, Red Sea reefs and desert dunes.", "activities.html"],
  ["lotus", "Cuisine", "From koshari and molokhia to kunafa — the everyday flavours of Egypt, properly guided.", "cuisine.html"],
  ["eye", "Culture", "The gods, hieroglyphs and living crafts behind the monuments you walk through.", "culture.html"],
];

// Signature experiences for the mosaic — curated picks with photography.
const mosaicIds = [
  "hot-air-balloon-luxor",
  "sunrise-giza-pyramids",
  "private-nile-dinner-cruise",
  "red-sea-yacht-day",
  "nubian-village-experience",
] as const;
const mosaic = mosaicIds
  .map((id) => getExperience(id))
  .filter((e): e is NonNullable<typeof e> => !!e?.hero?.src);
const mosaicShape = ["tall", "wide", "", "", ""]; // grid spans per position
const mosaicHook = [
  "Drift above the Valley of the Kings as the sun rises over Thebes.",
  "The plateau before it opens — silence, first light and 4,500 years.",
  "A vessel reserved for your party alone as the city lights come on.",
  "Ras Mohammed's coral walls from a charter that follows your day.",
  "Hibiscus tea and henna in a family home above the river.",
];

// Destination strip — the five cities in catalogue order.
const strip = destinations.filter((d) => d.hero?.src);
const stripKicker: Record<string, string> = {
  cairo: "The Capital",
  giza: "The Wonder",
  luxor: "The Open-Air Museum",
  aswan: "The Gentle South",
  alexandria: "The Mediterranean",
  hurghada: "The Reef Coast",
  "sharm-el-sheikh": "The Sinai Edge",
  fayoum: "The Oasis",
};
const stripLine: Record<string, string> = {
  cairo: "Two great museums & a medieval city",
  giza: "The last ancient wonder standing",
  luxor: "Karnak & the Valley of the Kings",
  aswan: "Philae, feluccas & Nubian colour",
  alexandria: "Greco-Roman Egypt beside the sea",
  hurghada: "Island reefs & the beach coda",
  "sharm-el-sheikh": "Ras Mohammed & desert stars",
  fayoum: "Whale fossils & desert waterfalls",
};
const roman = ["i", "ii", "iii", "iv", "v", "vi", "vii", "viii"];

// The questions people settle before they will look at an itinerary. Each one
// already has a full page behind it; until now those pages were only reachable
// from the footer, so the most-visited page on the site offered no route to
// them. [href, kicker, question, answer, symbol]
const decisions: ReadonlyArray<readonly [string, string, string, string, string]> = [
  ["when-to-go.html", "The timing", "When should we go?",
   "Egypt month by month — heat, crowds, prices and festivals, with an honest verdict on each of the twelve.", "sun"],
  ["egypt-tour-cost.html", "The budget", "What does it actually cost?",
   "What a private, tailor-made journey costs per person per day, the five things that move the price, and where we sit.", "scarab"],
  ["visa.html", "The paperwork", "Do we need a visa?",
   "Entry rules by nationality — visa on arrival, e-Visa or visa-free — with the fee, the permitted stay and the documents.", "horus"],
  ["compare.html", "The choices", "Cruise or land tour?",
   "The decisions people get stuck on — dahabiya or cruise ship, Luxor or Aswan, which Cairo museum. Verdict first.", "eye"],
  ["occasions.html", "The occasion", "We're travelling for a reason",
   "A proposal, a milestone birthday, a second visit, three generations travelling together — planned around the occasion.", "lotus"],
];

const jsonld = breadcrumb([["Home", "index.html"]]);
---
<Base
  title="Luxury Private Egypt Tours & Nile Cruises | Kemet"
  description="Private, tailor-made luxury Egypt tours led by licensed Egyptologist guides — Cairo, Giza, Luxor, Aswan and Nile cruises, with transparent all-inclusive pricing."
  active="index.html"
  jsonld={jsonld}
>
  <Hero />

  <Frieze />

  {/* ── The premise — editorial overlap ── */}
  <section style="padding-top:110px">
    <div class="wrap">
      <div class="ov-grid">
        <div class="ov-copy reveal">
          <span class="eyebrow">01 · The Premise</span>
          <h2>Egypt is not one country. It is eight.</h2>
          <p>Most itineraries show you one Egypt — a pyramid, a temple, a photograph — and move on. We plan for the others: the Nubian south around Aswan, Coptic and Islamic Cairo, the Greco-Roman Mediterranean at Alexandria, the Bedouin deserts of Sinai, the palm-shaded oasis of Siwa and the coral coast of the Red Sea.</p>
          <p>A single private journey can hold several of these worlds at once, led throughout by a licensed Egyptologist.</p>
          <a class="more" href="identities.html">Discover the Eight Identities <i aria-hidden="true"></i></a>
        </div>
        <div class="ov-media reveal cur" data-glare>
          <div class="main">
            <img src="/images/cairo/cairo-citadel-mosque-dusk.webp" alt="The Mosque of Muhammad Ali crowning the Saladin Citadel in Cairo at dusk" width="1600" height="1066" loading="lazy" decoding="async" />
          </div>
          <div class="over">
            <img src="/images/aswan/aswan-felucca-sailing-nile.webp" alt="A felucca under white sail on the Nile at Aswan" width="736" height="981" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div class="grid-4 grid-tease" style="margin-top:96px">
        {pillars.map(([sym, name, blurb, href]) => (
          <a class="tease reveal" href={href} data-tilt>
            <div class="sym"><SymbolIcon name={sym} /></div>
            <h3>{name}</h3>
            <p>{blurb}</p>
            <span class="more">Explore <b>→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Signature journeys ── */}
  <section style="padding-top:0">
    <div class="wrap">
      <SectionHeader
        no="02"
        eyebrow="02 · The Journeys"
        title="Signature private journeys"
        text="Twenty-five private itineraries, from a half-day at the Sphinx to a fourteen-day grand tour taking in the Nile and the Red Sea. Every price shown is per person and genuinely all-inclusive — your own Egyptologist guide, all entrance fees, daily lunch and private air-conditioned transfers, with no hidden extras."
      />
      <div class="grid-3">
        {featured.map((tour) => <TourCard tour={tour} />)}
      </div>
      <div class="hero-actions" style="margin-top:56px;justify-content:center;opacity:1;animation:none">
        <a href="tours.html" class="btn btn-solid">View all 25 journeys</a>
      </div>
    </div>
  </section>

  {/* ── Stats band ── */}
  <section style="padding:0">
    <div class="stats-band">
      <div class="wrap">
        <div class="stats-row">
          <div class="stat"><div class="num">25</div><div class="slab">Private Journeys</div></div>
          <div class="stat"><div class="num">8</div><div class="slab">Worlds of Egypt</div></div>
          <div class="stat"><div class="num">15</div><div class="slab">Curated Experiences</div></div>
          <div class="stat"><div class="num">100<sup>%</sup></div><div class="slab">Private &amp; Tailor-Made</div></div>
        </div>
      </div>
    </div>
  </section>

  {/* ── The standard — what "luxury" means here, in checkable specifics ──
       This is the site's most-visited page and, for most visitors, the first
       thing they ever see of the brand. It has to place us in the right tier
       within ten seconds — including telling the wrong traveller, plainly,
       that this is not for them. */}
  <section>
    <div class="wrap">
      <StandardOfTravel eyebrow="03 · The Standard" />
    </div>
  </section>

  {/* ── Before you choose — the five questions that precede an itinerary ── */}
  <section style="padding-top:0">
    <div class="wrap">
      <SectionHeader
        no="04"
        eyebrow="04 · Before You Choose"
        title="The questions that come before the itinerary"
        text="Almost nobody picks a journey first. They settle the month, the budget, the paperwork and the shape of the trip — and only then look at itineraries. Each of these is answered in full, plainly, and without asking you for anything."
      />
      <div class="dec-grid">
        {decisions.map(([href, kicker, question, answer, sym]) => (
          <a class="dec pick" href={href}>
            <div class="dec-sym" aria-hidden="true"><SymbolIcon name={sym} /></div>
            <span class="k">{kicker}</span>
            <h3>{question}</h3>
            <p>{answer}</p>
            <span class="more">Read the answer <b>→</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Curated experiences mosaic ── */}
  <section>
    <div class="wrap">
      <SectionHeader
        no="05"
        eyebrow="05 · Curated Experiences"
        title="Moments money can't usually buy"
        text="Early-access mornings, private charters and evenings arranged with a standing relationship — fifteen experiences that turn sightseeing into memory."
      />
      <div class="mosaic">
        {mosaic.map((exp, i) => (
          <a class={`tile reveal cur ${mosaicShape[i] ?? ""}`} href={`experiences/${exp.slug}.html`} data-glare>
            <div class="timg">
              <img src={exp.hero!.src} alt={exp.hero!.alt} width={exp.hero!.width} height={exp.hero!.height} loading="lazy" decoding="async" />
              <div class="tframe" aria-hidden="true"></div>
            </div>
            <div class="tcap">
              <span class="k">{exp.location}</span>
              <h3>{exp.title}</h3>
              <p>{mosaicHook[i]}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Destinations strip ── */}
  <section style="padding-top:0">
    <div class="wrap">
      <SectionHeader
        no="06"
        eyebrow="06 · The Destinations"
        title="Five cities, five thousand years"
      />
    </div>
    <div class="reveal">
      <div class="dstrip" id="dstrip">
        {strip.map((d, i) => (
          <a class="dpost" href={`destinations/${d.slug}.html`} data-glare>
            <div class="dimg">
              <img src={d.hero!.src} alt={d.hero!.alt} width={d.hero!.width} height={d.hero!.height} loading="lazy" decoding="async" />
            </div>
            <div class="dcap">
              <span class="k"><i aria-hidden="true">{roman[i]}</i> · {stripKicker[d.id] ?? ""}</span>
              <h3>{d.title}</h3>
              <span>{stripLine[d.id] ?? d.shortSummary}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="dstrip-nav">
        <button id="dprev" aria-label="Previous destination">←</button>
        <button id="dnext" aria-label="Next destination">→</button>
      </div>
    </div>
  </section>

  {/* ── Our travellers — real guests, real moments ── */}
  <CustomerGallery no="07" eyebrow="07 · Our Travellers" />

  <Frieze />

  {/* ── By season & occasion ── */}
  <SeasonalStrip />

  <Frieze />

  {/* ── The eight worlds ── */}
  <section>
    <div class="wrap">
      <SectionHeader
        no="09"
        eyebrow="09 · The 8 Identities"
        title="The eight worlds of Egypt"
        text="Each of the eight worlds has its own colour, symbol and set of experiences — and most can be combined within a single trip. Together they are the map we travel by, and the reason no two Kemet journeys look quite the same."
      />
      <div class="gods-grid">
        {identities.map((identity, i) => (
          <a class="god reveal" href="identities.html" data-tilt style={`--c:var(${identity.accentVar})`}>
            <div class="sym"><SymbolIcon name={identity.symbol} title={identity.name} /></div>
            <h3>{pad2(i + 1)} · {identity.name}</h3>
            <p>{identity.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* "Before you choose" — deliberately not another card grid. The teaser cards
     sit two sections above, so these read as an index: hairline columns, no
     box, the rule doing the work. Five across on desktop, and on a phone they
     stack into a clean list rather than five tall boxes. */
  .dec-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; }
  .dec {
    /* Flex column so the five "read the answer" links sit on one line however
       long each answer runs — five ragged baselines is exactly the kind of
       untidiness this section is meant to avoid. */
    display: flex; flex-direction: column; position: relative;
    padding: 4px 24px 30px;
    border-left: 1px solid var(--line);
    transition: border-color .5s;
  }
  .dec:first-child { border-left: 0; padding-left: 0; }
  .dec:hover { border-color: rgba(217, 180, 90, .5); }
  .dec-sym { width: 34px; height: 40px; margin-bottom: 16px; opacity: .9;
    filter: drop-shadow(0 5px 14px rgba(217, 180, 90, .22));
    transition: transform .5s cubic-bezier(.22,.61,.36,1); }
  .dec-sym :global(svg) { width: 100%; height: 100%; }
  .dec:hover .dec-sym { transform: translateY(-3px); }
  .dec .k { display: block; font-size: .6rem; letter-spacing: .3em;
    text-transform: uppercase; color: var(--gold-bright); font-weight: 500;
    margin-bottom: 10px; }
  .dec h3 { font-size: 1.16rem; color: var(--bone); margin: 0 0 10px;
    font-weight: 400; line-height: 1.35; }
  .dec p { font-size: .88rem; color: var(--muted); line-height: 1.75;
    margin: 0 0 16px; }
  .dec .more { margin-top: auto; font-size: .66rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--gold); font-weight: 500; }
  .dec:hover .more b { margin-left: 6px; transition: margin .3s; }

  @media(max-width:1080px){
    .dec-grid { grid-template-columns: repeat(3, 1fr); row-gap: 34px; }
    .dec:first-child { border-left: 1px solid var(--line); padding-left: 24px; }
    .dec:nth-child(3n+1) { border-left: 0; padding-left: 0; }
  }
  @media(max-width:680px){
    /* One column. The vertical rule becomes a horizontal one so the list keeps
       its spine instead of dissolving into five unrelated blocks. */
    .dec-grid { grid-template-columns: 1fr; row-gap: 0; }
    .dec, .dec:first-child, .dec:nth-child(3n+1) {
      border-left: 0; padding: 26px 0 26px 46px;
      border-top: 1px solid var(--line);
    }
    .dec:first-child { border-top: 0; padding-top: 4px; }
    .dec-sym { position: absolute; left: 0; top: 28px; width: 28px; height: 33px;
      margin: 0; }
    .dec:first-child .dec-sym { top: 6px; }
    .dec h3 { font-size: 1.22rem; }
    .dec p { font-size: .92rem; }
  }
</style>
