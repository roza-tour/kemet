---
// /vip.html — the tier above the published catalogue.
//
// THE DESIGN LANGUAGE
// The reference is an engraved invitation from a maison, not a travel website:
// drawn ornament instead of boxes, metal instead of colour fields. Every
// decorative element here is constructed — cartouche frames with cut corners,
// a winged-sun crest, lotus dividers, silk ribbon edges in crimson and
// emerald, engraved numerals behind the plates — because ornament that is
// drawn reads as craft, and craft is what this tier is selling.
// Everything is scoped under .vip; nothing leaks to the other 193 pages.
//
// NO PRICES, ON PURPOSE
// Explained in data/vip.ts: a dahabiya charter, a private aircraft leg or an
// exclusive site booking is quoted by date and by party. A published figure
// would be wrong for almost everyone reading it, and this is the tier where a
// wrong number costs more than no number. There is therefore no price in the
// structured data either — nothing is claimed that is not stated.
import Base from "@/layouts/Base.astro";
import SymbolIcon from "@/components/SymbolIcon.astro";
import { vipProgrammes, vipStandard, vipFaqs, VIP_QUESTION, VIP_ANSWER } from "@/data/vip";
import { breadcrumb, answerPageSchema, ORG_ID } from "@/schemas/jsonld";
import { marketCountries } from "@/data/markets";
import { whatsappLink, mailtoLink } from "@/utils/links";

const ROUTE = "vip.html";

const wa = whatsappLink(
  "Hello Kemet — I would like to talk about a private VIP programme in Egypt.",
);
const mail = mailtoLink(
  "Kemet — private VIP programme enquiry",
  "Please tell us who is travelling, roughly when, and what the journey is for.\n\n",
);

const jsonld: Record<string, unknown>[] = [
  // The same structural layer every planning page on this site carries — an
  // answer node with speakable + reviewedBy, a Question/Answer restatement,
  // a FAQPage, a Service node typed to what is actually offered, and an
  // audience declaration — not a keyword list bolted to a title.
  answerPageSchema({
    route: ROUTE,
    name: "Kemet VIP — fully private Egypt, by arrangement",
    description:
      "Named sites reserved for one party, full dahabiya charter, private aircraft between cities, and one person answering throughout.",
    question: VIP_QUESTION,
    answer: VIP_ANSWER,
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Kemet VIP — private Egypt programmes by arrangement",
    serviceType: "Fully private, tailor-made luxury travel in Egypt",
    provider: { "@id": ORG_ID },
    areaServed: { "@type": "Country", name: "Egypt" },
    // The same market list the organisation declares, so the top tier is not
    // described as being for a vaguer audience than the business as a whole.
    // A page that says "fully private, exclusive-use travel" and then names no
    // market is asking an answer engine to guess who it is for.
    audience: {
      "@type": "Audience",
      audienceType:
        "Travellers and families seeking fully private, exclusive-use travel in Egypt",
      geographicArea: marketCountries(),
    },
    availableChannel: {
      "@type": "ServiceChannel",
      name: "Private enquiry",
      description: "Handled by one person; non-disclosure on request.",
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "VIP programmes",
      itemListElement: vipProgrammes.map((p) => ({
        "@type": "Offer",
        // No price and no priceSpecification — deliberately. Each is quoted
        // per brief, and claiming otherwise in the graph would be false.
        itemOffered: { "@type": "Trip", name: p.title, description: p.kicker },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: vipFaqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumb([["Home", "index.html"], ["VIP", ROUTE]]),
];
---
<Base
  title="Kemet VIP — Fully Private Egypt Tours, By Arrangement"
  description="The tier above the catalogue: full dahabiya charter, private aircraft, named sites reserved exclusively for your party, and a personal attaché. Designed per brief."
  active={ROUTE}
  jsonld={jsonld}
  keywords="vip egypt tours, ultra luxury egypt travel, private egypt tour, exclusive pyramids visit, dahabiya full charter egypt, private jet egypt tour, egypt honeymoon luxury, discreet luxury travel egypt, bespoke egypt itinerary, egypt concierge travel"
  showCta={false}
>
  <div class="vip">

    {/* Drawn ornament, defined once and stamped wherever it recurs. */}
    <svg class="vdefs" aria-hidden="true" focusable="false">
      {/* Winged sun — the crest. Two swept wings, a disk, twin uraei drops. */}
      <symbol id="v-wing" viewBox="0 0 340 72">
        <g fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="170" cy="30" r="15" fill="currentColor" fill-opacity=".14" />
          <circle cx="170" cy="30" r="15" />
          <circle cx="170" cy="30" r="9.5" />
          <path d="M153 32 C120 8 62 4 8 26 C60 22 96 30 128 44 C138 48 150 44 153 32 Z" />
          <path d="M150 36 C118 22 74 20 30 32" stroke-opacity=".55" />
          <path d="M146 41 C120 33 92 32 58 39" stroke-opacity=".35" />
          <path d="M187 32 C220 8 278 4 332 26 C280 22 244 30 212 44 C202 48 190 44 187 32 Z" />
          <path d="M190 36 C222 22 266 20 310 32" stroke-opacity=".55" />
          <path d="M194 41 C220 33 248 32 282 39" stroke-opacity=".35" />
          <path d="M162 46 q-3 10 2 18 M178 46 q3 10 -2 18" stroke-opacity=".8" />
        </g>
      </symbol>
      {/* Lotus divider — a bloom between two long hairlines. */}
      <symbol id="v-lotus" viewBox="0 0 480 40">
        <g fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M240 32 C232 22 230 12 240 4 C250 12 248 22 240 32 Z" />
          <path d="M240 32 C228 26 218 24 210 28 C220 14 230 12 236 14" stroke-opacity=".7" />
          <path d="M240 32 C252 26 262 24 270 28 C260 14 250 12 244 14" stroke-opacity=".7" />
          <path d="M0 32 H198" stroke-opacity=".5" />
          <path d="M282 32 H480" stroke-opacity=".5" />
          <path d="M198 32 l6 -4 6 4 -6 4 Z" fill="currentColor" stroke="none" />
          <path d="M270 32 l6 -4 6 4 -6 4 Z" fill="currentColor" stroke="none" />
        </g>
      </symbol>
    </svg>

    {/* ── Hero: engraved invitation over Karnak ─────────────────────────── */}
    <header class="vhero">
      <div class="vhero-bg" aria-hidden="true"></div>
      <div class="vhero-veil" aria-hidden="true"></div>
      <div class="vsheen" aria-hidden="true"></div>

      {/* The cartouche: double hairline with cut corners and diamond joints. */}
      <div class="vcart" aria-hidden="true">
        <i class="vd vd-tl"></i><i class="vd vd-tr"></i>
        <i class="vd vd-bl"></i><i class="vd vd-br"></i>
      </div>

      <div class="wrap vhero-in">
        <svg class="vcrest" aria-hidden="true"><use href="#v-wing" /></svg>

        <p class="vtag"><span></span>By private arrangement<span></span></p>

        <h1>
          The quietest way<br />
          <em>through Egypt</em>
        </h1>

        <svg class="vdiv" aria-hidden="true"><use href="#v-lotus" /></svg>

        <p class="vlede">
          For guests who want Egypt entirely to themselves — the site, the boat,
          the day. Programmes at this tier are designed once, for one party, and
          never repeated in the same shape.
        </p>

        <div class="vhero-acts">
          <a href={wa} class="vbtn" target="_blank" rel="noopener"><span>Speak to us privately</span></a>
          <a href={mail} class="vlink-quiet">or send a confidential brief</a>
        </div>
      </div>
      <div class="vband" aria-hidden="true"></div>
    </header>

    {/* ── The three facts, set as engraved medallions ───────────────────── */}
    <section class="vfacts">
      <div class="wrap vfacts-in">
        {[
          ["ankh", "Named sites, reserved", "closed to other visitors while your party is inside"],
          ["sun", "Private aircraft & full charter", "every internal movement on your hours, nobody else aboard"],
          ["eye", "One name answering", "the person who designs the journey answers throughout it"],
        ].map(([sym, head, sub]) => (
          <div class="vfact">
            <span class="vmed" aria-hidden="true"><SymbolIcon name={sym} /></span>
            <b>{head}</b>
            <span class="vfact-sub">{sub}</span>
          </div>
        ))}
      </div>
    </section>

    {/* ── The programmes: framed plates with silk edges ─────────────────── */}
    <section class="vprogs">
      <div class="wrap">
        <div class="vhead">
          <p class="voverline"><span></span>The programmes<span></span></p>
          <h2>Four ways to take Egypt<br />at this level</h2>
        </div>
      </div>

      {vipProgrammes.map((p, idx) => (
        <article
          class:list={["vplate", `is-${p.accent}`, idx % 2 === 1 && "is-flip"]}
          id={`programme-${p.numeral.toLowerCase()}`}
        >
          <span class="vplate-ghost" aria-hidden="true">{p.numeral}</span>
          <div class="wrap vplate-in">
            <figure class="vframe">
              <span class="vframe-tick vt-tl" aria-hidden="true"></span>
              <span class="vframe-tick vt-tr" aria-hidden="true"></span>
              <span class="vframe-tick vt-bl" aria-hidden="true"></span>
              <span class="vframe-tick vt-br" aria-hidden="true"></span>
              <img src={p.image.src} alt={p.image.alt} width="1600" height="1066"
                   loading={idx === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption class="vframe-no" aria-hidden="true">{p.numeral}</figcaption>
            </figure>

            <div class="vtext">
              <p class="vmeta">
                <span>{p.duration}</span>
                <i aria-hidden="true"></i>
                <span>{p.route}</span>
              </p>
              <h3>{p.title}</h3>
              <p class="vkick">{p.kicker}</p>
              <p class="vbody">{p.body}</p>
              <ul class="vincl">
                {p.includes.map((i) => <li>{i}</li>)}
              </ul>
              <div class="vfoot">
                <span class="vfoot-note">Quoted per brief</span>
                <a href={wa} target="_blank" rel="noopener" class="vfoot-link">
                  Enquire about {p.title} <b>→</b>
                </a>
              </div>
            </div>
          </div>
          {idx < vipProgrammes.length - 1 && (
            <svg class="vdiv vdiv-sec" aria-hidden="true"><use href="#v-lotus" /></svg>
          )}
        </article>
      ))}
    </section>

    {/* ── How this tier is run ──────────────────────────────────────────── */}
    <section class="vhow">
      <div class="wrap">
        <p class="voverline"><span></span>How this tier is run<span></span></p>
        <div class="vhow-grid">
          {vipStandard.map((st, i) => (
            <div class="vhow-item">
              <span class="vhow-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h2>{st.title}</h2>
              <p>{st.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── The questions this clientele actually asks ────────────────────── */}
    <section class="vfaq">
      <div class="wrap">
        <p class="voverline"><span></span>Before you write<span></span></p>
        <div class="vfaq-list">
          {vipFaqs.map((f) => (
            <details class="vfaq-item">
              <summary>{f.q}<i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ── The close: an invitation card ─────────────────────────────────── */}
    <section class="vclose">
      <div class="wrap">
        <div class="vcard">
          <i class="vd vd-tl"></i><i class="vd vd-tr"></i>
          <i class="vd vd-bl"></i><i class="vd vd-br"></i>
          <svg class="vcrest vcrest-sm" aria-hidden="true"><use href="#v-wing" /></svg>
          <h2>Tell us what the journey is for.</h2>
          <p>
            Who is travelling, roughly when, and what it should feel like. You
            will have a written outline before any figure is discussed, and a
            figure before anything is committed. Everything stays between us.
          </p>
          <div class="vhero-acts">
            <a href={wa} class="vbtn" target="_blank" rel="noopener"><span>WhatsApp, privately</span></a>
            <a href={mail} class="vlink-quiet">or by email</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ==========================================================================
     Scoped palette. Ink is nearly black with a warm cast; the metals are three
     golds (deep, true, lit) so gradients read as metal rather than yellow; the
     crimson and emerald are dark enough to read as silk, not paint.
     ========================================================================== */
  .vip {
    --v-ink: #070503;
    --v-ink-2: #0D0A07;
    --v-cream: #F0E7D6;
    --v-cream-dim: #BCB09A;
    --v-faint: #7A7263;
    --v-gold-deep: #8A6D2A;
    --v-gold: #C2A24E;
    --v-gold-lit: #EFD9A0;
    --v-hair: rgba(194, 162, 78, .28);
    --v-hair-2: rgba(194, 162, 78, .55);
    --v-crimson: #7E1424;
    --v-crimson-lit: #A62436;
    --v-emerald: #0C4A39;
    --v-emerald-lit: #1A6B52;
    background:
      radial-gradient(110% 50% at 8% 4%, rgba(126, 20, 36, .12), transparent 60%),
      radial-gradient(110% 50% at 94% 30%, rgba(12, 74, 57, .1), transparent 60%),
      var(--v-ink);
    font-feature-settings: "liga", "kern";
    overflow: hidden;
  }
  .vip .wrap { max-width: 1220px; }
  .vdefs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* Overlines with flanking hairlines — nothing on this page is a bare label. */
  .voverline { display: flex; align-items: center; justify-content: center;
    gap: 22px; font-size: .6rem; letter-spacing: .5em; text-transform: uppercase;
    color: var(--v-gold); margin: 0 0 62px; }
  .voverline span { width: 72px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--v-hair-2)); }
  .voverline span:last-child {
    background: linear-gradient(90deg, var(--v-hair-2), transparent); }

  /* Diamond joints used by every drawn frame. */
  .vd { position: absolute; width: 9px; height: 9px; transform: rotate(45deg);
    background: linear-gradient(135deg, var(--v-gold-lit), var(--v-gold-deep));
    box-shadow: 0 0 14px rgba(194, 162, 78, .55); }
  .vd-tl { top: -5px; left: -5px; } .vd-tr { top: -5px; right: -5px; }
  .vd-bl { bottom: -5px; left: -5px; } .vd-br { bottom: -5px; right: -5px; }

  /* ===== hero ============================================================ */
  .vhero { position: relative; min-height: 100vh; display: flex;
    align-items: center; justify-content: center; overflow: hidden;
    text-align: center; }
  .vhero-bg { position: absolute; inset: 0;
    background: url("/images/luxor/luxor-karnak-hypostyle-hall.webp") center 30%/cover no-repeat;
    animation: vzoom 26s ease-out forwards; }
  @keyframes vzoom { from { transform: scale(1.12); } to { transform: scale(1.02); } }
  .vhero-veil { position: absolute; inset: 0; background:
    radial-gradient(120% 90% at 50% 30%, rgba(7,5,3,.32) 0%, rgba(7,5,3,.86) 78%),
    linear-gradient(180deg, rgba(7,5,3,.55), rgba(7,5,3,.35) 40%, rgba(7,5,3,.96) 92%); }
  /* One slow pass of light across the engraving. */
  .vsheen { position: absolute; inset: -20%; pointer-events: none;
    background: linear-gradient(105deg, transparent 44%,
      rgba(239, 217, 160, .07) 50%, transparent 56%);
    animation: vsheen 11s cubic-bezier(.45, 0, .55, 1) infinite; }
  @keyframes vsheen { 0%,100% { transform: translateX(-30%); } 50% { transform: translateX(30%); } }
  @media (prefers-reduced-motion: reduce) {
    .vsheen, .vhero-bg { animation: none; }
  }

  .vcart { position: absolute; inset: 118px 44px 44px; pointer-events: none;
    border: 1px solid var(--v-hair);
    /* cut corners: the hairline stops short of each corner */
    -webkit-mask: linear-gradient(#000, #000);
    }
  .vcart::before { content: ""; position: absolute; inset: 8px;
    border: 1px solid rgba(194, 162, 78, .13); }

  .vhero-in { position: relative; z-index: 2; padding: 170px 0 120px; }

  .vcrest { width: clamp(210px, 26vw, 320px); height: auto; aspect-ratio: 340/72;
    color: var(--v-gold); margin: 0 auto 30px; display: block;
    filter: drop-shadow(0 6px 26px rgba(194, 162, 78, .38)); }
  .vcrest-sm { width: 190px; margin-bottom: 26px; }

  .vtag { display: inline-flex; align-items: center; gap: 16px;
    font-size: .58rem; letter-spacing: .52em; text-transform: uppercase;
    color: var(--v-gold-lit); margin: 0 0 40px; }
  .vtag span { width: 44px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--v-hair-2)); }
  .vtag span:last-child { background: linear-gradient(90deg, var(--v-hair-2), transparent); }

  .vhero h1 { margin: 0; font-weight: 300;
    font-size: clamp(3rem, 7.6vw, 6.6rem); line-height: 1.04;
    color: var(--v-cream); letter-spacing: .01em;
    text-shadow: 0 4px 60px rgba(0,0,0,.6); }
  .vhero h1 em { font-style: italic; font-weight: 300;
    background: linear-gradient(176deg, #FFF4D6 8%, #E3C36A 48%, #A5822F 90%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 8px 42px rgba(194, 162, 78, .4));
    padding-bottom: .08em; }

  .vdiv { width: clamp(280px, 40vw, 480px); height: auto; aspect-ratio: 480/40;
    color: var(--v-gold); display: block; margin: 34px auto 30px; opacity: .9; }
  .vdiv-sec { margin: 96px auto 0; opacity: .55; width: min(480px, 72vw); }

  .vlede { max-width: 620px; margin: 0 auto; color: var(--v-cream-dim);
    font-size: 1.08rem; line-height: 2; }

  .vhero-acts { display: flex; align-items: center; justify-content: center;
    gap: 28px; flex-wrap: wrap; margin-top: 46px; }
  /* The button is a jewel: gold bevel border, dark body, gold sheen on hover. */
  .vbtn { position: relative; display: inline-flex; padding: 1px;
    background: linear-gradient(160deg, var(--v-gold-lit), var(--v-gold-deep) 55%, var(--v-gold-lit));
    box-shadow: 0 18px 44px -18px rgba(194, 162, 78, .55); }
  .vbtn span { display: inline-flex; align-items: center; padding: 16px 40px;
    background: linear-gradient(180deg, #191308, #0C0905);
    color: var(--v-gold-lit); font-size: .62rem; letter-spacing: .34em;
    text-transform: uppercase; transition: background .5s, color .5s; }
  .vbtn:hover span { background: linear-gradient(180deg, var(--v-gold-lit), var(--v-gold));
    color: #14100A; }
  .vlink-quiet { color: var(--v-faint); font-size: .78rem; letter-spacing: .06em;
    border-bottom: 1px solid rgba(194, 162, 78, .3); padding-bottom: 3px;
    transition: color .4s, border-color .4s; }
  .vlink-quiet:hover { color: var(--v-gold-lit); border-color: var(--v-gold); }

  .vband { position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: linear-gradient(90deg, transparent,
      var(--v-crimson) 25%, var(--v-gold) 50%, var(--v-emerald) 75%, transparent); }

  /* ===== the three facts ================================================= */
  .vfacts { border-bottom: 1px solid var(--v-hair);
    background: linear-gradient(180deg, var(--v-ink-2), transparent); }
  .vfacts-in { display: grid; grid-template-columns: repeat(3, 1fr);
    padding: 58px 0; }
  .vfact { text-align: center; padding: 8px 34px; position: relative; }
  .vfact + .vfact::before { content: ""; position: absolute; left: 0; top: 50%;
    transform: translateY(-50%) rotate(45deg); width: 7px; height: 7px;
    background: var(--v-gold); opacity: .7; }
  .vfact + .vfact::after { content: ""; position: absolute; left: 3px; top: 0;
    bottom: 0; width: 1px;
    background: linear-gradient(180deg, transparent, var(--v-hair), transparent); }
  .vmed { display: grid; place-items: center; width: 64px; height: 64px;
    margin: 0 auto 18px; border-radius: 50%; position: relative;
    border: 1px solid var(--v-hair-2);
    background: radial-gradient(circle at 34% 28%, rgba(194,162,78,.2), rgba(7,5,3,.4) 70%);
    box-shadow: 0 0 30px rgba(194,162,78,.18), inset 0 0 18px rgba(194,162,78,.14); }
  .vmed::before { content: ""; position: absolute; inset: 5px; border-radius: 50%;
    border: 1px solid rgba(194, 162, 78, .22); }
  .vmed :global(svg) { width: 26px; height: 30px;
    filter: drop-shadow(0 2px 8px rgba(239,217,160,.5)); }
  .vfact b { display: block; font-family: var(--ff-display); font-weight: 400;
    font-size: 1.18rem; color: var(--v-cream); margin-bottom: 8px; }
  .vfact-sub { color: var(--v-faint); font-size: .84rem; line-height: 1.7; }

  /* ===== programmes ====================================================== */
  .vprogs { padding: 130px 0 40px; position: relative; }
  .vhead { text-align: center; margin-bottom: 100px; }
  .vhead .voverline { margin-bottom: 30px; }
  .vhead h2 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); font-weight: 300;
    color: var(--v-cream); line-height: 1.14; margin: 0; }

  .vplate { position: relative; padding: 40px 0 0; }
  /* The engraved numeral behind each plate — outline only, enormous. */
  .vplate-ghost { position: absolute; top: -30px; z-index: 0;
    font-family: var(--ff-display); font-size: clamp(12rem, 26vw, 24rem);
    line-height: 1; color: transparent;
    -webkit-text-stroke: 1px rgba(194, 162, 78, .13);
    pointer-events: none; user-select: none; }
  .vplate:not(.is-flip) .vplate-ghost { right: 2vw; }
  .vplate.is-flip .vplate-ghost { left: 2vw; }

  .vplate-in { position: relative; z-index: 1; display: grid;
    grid-template-columns: 1.02fr .98fr; gap: clamp(40px, 5vw, 84px);
    align-items: center; padding-top: 40px; padding-bottom: 40px; }
  .vplate.is-flip .vframe { order: 2; }

  /* The frame: image in a double gold hairline with corner ticks and a silk
     ribbon down the outer edge in the plate's accent. */
  .vframe { position: relative; margin: 0; padding: 14px;
    border: 1px solid var(--v-hair-2);
    background: linear-gradient(160deg, rgba(194,162,78,.06), transparent 60%); }
  .vframe::before { content: ""; position: absolute; inset: 6px;
    border: 1px solid rgba(194, 162, 78, .18); pointer-events: none; }
  .vframe img { display: block; width: 100%; height: auto;
    filter: saturate(.94) contrast(1.04);
    box-shadow: 0 34px 80px -30px rgba(0, 0, 0, .9); }
  .vframe-tick { position: absolute; width: 26px; height: 26px; }
  .vframe-tick::before, .vframe-tick::after { content: ""; position: absolute;
    background: var(--v-gold); }
  .vframe-tick::before { width: 100%; height: 2px; }
  .vframe-tick::after { width: 2px; height: 100%; }
  .vt-tl { top: -2px; left: -2px; }
  .vt-tr { top: -2px; right: -2px; transform: scaleX(-1); }
  .vt-bl { bottom: -2px; left: -2px; transform: scaleY(-1); }
  .vt-br { bottom: -2px; right: -2px; transform: scale(-1); }
  .vt-tl::before, .vt-tl::after { top: 0; left: 0; }
