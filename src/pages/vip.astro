---
// /vip.html — Kemet Ultra, the top tier, in English. The address is the one
// Kemet VIP always had: the tier was upgraded in place, so every link, every
// search listing and every Search Console record for vip.html carries on
// unchanged — no redirect. The page itself is components/ultra/UltraPage;
// each translation is a route file like this one.
import UltraPage from "@/components/ultra/UltraPage.astro";
import { en } from "@/data/ultra/en";
---
<UltraPage locale="en" route="vip.html" text={en} />
