---
// Egypt Travel FAQ (/faq.html). Answers are pulled from the maintained travel
// guides plus one authored planning group — see src/data/faq.ts. Emits FAQPage
// JSON-LD so the answers are eligible for rich results and AI-answer citation.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import AnswerBox from "@/components/aeo/AnswerBox.astro";
import Faq from "@/components/Faq.astro";
import Frieze from "@/components/Frieze.astro";
import CTABlock from "@/components/trust/CTABlock.astro";
import { faqGroups, allFaqs } from "@/data/faq";
import { faqPageSchema, answerPageSchema } from "@/schemas/jsonld";

const ROUTE = "faq.html";
// The direct answer, written to survive being lifted out of the page: it
// restates its subject, answers in the first sentence, and carries its own
// figures. See components/aeo/AnswerBox for the rules.
const ANSWER_Q = "How many days do you need in Egypt?";
const ANSWER_A =
  "A week is the most popular length for a first visit to Egypt — enough for Cairo and Giza, Luxor and Aswan, and a stretch of the Nile unhurried. Five days covers the essentials if time is short; ten to fourteen days adds Abu Simbel, Alexandria or the Red Sea without rushing.";
const answerLd = answerPageSchema({
  route: ROUTE,
  name: "Egypt Travel FAQ",
  description: "Straight answers to the questions travellers ask most about visiting Egypt.",
  question: ANSWER_Q,
  answer: ANSWER_A,
});

const jsonld = [answerLd, ...faqPageSchema(allFaqs)];

const keywords = [
  "Egypt travel FAQ",
  "is Egypt safe",
  "best time to visit Egypt",
  "Egypt visa on arrival",
  "how many days in Egypt",
  "Egypt trip cost",
  "Egypt travel tips",
  "planning a trip to Egypt",
].join(", ");
---
<Base
  title="Egypt Travel FAQ — Safety, Visas, Best Time, Costs & Tips | Kemet"
  description="Answers to the most common Egypt travel questions — safety, visas and entry, the best time to visit, how many days you need, costs, getting around, food and more."
  active={ROUTE}
  keywords={keywords}
  jsonld={jsonld}
>
  <PageHero
    crumb="Travel FAQ"
    symbol="horus"
    title="Egypt Travel FAQ"
    text="Straight answers to the questions travellers ask us most — from visas and safety to the best time to go, how long to stay and what a private journey costs."
    heroSrc="/images/giza/giza-camel-pyramids-sunrise.webp"
    heroAlt="A camel resting before the Pyramids of Giza at sunrise"
    heroWidth={736}
    heroHeight={736}
  />

  <section style="padding-top:30px">
    <div class="wrap faq-wrap">

      <AnswerBox question={ANSWER_Q} answer={ANSWER_A} />
      {faqGroups.map((group, i) => (
        <Fragment>
          {i > 0 && <Frieze />}
          <div class="faq-group reveal">
            <div class="faq-grouphead">
              <span class="faq-gnum">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2>{group.heading}</h2>
                {group.intro && <p>{group.intro}</p>}
              </div>
            </div>
            <Faq items={group.items} heading="" />
          </div>
        </Fragment>
      ))}
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <CTABlock
        eyebrow="Still deciding?"
        heading="Ask us your own question"
        subtext="Whatever you're wondering about your trip to Egypt, message us — we answer every enquiry personally, usually within one business day."
        types={["whatsapp", "email"]}
      />
    </div>
  </section>
</Base>

<style>
  .faq-wrap{max-width:880px}
  .faq-group{padding:6px 0}
  .faq-grouphead{display:flex;gap:22px;align-items:baseline;margin-bottom:14px;padding-bottom:16px;border-bottom:1px solid var(--line-2)}
  /* Fraunces has no tabular figures, so `tabular-nums` is ignored and 01/02/03
     each measured a different width — pushing every group heading to a
     slightly different left edge. A fixed box makes the column true. */
  .faq-gnum{font-family:var(--ff-display);font-size:1.9rem;line-height:1;color:var(--gold);flex:none;width:44px;text-align:right}
  .faq-grouphead h2{font-size:1.5rem;color:var(--bone);margin:0}
  .faq-grouphead p{margin:7px 0 0;color:var(--muted);font-size:.95rem;line-height:1.7}
  /* On a phone the numeral + gap pushed the heading to a third left edge.
     Stacking it returns the heading to the page gutter. */
  @media(max-width:680px){
    .faq-grouphead{display:block}
    .faq-gnum{display:block;width:auto;text-align:left;font-size:1.4rem;margin-bottom:6px}
  }
</style>
