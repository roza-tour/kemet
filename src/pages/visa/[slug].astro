---
// Egypt entry requirements, one page per nationality (/visa/<slug>.html).
//
// Entirely data-driven from src/data/entryRequirements.ts — adding a passport
// is a data-only change. Each page answers the question that passport actually
// asks ("do I need a visa, what does it cost, can I buy it on landing?") and
// then adds what a generic visa page cannot: flying time, direct routes, and
// when travellers from that market usually come — which is what turns an
// answer into a trip.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import LeadCapture from "@/components/conversion/LeadCapture.astro";
import TourCard from "@/components/TourCard.astro";
import {
  nationalities, ROUTE_LABEL, ROUTE_SUMMARY, VERIFIED_ON, OFFICIAL_PORTAL,
  VISA_FEE_USD, VISA_FEE_MULTI_USD, SINAI_PERMIT_DAYS,
} from "@/data/entryRequirements";
import type { Nationality } from "@/data/entryRequirements";
import { tours } from "@/data/tours";
import { canonical } from "@/utils/links";
import { site, SITE_URL } from "@/config/site";
import { breadcrumb } from "@/schemas/jsonld";

export function getStaticPaths() {
  return nationalities.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}

interface Props { n: Nationality }
const { n } = Astro.props;
const route = `visa/${n.slug}.html`;
const base = "../";

const verified = new Date(VERIFIED_ON).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});

const needsVisa = n.route !== "visa-free";

// Three journeys to seed a plan. Deliberately the substantial multi-day
// itineraries, NOT the cheapest — a visitor arriving from a search engine
// should meet the standard of travel we actually sell, not the entry price.
const picks = [...tours]
  .filter((t) => /day/i.test(t.durationLabel) && t.price >= 900)
  .sort((a, b) => b.price - a.price)
  .slice(0, 3);

const faqs = [
  {
    q: `Do ${n.demonym} need a visa for Egypt?`,
    a: n.route === "visa-free"
      ? `No. ${n.demonym} may enter Egypt without a tourist visa for stays of up to ${n.stayDays} days. You need a passport valid for at least six months beyond your arrival date.`
      : n.route === "visa-on-arrival"
        ? `Yes, but it is straightforward. ${n.demonym} can buy a single-entry tourist visa on arrival at Egyptian airports for US$${VISA_FEE_USD}, valid for a stay of up to ${n.stayDays} days. The e-Visa is available online at the same price if you would rather travel with it already issued.`
        : `Yes. ${n.demonym} must obtain an Egypt e-Visa online before travelling — a visa cannot be bought on arrival. The single-entry e-Visa costs US$${VISA_FEE_USD} and permits a stay of up to ${n.stayDays} days.`,
  },
  {
    q: "How much does an Egypt tourist visa cost?",
    a: `A single-entry tourist visa costs US$${VISA_FEE_USD}, whether bought on arrival or applied for online as an e-Visa. The multiple-entry e-Visa costs US$${VISA_FEE_MULTI_USD}. The single-entry fee rose from US$25 on 1 March 2026. Visa-on-arrival counters are cash-only, so carry clean US dollar notes.`,
  },
  {
    q: "How long can I stay in Egypt on a tourist visa?",
    a: `A single-entry tourist visa permits a stay of up to ${n.stayDays} days from the date of entry. Extensions are possible inside Egypt through the passport authorities, but they take time — if you already know you want longer, apply for the multiple-entry e-Visa or plan around the ${n.stayDays}-day limit.`,
  },
  {
    q: "What do I need to have with me?",
    a: "A passport valid for at least six months beyond your arrival date, with at least two blank pages. Immigration may ask for your first night's hotel booking and a return or onward ticket — have both reachable on your phone. If we are arranging your journey, we send you a single confirmation document with everything an officer might ask for.",
  },
  ...(n.sinaiPermit ? [{
    q: "What is the Sinai-only entry permit?",
    a: `If your entire trip stays within Sharm el-Sheikh, Dahab, Nuweiba and Taba, ${n.demonym} can be issued a free entry permit at Sinai entry points instead of a visa, valid for ${SINAI_PERMIT_DAYS} days. It is genuinely restrictive: it does not allow travel to Cairo, Luxor, Aswan or anywhere on the Egyptian mainland — not even a day trip. If there is any chance you will want to see the Pyramids, buy the ordinary visa instead.`,
  }] : []),
  {
    q: "Is it better to get the visa on arrival or online?",
    a: n.route === "e-visa"
      ? "For your passport the choice is not open — the e-Visa must be obtained online in advance. Apply at least a few weeks before you fly, since supporting documents are sometimes requested."
      : "Both are valid and cost the same. On arrival is faster to organise and takes a few minutes at the airport bank counter. The e-Visa is calmer: you land with the visa already issued and walk straight to passport control, which matters most after a long flight or when arriving late at night with children.",
  },
  {
    q: `How long is the flight to Egypt from ${n.country}?`,
    a: `${n.flightTime.charAt(0).toUpperCase()}${n.flightTime.slice(1)}. Typical routings: ${n.directFrom.join(", ")}. Cairo is the main gateway; Hurghada, Marsa Alam and Sharm el-Sheikh also receive international flights directly, which is worth knowing if your trip is built around the Red Sea.`,
  },
];

// Long demonyms ("North Macedonian citizens") would push the title past the
// ~65 characters Google shows, so the descriptor is dropped rather than truncated.
const fullTitle = `Egypt Visa for ${n.demonym} (2026) — Cost & Rules | Kemet`;
const title = fullTitle.length <= 65 ? fullTitle : `Egypt Visa for ${n.demonym} (2026) | Kemet`;
const description = needsVisa
  ? `${n.demonym} and Egypt entry: ${ROUTE_LABEL[n.route].toLowerCase()}, US$${VISA_FEE_USD} for ${n.stayDays} days. Fees, documents, flight times and when to go.`
  : `${n.demonym} enter Egypt without a tourist visa for up to ${n.stayDays} days. Entry rules, documents, flight times from ${n.country} and when to travel.`;

const jsonld: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `Egypt visa and entry requirements for ${n.demonym}`,
    description,
    url: canonical(route),
    inLanguage: "en",
    dateModified: VERIFIED_ON,
    about: { "@type": "Country", name: "Egypt" },
    audience: { "@type": "Audience", geographicArea: { "@type": "Country", name: n.country } },
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    publisher: { "@type": "TravelAgency", name: site.name, url: SITE_URL },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumb([
    ["Home", "index.html"],
    ["Egypt Visa by Nationality", "visa.html"],
    [`Visa for ${n.demonym}`, route],
  ]),
];
---
<Base
  title={title}
  description={description}
  active={route}
  jsonld={jsonld}
  keywords={[
    `egypt visa for ${n.demonym.toLowerCase()}`,
    `egypt visa ${n.country.toLowerCase()}`,
    "egypt visa on arrival",
    "egypt e-visa",
    "egypt entry requirements",
    `do ${n.demonym.toLowerCase()} need a visa for egypt`,
    `flights to egypt from ${n.country.toLowerCase()}`,
  ].join(", ")}
>
  <PageHero
    crumb={`Visa for ${n.demonym}`}
    symbol="ankh"
    base={base}
    title={`Egypt Visa for ${n.demonym}`}
    text={`Everything a ${n.country} passport needs to enter Egypt — the rule, the cost, the documents, and the months worth travelling in. Last checked ${verified}.`}
  />

  <section style="padding-top:26px">
    <div class="wrap vwrap">

      {/* The answer, above everything else. */}
      <div class={`vverdict vv-${n.route}`}>
        <span class="vv-label">{ROUTE_LABEL[n.route]}</span>
        <p class="vv-lead">{ROUTE_SUMMARY[n.route]}</p>
        <dl class="vv-facts">
          <div><dt>Cost</dt><dd>{needsVisa ? `US$${VISA_FEE_USD} single entry` : "Free"}</dd></div>
          <div><dt>Maximum stay</dt><dd>{n.stayDays} days</dd></div>
          <div><dt>Passport validity</dt><dd>6 months beyond arrival</dd></div>
          <div><dt>Blank pages</dt><dd>At least 2</dd></div>
        </dl>
        <p class="vv-auth">
          Rules are set by the Egyptian government and can change. This page was checked on
          {" "}<strong>{verified}</strong> — confirm on the official portal at{" "}
          <a href={OFFICIAL_PORTAL} rel="nofollow noopener" target="_blank">visa2egypt.gov.eg</a>{" "}
          before you book.
        </p>
      </div>

      {n.note && (
        <div class="vnote">
          <span aria-hidden="true">◆</span>
          <p>{n.note}</p>
        </div>
      )}

      <Frieze />

      <div class="grid-2 vgrid">
        <div>
          <h2>Getting there from {n.country}</h2>
          <p class="vbody">{n.flightTime.charAt(0).toUpperCase() + n.flightTime.slice(1)}.</p>
          <h3 class="vsub">Usual routings</h3>
          <ul class="vlist">
            {n.directFrom.map((d) => <li>{d}</li>)}
          </ul>
          <p class="vbody vmuted">
            Cairo is the main gateway, but Luxor, Hurghada, Marsa Alam and Sharm el-Sheikh all take
            international flights. Landing at the right airport can save a full day of a short trip —
            we plan the routing with the itinerary, not after it.
          </p>
        </div>
        <div>
          <h2>When {n.demonym} usually travel</h2>
          <p class="vbody">{n.seasonNote}</p>
          <a class="vmore" href={`${base}guides/best-time-to-visit-egypt.html`}>
            Egypt month by month <i aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <Frieze />

      <Faq items={faqs} heading={`Egypt visa questions — ${n.demonym}`} />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <h2 class="vpicks-h">Journeys to start from</h2>
      <p class="vpicks-p">
        Private throughout, led by a licensed Egyptologist, with no shared coaches and no fixed
        departure dates. These are starting points — tell us your dates and your party and the
        itinerary is rewritten around them.
      </p>
      <div class="grid-3">
        {picks.map((t) => <TourCard tour={t} base={base} />)}
      </div>
    </div>
  </section>

  <LeadCapture
    variant="planning"
    heading={`Planning a trip from ${n.country}?`}
    subtext="Send us your dates and who is travelling. We reply personally, usually within one business day, with a real itinerary and a price."
    whatsappMessage={`Hello Kemet — I'm travelling from ${n.country} and would like help planning a private trip to Egypt.`}
    emailSubject={`Enquiry from ${n.country} — Kemet Egypt`}
  />
</Base>

<style>
  .vwrap { max-width: 940px; }

  /* The verdict block — the single thing the visitor came for. */
  .vverdict {
    border: 1px solid var(--line-2); border-radius: 2px; padding: 32px 34px;
    background: linear-gradient(165deg, rgba(30,25,18,.92), rgba(14,17,21,.72));
    position: relative; overflow: hidden;
  }
  .vverdict::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent); opacity: .8;
  }
  .vv-label {
    display: inline-block; font-size: .68rem; letter-spacing: .3em; text-transform: uppercase;
    color: var(--ink); background: var(--gold); padding: 7px 14px; border-radius: 2px;
    font-weight: 500; margin-bottom: 18px;
  }
  .vv-lead { color: var(--bone); font-size: 1.06rem; line-height: 1.75; margin: 0 0 22px; }
  .vv-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    border-top: 1px solid var(--line); padding-top: 20px; margin: 0; }
  .vv-facts dt { font-size: .64rem; letter-spacing: .26em; text-transform: uppercase;
    color: var(--muted-2); margin-bottom: 6px; }
  .vv-facts dd { margin: 0; color: var(--gold-bright); font-family: var(--ff-display);
    font-size: 1.15rem; line-height: 1.25; }
  .vv-auth { margin: 22px 0 0; font-size: .84rem; color: var(--muted-2); line-height: 1.65;
    border-top: 1px solid var(--line); padding-top: 16px; }
  .vv-auth a { color: var(--gold); border-bottom: 1px solid var(--line-2); }
  .vv-auth a:hover { color: var(--gold-bright); }

  .vnote { display: flex; gap: 14px; margin-top: 22px; padding: 18px 22px;
    border-left: 2px solid var(--gold); background: rgba(217,180,90,.05); }
  .vnote span { color: var(--gold); font-size: .7rem; line-height: 2.2; }
  .vnote p { margin: 0; color: var(--muted); font-size: .94rem; line-height: 1.75; }

  .vgrid { gap: 46px; align-items: start; }
  .vgrid h2 { font-size: 1.55rem; color: var(--bone); margin-bottom: 14px; }
  .vsub { font-size: .68rem; letter-spacing: .28em; text-transform: uppercase;
    color: var(--gold); margin: 24px 0 10px; font-family: var(--ff-body); font-weight: 400; }
  .vbody { color: var(--muted); font-size: .97rem; line-height: 1.8; margin: 0 0 6px; }
  .vmuted { margin-top: 20px; color: var(--muted-2); font-size: .92rem; }
  .vlist { list-style: none; margin: 0; padding: 0; }
  .vlist li { position: relative; padding-left: 18px; color: var(--muted);
    font-size: .95rem; margin-bottom: 6px; }
  .vlist li::before { content: ""; position: absolute; left: 0; top: .62em;
    width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }
  .vmore { display: inline-flex; align-items: center; gap: 12px; margin-top: 22px;
    font-size: .68rem; letter-spacing: .3em; text-transform: uppercase; color: var(--gold); }
  .vmore i { width: 34px; height: 1px; background: currentColor;
    transition: width .5s cubic-bezier(.22,.61,.36,1); }
  .vmore:hover i { width: 56px; }

  .vpicks-h { font-size: 1.7rem; color: var(--bone); margin-bottom: 10px; }
  .vpicks-p { color: var(--muted); max-width: 620px; margin: 0 0 34px; line-height: 1.8; }

  @media(max-width:820px){
    .vv-facts { grid-template-columns: repeat(2, 1fr); gap: 18px 20px; }
  }
  @media(max-width:680px){
    .vverdict { padding: 26px 20px; }
    .vnote { padding: 16px 18px 16px 17px; }
    .vgrid { gap: 38px; }
  }
</style>
