---
// /visa.html — the hub for entry requirements by nationality.
//
// Two jobs. For a visitor: find your passport, get the answer in one line, go
// deeper if you need to. For crawlers: a single page that links every
// nationality page, so the whole set is one click from a top-level URL.
//
// The filter is progressive enhancement — every row is in the HTML and stays
// readable with JavaScript off.
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import LeadCapture from "@/components/conversion/LeadCapture.astro";
import {
  nationalities, REGION_ORDER, ROUTE_LABEL, VERIFIED_ON, OFFICIAL_PORTAL,
  VISA_FEE_USD, VISA_FEE_MULTI_USD, VISA_STAY_DAYS, GCC_STAY_DAYS, SINAI_PERMIT_DAYS,
} from "@/data/entryRequirements";
import { canonical } from "@/utils/links";
import { site, SITE_URL } from "@/config/site";
import { breadcrumb } from "@/schemas/jsonld";

const ROUTE = "visa.html";

const verified = new Date(VERIFIED_ON).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric",
});

const byRegion = REGION_ORDER
  .map((region) => ({
    region,
    items: nationalities
      .filter((n) => n.region === region)
      .sort((a, b) => a.country.localeCompare(b.country)),
  }))
  .filter((g) => g.items.length);

const faqs = [
  {
    q: "How much is an Egypt tourist visa in 2026?",
    a: `US$${VISA_FEE_USD} for a single entry, whether you buy it on arrival at the airport or apply online for the e-Visa. The multiple-entry e-Visa is US$${VISA_FEE_MULTI_USD}. The single-entry fee rose from US$25 on 1 March 2026. Visa counters at the airport take cash in US dollars.`,
  },
  {
    q: "Can I get an Egypt visa on arrival?",
    a: `Most European, North American and Asia-Pacific passports can, including all EU states, the UK, the US, Canada, Australia, New Zealand, Japan and South Korea. You buy it at a bank counter in the arrivals hall before passport control — it takes a few minutes. Some nationalities must apply for the e-Visa in advance instead, so check your own passport above.`,
  },
  {
    q: "How long does the Egypt e-Visa take?",
    a: "Allow at least a week, and longer in peak season or if supporting documents are requested. It is issued by email as a PDF. If your passport is eligible for the visa on arrival, the e-Visa is optional — its only advantage is that you land with the visa already issued.",
  },
  {
    q: "Which nationalities do not need a visa for Egypt?",
    a: `Nationals of the Gulf Cooperation Council states — Saudi Arabia, the UAE, Kuwait, Qatar, Bahrain and Oman — enter without a tourist visa for up to ${GCC_STAY_DAYS} days. Note the distinction between GCC *nationals* and GCC *residents*: a resident travelling on a different passport follows that passport's rule.`,
  },
  {
    q: "What is the Sinai-only entry permit?",
    a: `If your whole trip stays inside Sharm el-Sheikh, Dahab, Nuweiba and Taba, many nationalities can be issued a free ${SINAI_PERMIT_DAYS}-day entry permit at Sinai entry points instead of buying a visa. It does not permit travel to Cairo, Luxor, Aswan or the Egyptian mainland — not even for a day trip. If the Pyramids are anywhere in your plans, buy the ordinary visa.`,
  },
  {
    q: "My nationality is not listed — what do I do?",
    a: `Egypt sets entry rules for well over a hundred passports and they change. We only publish a nationality when we can corroborate its rule, because a wrong answer here costs someone their trip. If yours is not on this page, check the official portal at visa2egypt.gov.eg, or write to us — if you are travelling with Kemet we will confirm your exact requirement before anything is booked.`,
  },
  {
    q: "How long can I stay in Egypt as a tourist?",
    a: `A single-entry tourist visa permits up to ${VISA_STAY_DAYS} days. Visa-exempt GCC nationals are admitted for up to ${GCC_STAY_DAYS} days. Extensions are handled inside Egypt by the passport authorities and take time, so plan around the limit rather than assuming you can extend.`,
  },
];

const jsonld: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Egypt Visa Requirements by Nationality",
    description:
      "Egypt entry requirements for every listed nationality — visa on arrival, e-Visa or visa-free, with fees, permitted stay and documents.",
    url: canonical(ROUTE),
    inLanguage: "en",
    dateModified: VERIFIED_ON,
    about: { "@type": "Country", name: "Egypt" },
    isPartOf: { "@type": "WebSite", name: `${site.name} — The Black Land`, url: SITE_URL },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: nationalities.length,
      itemListElement: nationalities.map((n, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `Egypt visa for ${n.demonym}`,
        url: canonical(`visa/${n.slug}.html`),
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question", name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  breadcrumb([["Home", "index.html"], ["Egypt Visa by Nationality", ROUTE]]),
];
---
<Base
  title="Egypt Visa Requirements by Nationality (2026) | Kemet"
  description={`Egypt entry rules for ${nationalities.length} nationalities — visa on arrival, e-Visa or visa-free, with the US$${VISA_FEE_USD} fee, permitted stay and documents. Checked ${verified}.`}
  active={ROUTE}
  jsonld={jsonld}
  keywords="egypt visa requirements, egypt visa on arrival, egypt e-visa, do i need a visa for egypt, egypt entry requirements, egypt visa cost 2026, egypt tourist visa"
>
  <PageHero
    crumb="Egypt Visa by Nationality"
    symbol="ankh"
    title="Do you need a visa for Egypt?"
    text={`It depends entirely on your passport. Find yours below for the rule, the cost, the documents and how long you may stay. ${nationalities.length} nationalities, last checked ${verified}.`}
  />

  <section style="padding-top:26px">
    <div class="wrap vx-wrap">

      <div class="vx-summary">
        <div>
          <span class="vx-k">Single-entry visa</span>
          <b>US${VISA_FEE_USD}</b>
          <em>on arrival or e-Visa</em>
        </div>
        <div>
          <span class="vx-k">Maximum stay</span>
          <b>{VISA_STAY_DAYS} days</b>
          <em>single entry</em>
        </div>
        <div>
          <span class="vx-k">Passport validity</span>
          <b>6 months</b>
          <em>beyond arrival</em>
        </div>
        <div>
          <span class="vx-k">Multiple entry</span>
          <b>US${VISA_FEE_MULTI_USD}</b>
          <em>e-Visa only</em>
        </div>
      </div>

      <div class="vx-search">
        <label for="vx-q">Find your passport</label>
        <input id="vx-q" type="search" placeholder="Type a country — e.g. Germany, Japan, Saudi Arabia"
               autocomplete="off" />
        <p class="vx-none" id="vx-none" hidden>
          No match on this page. Egypt sets rules for well over a hundred passports and we only
          publish the ones we can corroborate — check
          <a href={OFFICIAL_PORTAL} rel="nofollow noopener" target="_blank">visa2egypt.gov.eg</a>,
          or <a href="contact.html">ask us</a> and we will confirm yours.
        </p>
      </div>

      {byRegion.map(({ region, items }) => (
        <div class="vx-group" data-group>
          <h2>{region} <em>({items.length})</em></h2>
          <ul class="vx-list">
            {items.map((n) => (
              <li data-name={`${n.country} ${n.demonym}`.toLowerCase()}>
                <a href={`visa/${n.slug}.html`}>
                  <span class="vx-c">{n.country}</span>
                  <span class={`vx-r vx-r-${n.route}`}>{ROUTE_LABEL[n.route]}</span>
                  <span class="vx-d">{n.stayDays} days</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <p class="vx-auth">
        Entry rules are set by the Egyptian government and change without much warning. Everything on
        this page was checked on <strong>{verified}</strong> against public sources — always confirm
        on the official portal at{" "}
        <a href={OFFICIAL_PORTAL} rel="nofollow noopener" target="_blank">visa2egypt.gov.eg</a>{" "}
        before booking flights. If you travel with us, we confirm your exact requirement in writing
        before anything is paid for.
      </p>

      <Frieze />

      <Faq items={faqs} heading="Egypt visa questions" />
    </div>
  </section>

  <LeadCapture
    variant="planning"
    heading="Not sure which rule applies to you?"
    subtext="Tell us your nationality and your dates. We will confirm exactly what you need before anything is booked — and build the journey around it."
    whatsappMessage="Hello Kemet — I'd like to check the Egypt visa requirement for my nationality and plan a trip."
    emailSubject="Egypt visa question — Kemet"
  />
</Base>

<script is:inline>
  (function () {
    var q = document.getElementById("vx-q");
    if (!q) return;
    var rows = [].slice.call(document.querySelectorAll(".vx-list li"));
    var groups = [].slice.call(document.querySelectorAll("[data-group]"));
    var none = document.getElementById("vx-none");
    q.addEventListener("input", function () {
      var t = q.value.trim().toLowerCase();
      var hits = 0;
      rows.forEach(function (r) {
        var on = !t || r.getAttribute("data-name").indexOf(t) !== -1;
        r.hidden = !on;
        if (on) hits++;
      });
      groups.forEach(function (g) {
        g.hidden = !g.querySelector(".vx-list li:not([hidden])");
      });
      if (none) none.hidden = !(t && hits === 0);
    });
  })();
</script>

<style>
  .vx-wrap { max-width: 940px; }

  .vx-summary {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: 2px;
    overflow: hidden; margin-bottom: 42px;
  }
  .vx-summary > div { background: var(--ink-2); padding: 22px 20px; text-align: center; }
  .vx-k { display: block; font-size: .62rem; letter-spacing: .26em; text-transform: uppercase;
    color: var(--muted-2); margin-bottom: 8px; }
  .vx-summary b { display: block; font-family: var(--ff-display); font-weight: 400;
    font-size: 1.7rem; line-height: 1; color: var(--gold-bright); }
  .vx-summary em { display: block; font-style: normal; margin-top: 7px;
    font-size: .8rem; color: var(--muted-2); }

  .vx-search { margin-bottom: 34px; }
  .vx-search label { display: block; font-size: .66rem; letter-spacing: .3em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .vx-search input {
    width: 100%; background: rgba(10,8,5,.5); border: 1px solid var(--line-2);
    border-radius: 2px; color: var(--bone); font-family: var(--ff-body); font-weight: 300;
    font-size: 1rem; padding: 15px 18px; transition: border-color .3s;
  }
  .vx-search input:focus { outline: none; border-color: var(--gold); }
  .vx-search input::placeholder { color: var(--muted-2); }
  .vx-none { margin: 14px 0 0; color: var(--muted); font-size: .92rem; line-height: 1.7; }
  .vx-none a { color: var(--gold); border-bottom: 1px solid var(--line-2); }

  .vx-group { margin-bottom: 40px; }
  .vx-group h2 { font-size: 1.3rem; color: var(--bone); margin-bottom: 4px; }
  .vx-group h2 em { font-style: normal; font-size: .78rem; color: var(--muted-2);
    letter-spacing: .1em; }
  .vx-list { list-style: none; margin: 14px 0 0; padding: 0; }
  .vx-list li { border-bottom: 1px solid var(--line); }
  .vx-list li:last-child { border-bottom: 0; }
  .vx-list a {
    display: grid; grid-template-columns: 1fr auto auto; gap: 18px; align-items: center;
    padding: 14px 4px; transition: background .3s, padding-left .3s;
  }
  .vx-list a:hover { background: rgba(217,180,90,.05); padding-left: 12px; }
  .vx-c { color: var(--bone); font-size: 1rem; }
  .vx-list a:hover .vx-c { color: var(--gold-bright); }
  .vx-r { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 20px; border: 1px solid var(--line-2); white-space: nowrap; }
  .vx-r-visa-free { color: #9CCBA2; border-color: rgba(156,203,162,.42); }
  .vx-r-visa-on-arrival { color: var(--gold); }
  .vx-r-e-visa { color: #E3B98C; border-color: rgba(227,185,140,.42); }
  .vx-d { color: var(--muted-2); font-size: .84rem; white-space: nowrap; min-width: 62px;
    text-align: right; }

  .vx-auth { margin: 10px 0 0; padding: 20px 22px; border-left: 2px solid var(--gold);
    background: rgba(217,180,90,.05); color: var(--muted); font-size: .9rem; line-height: 1.75; }
  .vx-auth a { color: var(--gold); border-bottom: 1px solid var(--line-2); }

  @media(max-width:820px){
    .vx-summary { grid-template-columns: repeat(2, 1fr); }
  }
  @media(max-width:680px){
    .vx-summary { margin-bottom: 34px; }
    .vx-summary > div { padding: 18px 14px; }
    .vx-summary b { font-size: 1.45rem; }
    .vx-list a { grid-template-columns: 1fr auto; gap: 6px 12px; padding: 13px 2px; }
    .vx-r { grid-row: 2; grid-column: 1; justify-self: start; }
    .vx-d { grid-row: 2; grid-column: 2; }
    .vx-auth { padding: 18px 18px 18px 17px; }
  }
</style>
