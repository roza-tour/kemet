---
import type { Tour } from "@/types";
import { formatPrice, priceBasis } from "@/utils/format";
import Placeholder from "@/components/Placeholder.astro";

interface Props {
  tour: Tour;
  /** Link prefix back to the site root ("" at root, "../" in subfolders). */
  base?: string;
}
const { tour, base = "" } = Astro.props;
const href = `${base}${tour.slug}.html`;
const basis = priceBasis(tour, true);
---
<a class="jcard reveal" href={href} data-tilt aria-label={`${tour.title} — view journey`}>
  <div style="position:relative">
    <span class="tag">{tour.tag}</span>
    <Placeholder
      label={tour.title}
      src={tour.hero?.src}
      alt={tour.hero?.alt}
      width={tour.hero?.width}
      height={tour.hero?.height}
    />
  </div>
  <div class="body">
    <h3>{tour.title}</h3>
    <div class="route">{tour.cities.join(" · ")}</div>
    <p>{tour.summary}</p>
    <div class="meta">
      <div class="price">
        {formatPrice(tour.price)}
        {tour.was && <span class="was">{formatPrice(tour.was)}</span>}
        <small>/ person</small>
        {basis && <span class="basis">{basis}</span>}
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  /* Qualifies the headline figure on the card itself, so the basis of the
     price is never something a reader only discovers on the detail page. */
  .price .basis {
    display: block;
    margin-top:var(--s-1);
    font-family: var(--ff-body);
    font-size:var(--t-micro);
    letter-spacing: .08em;
    line-height: 1.5;
    color: var(--muted-2);
    text-transform: none;
  }
</style>
