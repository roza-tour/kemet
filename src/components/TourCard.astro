---
import type { Tour } from "@/types";
import { formatPrice } from "@/utils/format";
import Placeholder from "@/components/Placeholder.astro";
import { ui, UI_DEFAULT, tourTag, placeName, priceBasisShort } from "@/config/ui";
import { tourRouteFor, tourTextFor } from "@/config/tour-i18n";
import type { SiteLocale, TranslatedLocale } from "@/config/i18n";

interface Props {
  tour: Tour;
  /** Link prefix back to the site root ("" at root, "../" in subfolders). */
  base?: string;
  /** The page's language. The card's chip, route and price unit follow it;
   *  the journey's own title does not, because the page it opens is English. */
  locale?: SiteLocale;
}
const { tour, base = "", locale = UI_DEFAULT } = Astro.props;
const t = ui(locale);
// On a localised page the card opens the journey IN THAT LANGUAGE where the
// translation exists, and the English page where it does not — which is the
// honest fallback, and the note under the grid says so.
const localised = locale === UI_DEFAULT
  ? undefined
  : tourRouteFor(tour.slug, locale as TranslatedLocale);
const href = `${base}${localised ?? `${tour.slug}.html`}`;
// Title and summary come from the translation where there is one. A card
// that opened a German page under an English headline was the last English
// left on a German hub.
const text = locale === UI_DEFAULT ? undefined : tourTextFor(tour.slug, locale as TranslatedLocale);
const cardTitle = text?.title ?? tour.title;
const cardSummary = text?.summary ?? tour.summary;
const basis = priceBasisShort(tour, t);
const chip = tourTag(tour.tag, t);
const route = tour.cities.map((c) => placeName(c, t)).join(" · ");
---
<a class="jcard reveal" href={href} data-tilt aria-label={cardTitle}>
  <div style="position:relative">
    <span class="tag">{chip}</span>
    <Placeholder
      sizes="card"
      label={cardTitle}
      src={tour.hero?.src}
      alt={tour.hero?.alt}
      width={tour.hero?.width}
      height={tour.hero?.height}
    />
  </div>
  <div class="body">
    <h3>{cardTitle}</h3>
    <div class="route">{route}</div>
    <p>{cardSummary}</p>
    <div class="meta">
      <div class="price">
        {formatPrice(tour.price)}
        {tour.was && <span class="was">{formatPrice(tour.was)}</span>}
        <small>{t.perPerson}</small>
        {basis && <span class="basis">{basis}</span>}
      </div>
      <span class="arrow" aria-hidden="true">→</span>
    </div>
  </div>
</a>

