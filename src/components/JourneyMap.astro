---
// JourneyMap — design your journey on a map of Egypt.
//
// The visitor taps the places they want, sets the nights for each, and sends
// the route on WhatsApp or by email. The words, the stops and the outline are
// in config/journey-map.ts; the behaviour is scripts/journey-map.client.js.
//
// WHAT IS DRAWN HERE, AND WHAT THE SCRIPT ADDS
// The map, the stops and the catalogue journeys are all in the HTML, so the
// page reads and links without script. The script draws the route, keeps the
// list of chosen stops and writes the message.
//
// NO PRICE FOR THE ROUTE. A route of the visitor's own is quoted in writing.
// The journeys shown beneath it are the catalogue's, with the catalogue's own
// prices (data-eur, so the header's currency choice applies to them too).
import { LOCALE_META } from "@/config/i18n";
import type { SiteLocale, TranslatedLocale } from "@/config/i18n";
import { MAP_STOPS, MAP_WORDS, EGYPT_OUTLINE, NILE, NILE_ROSETTA, NILE_DAMIETTA } from "@/config/journey-map";
import { multidayTours } from "@/data/tours";
import { tourRouteFor, tourTextFor } from "@/config/tour-i18n";
import { publicPath } from "@/utils/links";
import { formatPriceIn } from "@/utils/format";
import { site } from "@/config/site";

interface Props {
  locale?: SiteLocale;
  /** Link prefix back to the site root ("" at root, "../" in a language folder). */
  base?: string;
  /** Heading level for the section title: an h1 on its own page, an h2 inside another. */
  level?: "h1" | "h2";
}
const { locale = "en", base = "", level = "h2" } = Astro.props;
const w = MAP_WORDS[locale] ?? MAP_WORDS.en;
const H = level;
const Sub = level === "h1" ? "h2" : "h3";

// Equirectangular, narrowed by the cosine of Egypt's middle latitude.
const W = 680, HGT = 616;
const P = ([lon, lat]: [number, number] | number[]): [number, number] =>
  [Math.round((lon - 24.4) * 53.4 * 10) / 10, Math.round((31.95 - lat) * 60 * 10) / 10];
const line = (pts: Array<[number, number]>) => pts.map(P).map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join(" ");
const land = `${line(EGYPT_OUTLINE)} Z`;

const stops = MAP_STOPS.map((s) => {
  const [x, y] = P([s.lon, s.lat]);
  return { ...s, x, y, name: w.stops[s.key] };
});

// The catalogue's multi-day journeys, each with the stops it covers.
const journeys = multidayTours.map((t) => {
  const keys = MAP_STOPS.filter((s) => s.cities.some((c) => t.cities.includes(c))).map((s) => s.key);
  const text = locale === "en" ? undefined : tourTextFor(t.slug, locale as TranslatedLocale);
  const route = locale === "en" ? `${t.slug}.html` : tourRouteFor(t.slug, locale as TranslatedLocale) ?? `${t.slug}.html`;
  return {
    href: `${base}${publicPath(route)}`,
    title: text?.title ?? t.title,
    duration: text?.durationLabel ?? t.durationLabel,
    price: t.price,
    keys: keys.join(" "),
  };
}).filter((j) => j.keys);

const data = JSON.stringify({
  wa: site.whatsapp, mail: site.email, lang: locale,
  nights: w.nights, dayVisit: w.dayVisit, remove: w.remove, more: w.moreNight, fewer: w.fewerNight,
  hello: w.hello, total: w.total, cruise: w.cruise, subject: w.subject,
});
---
<section class="jmap" data-jmap={data}>
  <div class="wrap">
    <div class="jmap-head reveal">
      <div class="eyebrow">{w.eyebrow}</div>
      <H class="jmap-title">{w.heading}</H>
      <div class="rule"></div>
      <p>{w.intro}</p>
    </div>

    <div class="jmap-grid">
      <div class="jmap-map reveal">
        <svg viewBox={`0 0 ${W} ${HGT}`} role="group" aria-label={w.mapLabel} direction="ltr">
          <defs>
            <linearGradient id="jm-land" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2B2114" /><stop offset="1" stop-color="#17110A" />
            </linearGradient>
            <linearGradient id="jm-gold" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#F7E6AE" /><stop offset="1" stop-color="#B8955A" />
            </linearGradient>
          </defs>
          <text class="jm-sea" x="196" y="30" text-anchor="middle" lang={LOCALE_META[locale].tag}>{w.med}</text>
          <text class="jm-sea" x="596" y="330" text-anchor="middle" transform="rotate(62 596 330)" lang={LOCALE_META[locale].tag}>{w.red}</text>
          <g class="jm-compass" transform="translate(628 62)" aria-hidden="true">
            <circle r="20" /><path d="M0 -26 L5 0 L0 26 L-5 0 Z" /><path d="M-26 0 L0 -4 L26 0 L0 4 Z" /><text y="-31" text-anchor="middle">N</text>
          </g>
          <path class="jm-land" d={land} />
          <path class="jm-nile" d={line(NILE)} />
          <path class="jm-nile" d={line(NILE_ROSETTA)} />
          <path class="jm-nile" d={line(NILE_DAMIETTA)} />
          <path class="jm-route" d="" />
          {stops.map((s) => (
            <g class="jm-stop" data-stop={s.key} data-x={s.x} data-y={s.y} data-nights={s.nights} data-name={s.name}
               role="button" tabindex="0" aria-pressed="false" aria-label={s.name} transform={`translate(${s.x} ${s.y})`}>
              <circle class="jm-hit" r="22" />
              <circle class="jm-halo" r="13" />
              <circle class="jm-dot" r="7.5" />
              <text class="jm-num" y="4" text-anchor="middle"></text>
              <text class="jm-name" x={s.side === "left" ? -15 : 15} y="5" text-anchor={s.side === "left" ? "end" : "start"} lang={LOCALE_META[locale].tag}>{s.name}</text>
            </g>
          ))}
        </svg>
      </div>

      <div class="jmap-panel reveal">
        <Sub class="jmap-sub">{w.yourRoute}</Sub>
        <p class="jmap-empty">{w.empty}</p>
        <ol class="jmap-list" hidden></ol>
        <label class="jmap-cruise" hidden><input type="checkbox" /><span>{w.cruise}</span></label>
        <p class="jmap-total" hidden><span>{w.total}</span><b></b></p>
        <div class="jmap-send" hidden>
          <a class="jmap-wa" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">{w.wa}</a>
          <a class="jmap-mail" href={`mailto:${site.email}`}>{w.mail}</a>
        </div>
        <p class="jmap-note">{w.note}</p>
        <button type="button" class="jmap-clear" hidden>{w.clear}</button>
      </div>
    </div>

    <div class="jmap-near">
      <Sub class="jmap-sub">{w.closest}</Sub>
      <ul>
        {journeys.map((j) => (
          <li data-keys={j.keys}>
            <a href={j.href}>
              <b>{j.title}</b>
              <span>{j.duration}</span>
              <em><i>{w.from}</i> <span data-eur={j.price}>{formatPriceIn(j.price, LOCALE_META[locale]?.formatLocale)}</span></em>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>import "../scripts/journey-map.client.js";</script>

<style is:global>
  .jmap-head { margin-bottom: var(--s-6); max-width: 720px; }
  .jmap-title { font-family: var(--ff-display); font-weight: 300; font-size: clamp(2rem, 4.4vw, 3.2rem); line-height: 1.12;
    color: var(--bone); margin-top: var(--s-3); }
  .jmap-head p { color: var(--muted); line-height: 1.85; margin: var(--s-4) 0 0; }
  .jmap-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: start; }

  .jmap-map { position: relative; border: 1px solid rgba(217,180,90,.28); padding: 18px;
    background: radial-gradient(120% 90% at 60% 30%, rgba(40,58,66,.5), rgba(11,14,17,.9) 70%);
    box-shadow: inset 0 0 0 4px #0B0907, inset 0 0 0 5px rgba(217,180,90,.14); }
  .jmap-map svg { display: block; width: 100%; height: auto; overflow: visible; }
  .jm-land { fill: url(#jm-land); stroke: rgba(217,180,90,.55); stroke-width: 1.2; stroke-linejoin: round; }
  .jm-nile { fill: none; stroke: #7FB4C9; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: .75; }
  .jm-route { fill: none; stroke: url(#jm-gold); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 2 7; filter: drop-shadow(0 0 5px rgba(217,180,90,.55)); }
  .jm-stop { cursor: pointer; outline: none; }
  .jm-hit { fill: transparent; }
  .jm-halo { fill: none; stroke: rgba(217,180,90,.35); stroke-width: 1; transition: r .3s, stroke .3s; }
  .jm-dot { fill: #17110A; stroke: #E9CF85; stroke-width: 1.6; transition: fill .3s, r .3s; }
  .jm-sea { fill: rgba(190,214,224,.5); font-family: var(--ff-display); font-style: italic; font-size: 15px; letter-spacing: .12em; }
  [lang="ar"] .jm-sea { letter-spacing: 0; font-style: normal; }
  .jm-compass circle { fill: none; stroke: rgba(217,180,90,.35); stroke-width: 1; }
  .jm-compass path { fill: rgba(217,180,90,.5); }
  .jm-compass path:first-of-type { fill: #E9CF85; }
  .jm-compass text { fill: var(--gold); font-family: var(--ff-body); font-size: 11px; letter-spacing: .1em; }
  .jm-name { fill: var(--bone); font-family: var(--ff-body); font-size: 17px; paint-order: stroke; stroke: rgba(11,9,7,.85); stroke-width: 4px; stroke-linejoin: round; }
  .jm-num { fill: #1A140C; font-family: var(--ff-body); font-size: 11px; font-weight: 600; pointer-events: none; }
  .jm-stop:hover .jm-halo, .jm-stop:focus-visible .jm-halo { stroke: #F7E6AE; r: 16px; }
  .jm-stop[aria-pressed="true"] .jm-dot { fill: url(#jm-gold); r: 10px; }
  .jm-stop[aria-pressed="true"] .jm-halo { stroke: rgba(247,230,174,.8); r: 16px; }
  .jm-stop[aria-pressed="true"] .jm-name { fill: var(--gold-bright); }
  @media (prefers-reduced-motion: no-preference) {
    .jm-route { animation: jm-flow 1.4s linear infinite; }
    @keyframes jm-flow { to { stroke-dashoffset: -18; } }
    .jm-stop:not([aria-pressed="true"]) .jm-halo { animation: jm-pulse 3.2s ease-in-out infinite; }
    @keyframes jm-pulse { 50% { stroke-opacity: .2; } }
  }

  .jmap-panel { position: sticky; top: 110px; border: 1px solid var(--line); padding: var(--s-5);
    background: linear-gradient(165deg, rgba(30,25,18,.85), rgba(14,17,21,.6)); }
  .jmap-sub { font-family: var(--ff-display); font-weight: 300; font-size: 1.5rem; color: var(--gold-bright); margin: 0 0 var(--s-3); }
  .jmap-empty { color: var(--muted); margin: 0 0 var(--s-4); line-height: 1.7; }
  .jmap-list { list-style: none; margin: 0 0 var(--s-3); padding: 0; }
  .jmap-list[hidden], .jmap-cruise[hidden], .jmap-total[hidden], .jmap-send[hidden], .jmap-clear[hidden] { display: none; }
  .jmap-list li { display: grid; grid-template-columns: 26px 1fr auto auto; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(217,180,90,.16); }
  .jmap-list .n { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg, #F7E6AE, #B8955A);
    color: #1A140C; font-size: 12px; font-weight: 600; }
  .jmap-list .nm { color: var(--bone); font-size: var(--t-base); line-height: 1.3; }
  .jmap-list .nm small { display: block; color: var(--muted-2); font-size: var(--t-nano); letter-spacing: .14em; text-transform: uppercase; margin-top: 2px; }
  .jmap-step { display: flex; align-items: center; gap: 2px; }
  .jmap-step button, .jmap-list .rm { width: 30px; height: 30px; border: 1px solid rgba(217,180,90,.4); background: none; color: var(--gold-bright); cursor: pointer;
    font-size: 1.05rem; line-height: 1; }
  .jmap-step button:hover, .jmap-list .rm:hover { background: rgba(217,180,90,.14); }
  .jmap-step b { min-width: 28px; text-align: center; color: var(--bone); font-weight: 400; font-family: var(--ff-display); font-size: 1.15rem; }
  .jmap-list .rm { border-color: transparent; color: var(--muted-2); }
  .jmap-cruise { display: flex; gap: 10px; align-items: center; margin: var(--s-3) 0; color: var(--muted); font-size: var(--t-sm); cursor: pointer; }
  .jmap-cruise input { width: 18px; height: 18px; accent-color: #D9B45A; flex: none; }
  .jmap-total { display: flex; justify-content: space-between; align-items: baseline; margin: var(--s-3) 0 var(--s-4); }
  .jmap-total span { font-size: var(--t-nano); letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
  .jmap-total b { font-family: var(--ff-display); font-weight: 300; font-size: 1.8rem; color: var(--bone); }
  .jmap-send { display: grid; gap: 10px; }
  .jmap-wa, .jmap-mail { --cut: 8px; position: relative; isolation: isolate; display: flex; align-items: center; justify-content: center; min-height: 50px; padding: 8px 12px;
    text-align: center; text-decoration: none; font-size: var(--t-micro); letter-spacing: .14em; text-transform: uppercase; color: var(--bone); }
  .jmap-wa { color: #1A140C; font-weight: 500; }
  .jmap-wa::before, .jmap-wa::after, .jmap-mail::before, .jmap-mail::after { content: ""; position: absolute; pointer-events: none;
    clip-path: polygon(var(--cut) 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, var(--cut) 100%, 0 calc(100% - var(--cut)), 0 var(--cut)); }
  .jmap-wa::before, .jmap-mail::before { inset: 0; z-index: -2; background: linear-gradient(180deg, #F7E6AE, #B8955A); }
  .jmap-wa::after { inset: 2px; z-index: -1; background: linear-gradient(115deg, #A8862F 0%, #E9CF85 30%, #F7E6AE 45%, #D9B45A 62%, #9C7A2E 100%); }
  .jmap-mail::after { inset: 1px; z-index: -1; background: linear-gradient(180deg, #241B11, #120E08); }
  .jmap-wa:hover::after { filter: brightness(1.1); }
  .jmap-note { margin: var(--s-3) 0 0; color: var(--muted-2); font-size: var(--t-tiny); line-height: 1.65; }
  .jmap-clear { margin-top: var(--s-3); border: 0; background: none; padding: 4px 0; cursor: pointer; color: var(--gold);
    font-size: var(--t-nano); letter-spacing: .18em; text-transform: uppercase; }
  [lang="ar"] .jmap-wa, [lang="ar"] .jmap-mail, [lang="ar"] .jmap-clear, [lang="ar"] .jmap-total span, [lang="ar"] .jmap-list .nm small { letter-spacing: 0; }

  .jmap-near { margin-top: var(--s-7); }
  .jmap-near ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); }
  .jmap-near li { display: none; }
  .jmap-near li.is-near { display: block; }
  /* Without script every journey is listed. */
  .jmap:not(.is-live) .jmap-near li { display: block; }
  .jmap-near a { display: grid; gap: 6px; height: 100%; padding: var(--s-4); border: 1px solid var(--line); text-decoration: none;
    background: linear-gradient(165deg, rgba(30,25,18,.85), rgba(14,17,21,.6)); transition: border-color .3s, transform .3s; }
  .jmap-near a:hover { border-color: rgba(217,180,90,.6); transform: translateY(-2px); }
  .jmap-near b { font-family: var(--ff-display); font-weight: 300; font-size: 1.25rem; color: var(--bone); line-height: 1.25; }
  .jmap-near a > span { font-size: var(--t-nano); letter-spacing: .18em; text-transform: uppercase; color: var(--gold); }
  .jmap-near em { font-style: normal; color: var(--gold-bright); font-size: var(--t-md); margin-top: auto; }
  .jmap-near em i { font-style: normal; color: var(--muted-2); font-size: var(--t-tiny); }
  .jmap-near em small.fx { display: block; color: var(--muted-2); font-size: var(--t-tiny); }

  @media (max-width: 960px) {
    .jmap-grid { grid-template-columns: 1fr; gap: var(--s-5); }
    .jmap-panel { position: static; }
    .jmap-near ul { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .jmap-map { padding: 8px; margin-inline: -8px; }
    .jm-name { font-size: 21px; }
    .jm-sea { font-size: 18px; }
    .jm-dot { r: 9px; }
    .jmap-panel { padding: var(--s-4) var(--s-3); }
  }
</style>
