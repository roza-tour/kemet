---
// SeasonalSkin — the site's automatic seasonal dressing.
//
// Reads the dated calendar in src/data/seasonalCalendar.ts, finds the window
// that contains the visitor's current date, and applies that occasion's identity
// site-wide: an accent shift, a slim ribbon under the nav announcing the season,
// and a matching ornament in the ribbon.
//
// It runs in the browser (not at build time) so a page built today still shows
// the right season months from now without rebuilding. Without JS nothing is
// shown — the ribbon is hidden by default and only revealed when a window
// matches, so no visitor ever sees a wrong or empty season.
import { seasonalCalendar } from "@/data/seasonalCalendar";

// Serialised to the client as compact rows: [theme, slug, label, note, start, end, priority, eventDate]
const rows = seasonalCalendar.map((w) => [
  w.theme, w.slug, w.label, w.note, w.start, w.end, w.priority, w.eventDate ?? "",
]);
---
<div id="season-ribbon" class="srb" hidden>
  <a class="srb-in" href="#" id="srb-link">
    <span class="smark srb-mark" aria-hidden="true"></span>
    <span class="srb-text">
      <b id="srb-label"></b>
      <span id="srb-note"></span>
    </span>
    <span class="srb-cta">Explore <i aria-hidden="true"></i></span>
  </a>
  <button type="button" class="srb-close" id="srb-close" aria-label="Dismiss seasonal notice">×</button>
</div>

<script is:inline define:vars={{ rows }}>
  (function () {
    try {
      var today = new Date();
      var iso = today.getFullYear() + "-" +
                String(today.getMonth() + 1).padStart(2, "0") + "-" +
                String(today.getDate()).padStart(2, "0");

      // Highest-priority window containing today.
      var active = null;
      for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        if (iso >= r[4] && iso <= r[5]) {
          if (!active || r[6] > active[6]) active = r;
        }
      }
      if (!active) return;

      var theme = active[0], slug = active[1], label = active[2], note = active[3], when = active[7];

      // 1) Site-wide accent: everything reads through these custom properties.
      document.documentElement.setAttribute("data-season", theme);

      var depth = (location.pathname.match(/\//g) || []).length - 1;
      var href = (depth > 0 ? "../".repeat(depth) : "") + "collections/" + slug + ".html";

      // 2) The chip in the nav bar — ALWAYS, before any storage is consulted.
      //
      // This is the part that was missing. The ribbon is dismissible, and once
      // dismissed nothing on the site said which season was running, so "the
      // seasonal system is gone" and "I closed the ribbon once" looked exactly
      // the same from the outside. The chip is not dismissible and reads no
      // storage: if a window is active, the season is named in the bar on every
      // page. Whether the system is working is now a glance, not an audit.
      var chip = document.getElementById("season-chip");
      if (chip) {
        chip.setAttribute("href", href);
        document.getElementById("schip-label").textContent = label;
        chip.hidden = false;
      }

      // 3) The ribbon — unless this visitor dismissed it in this session.
      //
      // Dismissal was permanent for the whole window (five months, for the Red
      // Sea), then a seven-day snooze. Both outlived the act of checking
      // whether the ribbon worked, and both were reported as the feature being
      // broken. It is now sessionStorage: closing it clears the bar for as long
      // as the tab is open and no longer. A dismissal should never be able to
      // survive longer than the visit it was made in. Legacy localStorage keys
      // from either older rule are cleared on sight.
      var key = "kemet-season-" + slug + "-" + active[4];
      try { localStorage.removeItem(key); } catch (e) {}
      try { if (sessionStorage.getItem(key)) return; } catch (e) {}

      var root = document.getElementById("season-ribbon");
      if (!root) return;
      document.getElementById("srb-link").setAttribute("href", href);
      document.getElementById("srb-label").textContent = when ? label + " · " + when : label;
      document.getElementById("srb-note").textContent = note;
      root.hidden = false;

      var close = document.getElementById("srb-close");
      if (close) close.addEventListener("click", function () {
        root.hidden = true;
        try { sessionStorage.setItem(key, "1"); } catch (e) {}
      });
    } catch (e) {
      /* never let the seasonal layer break the page */
    }
  })();
</script>

<style is:global>
  /* ===== Site-wide accent per season =====================================
     Every component already reads --gold / --gold-bright / --line, so shifting
     these four values re-tints the whole site with no component changes.

     --srb is the season's own colour. It is deliberately NOT --gold: the brand
     is gold all year, and the season is a light laid over it. --srb-bg is the
     bar the ribbon and the chip sit on, tinted so the season is legible even
     where the accent is close to the house gold. */
  :root[data-season="ramadan"]      { --gold:#E0BE6A; --gold-bright:#FBEFC4; --gold-deep:#9C7A2E; --line-2:rgba(224,190,106,.44); --srb:#3E9E80; --srb-bg:14,26,22; }
  :root[data-season="christmas"]    { --gold:#E3C579; --gold-bright:#FFF6DA; --gold-deep:#A8823A; --line-2:rgba(227,197,121,.46); --srb:#3E9E80; --srb-bg:12,24,21; }
  :root[data-season="sun-festival"] { --gold:#E8A33D; --gold-bright:#FBE2A6; --gold-deep:#A9631C; --line-2:rgba(232,163,61,.46); --srb:#E0912F; --srb-bg:30,18,8; }
  :root[data-season="spring"]       { --gold:#DCC06B; --gold-bright:#FBF3D2; --gold-deep:#9C8438; --line-2:rgba(220,192,107,.44); --srb:#8FC496; --srb-bg:14,26,17; }
  /* Red Sea runs May–September — five months. Repainting --gold teal turned
     the entire brand mint for nearly half the year: logo glow, buttons, rules,
     the nav CTA. But the correction went too far the other way — gold moved to
     #D6C588, four points off the house #D9B45A, which nobody can see. The gold
     stays close to the brand; the sea now lives in the layer built for it, at
     a strength that can actually be perceived. */
  :root[data-season="red-sea"]      { --gold:#D6C588; --gold-bright:#F2EDD2; --gold-deep:#8E8244; --line-2:rgba(214,197,136,.44); --srb:#48C5C0; --srb-bg:6,28,32; }
  :root[data-season="honeymoon"]    { --gold:#E3B98C; --gold-bright:#FBE7D6; --gold-deep:#A9764B; --line-2:rgba(227,185,140,.46); --srb:#D89C7E; --srb-bg:30,18,15; }
  :root[data-season="eid"]          { --gold:#E0BE6A; --gold-bright:#FBEFC4; --gold-deep:#9C7A2E; --line-2:rgba(224,190,106,.44); --srb:#3E9E80; --srb-bg:14,26,22; }

  /* ===== The chip in the nav bar =========================================
     Small, permanent, and the single place a visitor — or the person who owns
     the site — can confirm at a glance that a season is running. */
  .schip { display: inline-flex; align-items: center; gap: 9px; flex: none;
    margin-left: 18px; padding: 7px 14px 7px 11px; border-radius: 999px;
    /* Plain fallback first: color-mix is unsupported before Safari 16.2, and a
       chip with no border and no background would look like a mistake. */
    border: 1px solid var(--line-2); background: rgba(255,255,255,.04);
    border: 1px solid color-mix(in srgb, var(--srb) 40%, transparent);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--srb) 15%, transparent),
      color-mix(in srgb, var(--srb) 7%, transparent));
    text-decoration: none; white-space: nowrap;
    transition: border-color .35s ease, background .35s ease, transform .35s ease; }
  .schip[hidden] { display: none; }
  .schip:hover { border-color: color-mix(in srgb, var(--srb) 72%, transparent);
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--srb) 26%, transparent),
      color-mix(in srgb, var(--srb) 12%, transparent)); }
  .schip-label { font-size: .58rem; letter-spacing: .22em; text-transform: uppercase;
    color: var(--bone); font-weight: 500;
    color: color-mix(in srgb, var(--srb) 62%, #FFF); }
  .schip-mark { width: 13px; height: 13px; }
  /* A slow pulse so the eye finds it once, then leaves it alone. */
  .schip-mark { animation: schip-pulse 3.4s ease-in-out infinite; }
  @keyframes schip-pulse { 0%,100% { opacity: .78; } 50% { opacity: 1; } }
  /* Below the desktop bar the nav is tight and the ribbon already carries the
     season across the full width — the chip would only crowd the logo. */
  @media (max-width: 1180px) { .schip { display: none; } }

  /* ===== The ribbon ===================================================== */
  /* Pinned to the BOTTOM so it never interferes with the hero or the nav. */
  .srb { position: fixed; bottom: 0; left: 0; right: 0; z-index: 115;
    background:
      radial-gradient(600px 90px at 22% 100%, color-mix(in srgb, var(--srb) 22%, transparent), transparent 70%),
      linear-gradient(90deg, rgba(var(--srb-bg, 11,9,7), .97), rgba(var(--srb-bg, 20,16,12), .93));
    border-top: 1px solid color-mix(in srgb, var(--srb) 46%, transparent);
    box-shadow: 0 -10px 30px -18px rgba(0,0,0,.9);
    transform: translateY(100%); animation: srb-in .6s cubic-bezier(.22,.61,.36,1) .8s forwards; }
  /* A hairline of the season's own colour along the top edge — the one line of
     pure season colour on the page, so the bar is never mistaken for chrome. */
  .srb::before { content: ""; position: absolute; top: -1px; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--srb) 22%, var(--srb) 78%, transparent);
    opacity: .85; }
  @keyframes srb-in { to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .srb { animation: none; transform: none; } }
  .srb[hidden] { display: none; }

  /* The floating WhatsApp button sits at bottom-right; with the ribbon shown it
     landed on top of it. Lift it clear while the ribbon is actually visible —
     the moment a visitor dismisses the ribbon it drops back down. */
  html:has(.srb:not([hidden])) .wafab { bottom: max(66px, calc(env(safe-area-inset-bottom) + 62px)); }

  .srb-in { display: flex; align-items: center; gap: 16px; max-width: var(--maxw);
    margin: 0 auto; padding: 11px 104px 11px 28px; }
  .srb-text { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; flex: 1; min-width: 0; }
  .srb-text b { color: var(--gold-bright); font-weight: 500; font-size: .82rem; letter-spacing: .04em; }
  .srb-text span { color: var(--muted-2); font-size: .8rem; }
  .srb-cta { flex: none; display: inline-flex; align-items: center; gap: 10px;
    font-size: .6rem; letter-spacing: .28em; text-transform: uppercase; color: var(--srb, var(--gold)); }
  .srb-cta i { width: 24px; height: 1px; background: currentColor; transition: width .45s cubic-bezier(.22,.61,.36,1); }
  .srb-in:hover .srb-cta i { width: 40px; }
  .srb-close { position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
    background: none; border: 0; color: var(--muted-2); font-size: 1.4rem; line-height: 1;
    cursor: pointer; width: 44px; height: 44px; display: flex; align-items: center;
    justify-content: center; transition: color .3s; }
  .srb-close:hover { color: var(--gold-bright); }

  /* ===== Ornament mark, drawn per season =================================
     One set of rules, worn by both the ribbon and the nav chip — they are the
     same mark at two sizes, so they must never drift apart. Sizing lives on
     .srb-mark / .schip-mark; the drawing lives here on .smark.
     The mark is drawn in the season's own colour, not the brand gold: it is
     the one element that is allowed to say plainly which season this is. */
  .smark { flex: none; position: relative; display: inline-block;
    border-radius: 50%; border: 1px solid var(--srb, var(--gold)); }
  .srb-mark { width: 20px; height: 20px; }
  .smark::after { content: ""; position: absolute; inset: 26%; border-radius: 50%;
    background: var(--srb, var(--gold)); opacity: .55; }

  /* Ramadan — a true crescent, masked out of a solid disc so it reads on any
     background (no colour-matched overlay to keep in sync). */
  :root[data-season="ramadan"] .smark,
  :root[data-season="eid"] .smark {
    border: 0; background: var(--gold-bright);
    -webkit-mask: radial-gradient(circle at 72% 50%, transparent 54%, #000 55%);
    mask: radial-gradient(circle at 72% 50%, transparent 54%, #000 55%);
  }
  :root[data-season="ramadan"] .smark::after,
  :root[data-season="eid"] .smark::after { display: none; }

  /* Christmas — a four-point star. */
  :root[data-season="christmas"] .smark {
    border: 0; background: var(--gold-bright); border-radius: 0;
    clip-path: polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%);
  }
  :root[data-season="christmas"] .smark::after { display: none; }

  /* Sun Festival — a disc with rays. */
  :root[data-season="sun-festival"] .smark {
    border: 0; background: var(--srb); border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(0,0,0,0), 0 0 10px 1px color-mix(in srgb, var(--srb) 70%, transparent);
  }
  :root[data-season="sun-festival"] .smark::after { display: none; }

  /* Spring — a leaf. */
  :root[data-season="spring"] .smark {
    border: 0; background: var(--srb); border-radius: 0 60% 0 60%;
  }
  :root[data-season="spring"] .smark::after { display: none; }

  /* Red Sea — a droplet. */
  :root[data-season="red-sea"] .smark {
    border: 0; background: var(--srb); border-radius: 50% 50% 50% 8%;
    transform: rotate(45deg);
    box-shadow: 0 0 12px -1px color-mix(in srgb, var(--srb) 75%, transparent);
  }
  :root[data-season="red-sea"] .smark::after { display: none; }

  /* Honeymoon — a soft filled disc. */
  :root[data-season="honeymoon"] .smark { border: 0; background: var(--srb); }
  :root[data-season="honeymoon"] .smark::after { display: none; }

  /* Lift the floating WhatsApp button above the ribbon while it is showing. */
  body:has(#season-ribbon:not([hidden])) .wafab { bottom: max(78px, calc(env(safe-area-inset-bottom) + 74px)); }

  @media(max-width:900px){
    .srb-in { padding: 10px 92px 10px 18px; gap: 11px; }
    .srb-cta { display: none; }
    .srb-text span { display: none; }
    .srb-close { right: 62px; }
  }
  /* ===== Seasonal atmosphere on every page hero ==========================
     A soft, pure-CSS motif layered into the hero (.hero on the homepage,
     .phero on inner pages) so the season is felt everywhere, not only on the
     collection page. Gradients only — nothing to load, nothing to maintain. */
  .hero .veil::after, .phero::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    transition: opacity 1.2s ease;
  }
  :root[data-season] .hero .veil::after,
  :root[data-season] .phero::after { opacity: 1; }
  /* Themed collection pages carry their own ornament layer — skip the generic
     atmosphere there so motifs never double up. */
  [class*="themed-"] .phero::after { content: none; }

  /* Ramadan — moonlight high in the sky + a lantern-warm horizon.
     This used to draw a crescent by laying a near-black disc over a pale one.
     That only works on a dark hero: over the daylight sky on the homepage the
     occluding disc read as a grey smudge pasted on the photograph. The hero
     now carries light rather than a shape — a high glow and a warm horizon —
     and the crescent itself is drawn properly, with a mask, in the ribbon and
     chip marks above, where it sits on a known background. */
  :root[data-season="ramadan"] .hero .veil::after,
  :root[data-season="ramadan"] .phero::after {
    background:
      radial-gradient(circle 150px at 84% 92px, rgba(247,230,174,.20), transparent 72%),
      radial-gradient(circle 46px at 84% 92px, rgba(247,230,174,.16), transparent 68%),
      radial-gradient(720px 300px at 50% 100%, rgba(62,158,128,.16), transparent 70%);
  }

  /* Christmas — a sprinkle of still stars + pine-cool depth */
  :root[data-season="christmas"] .hero .veil::after,
  :root[data-season="christmas"] .phero::after {
    background:
      radial-gradient(1.6px 1.6px at 12% 22%, rgba(255,246,218,.9), transparent 60%),
      radial-gradient(1.2px 1.2px at 28% 12%, rgba(255,246,218,.7), transparent 60%),
      radial-gradient(2px 2px at 46% 18%, rgba(255,246,218,.8), transparent 60%),
      radial-gradient(1.3px 1.3px at 64% 9%, rgba(255,246,218,.7), transparent 60%),
      radial-gradient(1.8px 1.8px at 78% 20%, rgba(255,246,218,.85), transparent 60%),
      radial-gradient(1.2px 1.2px at 90% 13%, rgba(255,246,218,.7), transparent 60%),
      radial-gradient(700px 280px at 50% 0%, rgba(47,126,102,.13), transparent 70%);
  }

  /* Sun Festival — dawn rays fanning from the top */
  :root[data-season="sun-festival"] .hero .veil::after,
  :root[data-season="sun-festival"] .phero::after {
    background:
      conic-gradient(from 168deg at 50% -60px,
        transparent 0deg, rgba(232,163,61,.10) 4deg, transparent 8deg,
        transparent 14deg, rgba(232,163,61,.09) 18deg, transparent 22deg,
        transparent 28deg, rgba(232,163,61,.08) 32deg, transparent 36deg),
      radial-gradient(640px 260px at 50% 0%, rgba(232,163,61,.16), transparent 70%);
  }

  /* Spring — a fresh green-gold wash */
  :root[data-season="spring"] .hero .veil::after,
  :root[data-season="spring"] .phero::after {
    background:
      radial-gradient(700px 300px at 20% 0%, rgba(127,176,134,.14), transparent 70%),
      radial-gradient(600px 260px at 80% 10%, rgba(251,243,210,.09), transparent 70%);
  }

  /* Red Sea — caustics: the moving net of light that water throws on
     everything under it. Two repeating gradients at different angles and
     periods, drifting at different speeds, which is what stops it reading as
     wallpaper. The previous version was a flat 16%-alpha wash that nobody
     could see — five months of "seasonal" that looked identical to no season
     at all. Pure CSS: nothing to load, nothing to maintain.

     Two sets of WIDE, FEATHERED bands crossing at a shallow angle. The stops
     are soft on purpose: hard 2px lines look like scratches on the lens, not
     light on water. Where the two sets overlap they brighten, which is the
     lattice a caustic actually makes. Masked to the top of the hero, because
     that is where the light comes from. */
  :root[data-season="red-sea"] .hero .veil::after,
  :root[data-season="red-sea"] .phero::after {
    background:
      repeating-linear-gradient(101deg,
        transparent 0 44px, rgba(140,222,240,.055) 74px, transparent 104px 148px),
      repeating-linear-gradient(63deg,
        transparent 0 62px, rgba(140,222,240,.042) 96px, transparent 130px 196px),
      linear-gradient(180deg, rgba(32,124,140,.28), transparent 54%),
      radial-gradient(820px 340px at 50% 0%, rgba(72,150,178,.22), transparent 74%);
    -webkit-mask: linear-gradient(180deg, #000 30%, transparent 88%);
    mask: linear-gradient(180deg, #000 30%, transparent 88%);
    animation: sea-drift 34s linear infinite;
  }
  /* The drift offsets are not arbitrary. Each layer is shifted along its own
     gradient axis by exactly one period — 148px at 101°, 196px at 63° — so the
     pattern lands back on itself and the loop has no visible restart:
       (sin θ, −cos θ) × period  →  (145.3, 28.2) and (174.6, −88.9)
     The first attempt used background-size to make the loop tile, which put a
     hard 300px grid seam straight across every inner-page hero. A repeating
     gradient does not need tiling; it needs the right offset. */
  @keyframes sea-drift {
    to { background-position: 145.3px 28.2px, 174.6px -88.9px, 0 0, 0 0; }
  }

  /* Eid — festive warmth over the skyline. Same correction as Ramadan: light,
     not a pasted-on shape. */
  :root[data-season="eid"] .hero .veil::after,
  :root[data-season="eid"] .phero::after {
    background:
      radial-gradient(circle 140px at 82% 88px, rgba(247,230,174,.22), transparent 72%),
      radial-gradient(700px 300px at 50% 100%, rgba(62,158,128,.17), transparent 70%);
  }

  /* Honeymoon — rose-gold warmth */
  :root[data-season="honeymoon"] .hero .veil::after,
  :root[data-season="honeymoon"] .phero::after {
    background:
      radial-gradient(700px 300px at 50% 0%, rgba(232,180,160,.20), transparent 70%);
  }

  /* ===== Movement =========================================================
     A still gradient is decoration; a slow one is weather. Each season gets
     the motion that belongs to it — light on water, a lantern breathing,
     stars going in and out — at periods long enough (18-34s) that nobody
     watching the page notices it working, only that the page is alive.
     All of it is opacity or background-position: no layout, no paint storms,
     and every one of them is switched off for prefers-reduced-motion below. */
  :root[data-season="ramadan"] .hero .veil::after,
  :root[data-season="ramadan"] .phero::after,
  :root[data-season="eid"] .hero .veil::after,
  :root[data-season="eid"] .phero::after,
  :root[data-season="honeymoon"] .hero .veil::after,
  :root[data-season="honeymoon"] .phero::after {
    animation: season-breathe 18s ease-in-out infinite;
  }
  :root[data-season="christmas"] .hero .veil::after,
  :root[data-season="christmas"] .phero::after {
    animation: season-twinkle 9s ease-in-out infinite;
  }
  :root[data-season="sun-festival"] .hero .veil::after,
  :root[data-season="sun-festival"] .phero::after {
    animation: season-breathe 14s ease-in-out infinite;
  }
  :root[data-season="spring"] .hero .veil::after,
  :root[data-season="spring"] .phero::after {
    background-size: 300% 300%, 300% 300%;
    animation: season-wander 30s ease-in-out infinite alternate;
  }
  @keyframes season-breathe { 0%,100% { opacity: .74; } 50% { opacity: 1; } }
  @keyframes season-twinkle { 0%,100% { opacity: .55; } 40% { opacity: 1; } 70% { opacity: .72; } }
  @keyframes season-wander  { to { background-position: 100% 40%, 0% 60%; } }

  @media (prefers-reduced-motion: reduce) {
    :root[data-season] .hero .veil::after,
    :root[data-season] .phero::after,
    .schip-mark { animation: none !important; }
  }

  @media print { .srb, .schip { display: none !important; } }
</style>
