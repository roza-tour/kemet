---
import { site } from "@/config/site";
import { whatsappLink, mailtoLink } from "@/utils/links";
import { multidayTours } from "@/data/tours";
import { footerExplore, footerCompany } from "@/config/navigation";
import { tierLine } from "@/data/standard";
import LangSwitch from "@/components/LangSwitch.astro";
import { company, socialLabel } from "@/data/company";
import SocialIcon from "@/components/SocialIcon.astro";
import { localeNav } from "@/config/nav-i18n";
import { ui, UI_DEFAULT } from "@/config/ui";
import type { SiteLocale, TranslatedLocale } from "@/config/i18n";

interface Props {
  /** Link prefix back to the site root ("" at root, "../" in subfolders). */
  base?: string;
  /** Route file of the current page, so the language switcher knows where it is. */
  route?: string;
  /** The page's language. Drives the labels and, off English, the link set. */
  locale?: SiteLocale;
}
const { base = "", route = "index.html", locale = UI_DEFAULT } = Astro.props;
const t = ui(locale);
const isEn = locale === UI_DEFAULT;

// Off English the footer carries the same pages the bar does — the ones that
// exist in this language — rather than fifteen English links under a
// translated heading. The last item of localeNav is the way out to the
// English site, which the footer shows on its own line.
const localeItems = isEn ? [] : localeNav(locale as TranslatedLocale);
const localeLinks = localeItems.flatMap((i) => i.children ?? []);
const englishWayOut = localeItems.find((i) => !i.children);
const enquire = mailtoLink("Kemet enquiry");
const wa = whatsappLink("Hello Kemet — I'd like to plan a journey to Egypt.");

const socials = Object.entries(company.socialProfiles ?? {})
  .filter(([, url]) => typeof url === "string" && /^https:\/\//.test(url))
  .map(([key, url]) => ({
    key,
    label: socialLabel(key),
    url,
  }));
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand" href="/" aria-label="Kemet — Luxury Egypt Travel — home">
          <span class="logo-plaque logo-plaque--lg">
            <img src="/images/brand/kemet-logo-gold.webp" alt="Kemet — Luxury Egypt Travel" width="116" height="112" loading="lazy" decoding="async" />
          </span>
        </a>
        <p>{t.brandBlurb}</p>
        <p class="foot-tier">{isEn ? tierLine : t.tierLine}</p>
      </div>
      {isEn ? (
        <>
          <div class="foot-col">
            <h3>{footerExplore.heading}</h3>
            {footerExplore.links.map(({ href, label }, i) => (
              <Fragment>{i > 0 ? " " : ""}<a href={`${base}${href}`}>{label}</a></Fragment>
            ))}
          </div>
          <div class="foot-col">
            <h3>{t.footJourneys}</h3>
            {multidayTours.slice(0, 6).map((tour) => (
              <a href={`${base}${tour.slug}.html`}>{tour.title}</a>
            ))}
            <a href={`${base}tours.html`}>All 25 journeys</a>
          </div>
          <div class="foot-col">
            <h3>{footerCompany.heading}</h3>
            {footerCompany.links.map(({ href, label }, i) => (
              <Fragment>{i > 0 ? " " : ""}<a href={`${base}${href}`}>{label}</a></Fragment>
            ))}
          </div>
        </>
      ) : (
        <div class="foot-col foot-col--2">
          <h3>{t.footExplore}</h3>
          {localeLinks.map(({ href, label }, i) => (
            <Fragment>{i > 0 ? " " : ""}<a href={`${base}${href}`}>{label}</a></Fragment>
          ))}
          {englishWayOut && (
            <a class="foot-en" href={`${base}${englishWayOut.href}`}>{t.fullSiteEnglish}</a>
          )}
        </div>
      )}
      <div class="foot-col">
        <h3>{t.footContact}</h3>
        <a href={enquire}>{t.enquire}</a>
        <a href={wa} rel="noopener" target="_blank">WhatsApp</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {/* The profiles, VISIBLE.
            These URLs were already going out as schema `sameAs` on every page
            — the machine-readable claim that kemet-travel.com and the profile
            are the same business — but they appeared nowhere a person or a
            crawler could actually follow them. A sameAs nobody can click is a
            one-way assertion; the same URL as a real outbound link, with the
            profile linking back to the site, is a corroborated pair, and that
            is what a search engine is looking for before it merges the two
            into one entity.
            Driven by the same company.socialProfiles the schema reads, so the
            visible links and the structured data can never disagree. */}
        {socials.length > 0 && (
          <div class="foot-social">
            {socials.map(({ key, label, url }) => (
              <a href={url} rel="me noopener" target="_blank">
                <SocialIcon name={key} />
                <span>{label}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
    {/* Renders only on pages that actually have translations, so the English
        originals link out to their localised versions and those pages are never
        orphaned. A link, never a redirect. */}
    <LangSwitch route={route} label="Language (footer)" />

    <div class="foot-bottom">
      <span>{site.copyright}</span>
      <span>{isEn ? "The Land · The Legacy · The Journey" : t.motto}</span>
    </div>
  </div>
  <div class="foot-ghost" aria-hidden="true">KEMET</div>
</footer>
