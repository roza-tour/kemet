---
// CollectionLanding — the campaign run of a collection page: the booking
// window, the journeys with their prices, the enquiry form, and the argument.
//
// It is one component rather than four because the ORDER is the point. A
// landing page is not a collection page with extra blocks; it is the same
// material in the order a buying decision is actually made — what is still
// available, what it costs, how to ask, and only then why. Spreading these
// across four components would let that order drift apart from the reasoning
// behind it.
//
// Nothing here is collection-specific: every string comes from the
// LandingPage data (src/data/landing/*), which is also where every date and
// price is computed. A second campaign is a second data file.
import SectionHeader from "@/components/SectionHeader.astro";
import TourCard from "@/components/TourCard.astro";
import ContactForm from "@/components/conversion/ContactForm.astro";
import { registry } from "@/data/registry";
import { routeFor } from "@/config/routes";
import type { Collection, LandingPage, Tour } from "@/types";

interface Props {
  collection: Collection;
  landing: LandingPage;
  /** Link prefix back to the site root — "../" from inside /collections/. */
  base?: string;
}
const { collection, landing, base = "" } = Astro.props;

const journeys = registry.resolve<Tour>(landing.journeys);
// The page's own route, posted with the form so a visitor whose browser runs
// no JavaScript lands back HERE after sending rather than on the contact page.
const selfRoute = `/${routeFor("seasonal", collection.slug)}`;
---

{/* ---- 1. The fortnight, as four dated moments.
         This is what somebody who has just arrived wants: not an argument,
         just what the holiday consists of. Four dates read in a glance; the
         paragraph behind each one is waiting at the foot of the page. ---- */}
{landing.moments.length > 0 && (
  <section class="lp-rail" aria-label="The festive fortnight, day by day">
    <div class="wrap">
      <ol class="lp-moments">
        {landing.moments.map((m) => (
          <li class="reveal">
            <span class="lp-m-date">{m.date}</span>
            <h2 class="lp-m-title">{m.title}</h2>
            <p>{m.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

{/* ---- 2. The booking window — ONE sentence. Recomputed every build; the
         reasoning behind it is in the detail section below the form. ---- */}
<section class="lp-window" aria-labelledby="lp-window-h">
  <div class="wrap">
    <div class="lp-win-inner reveal">
      <div class="lp-win-text">
        <div class="eyebrow">{landing.window.eyebrow}</div>
        <h2 id="lp-window-h">{landing.window.heading}</h2>
        <p>{landing.window.line}</p>
      </div>
      <a href="#plan" class="btn btn-solid lp-cta">{landing.ctaLabel}</a>
    </div>
  </div>
</section>

{/* ---- 3. The journeys, with their prices. ---- */}
{journeys.length > 0 && (
  <section id="journeys">
    <div class="wrap">
      <SectionHeader
        sym="journeys"
        eyebrow="Journeys"
        title={landing.journeysIntro.heading}
        text={landing.journeysIntro.text}
      />
      <div class="grid-3">
        {journeys.map((tour) => <TourCard tour={tour} base={base} />)}
      </div>
    </div>
  </section>
)}

{/* ---- 4. The form. The CTA target, and the point of the page. ---- */}
<section id="plan" class="lp-plan">
  <div class="wrap">
    <div class="lp-plan-grid">
      <ContactForm
        heading={landing.form.heading}
        subtext={landing.form.subtext}
        returnTo={selfRoute}
        context={landing.h1}
        datesPlaceholder={landing.form.datesPlaceholder}
        messagePlaceholder={landing.form.messagePlaceholder}
      />
      <aside class="lp-assure">
        <div class="pcard reveal">
          <div class="eyebrow" style="margin-bottom:var(--s-2)">What happens next</div>
          <ul class="lp-bullets">
            {landing.assurances.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

{/* ---- 5. The detail: every paragraph the page owes the reader, all of it
         below the form on purpose. Whoever is still here wants the reasons;
         whoever was not is already in the form above. Nothing was cut to get
         the top of the page short — it was moved here. ---- */}
<section class="lp-detail">
  <div class="wrap">
    <SectionHeader
      sym="guides"
      eyebrow="In full"
      title={landing.detailIntro.heading}
      text={landing.detailIntro.text}
    />
    <div class="lp-arg">
      {landing.detail.map((a) => (
        <div class="lp-arg-block reveal">
          <h3>{a.heading}</h3>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ---- 6. The same subject in another language. Plain links, deliberately
         NOT hreflang: these are separate arguments written for their own
         markets, not translations of this page, and an hreflang cluster that
         claims otherwise is worse than none. ---- */}
{landing.otherLanguages && landing.otherLanguages.length > 0 && (
  <section class="lp-langs">
    <div class="wrap">
      <div class="lp-lang-row reveal">
        <span class="eyebrow">Also written for</span>
        {landing.otherLanguages.map((l) => (
          <a href={`${base}${l.route}`} lang={l.lang}>{l.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* The nav is fixed at 86px (70px on a phone), and the site sets no
     scroll-padding, so an anchor jump lands the target UNDER it — the "Plan
     these dates" button scrolled the form's heading behind the header.
     Corrected on this page's own anchor targets rather than globally: a
     site-wide scroll-padding would shift every in-page link on 210 pages. */
  #plan, #journeys { scroll-margin-top: 110px; }
  @media (max-width: 680px) { #plan, #journeys { scroll-margin-top: 90px; } }

  /* --- The dated moments ------------------------------------------------
     A rail rather than four cards: a hairline runs behind the row and each
     date sits on it, so the eye reads them as one fortnight in sequence
     instead of four unrelated boxes. Typographic on purpose — the page is
     already carrying a hero photograph and six photographed journey cards,
     and four more images here would be the same note struck again.
     It also loads instantly, which matters on the one page paying for its
     own traffic. */
  .lp-rail { padding-top: var(--s-5); padding-bottom: var(--s-3); }
  .lp-moments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }
  @media (min-width: 760px) {
    .lp-moments { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
  }
  .lp-moments li {
    position: relative;
    padding-top: var(--s-4);
    border-top: 1px solid var(--line-2);
  }
  /* The marker that sits the date on the rail. */
  .lp-moments li::before {
    content: "";
    position: absolute;
    top: -4px;
    inset-inline-start: 0;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--gold) 18%, transparent);
  }
  .lp-m-date {
    display: block;
    font-size: var(--t-micro);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }
  .lp-m-title {
    font-size: var(--t-lg);
    line-height: 1.25;
    margin: var(--s-2) 0 var(--s-1);
  }
  .lp-moments p { font-size: var(--t-sm); color: var(--muted); margin: 0; }

  /* --- The booking window ------------------------------------------------
     The page's one piece of urgency, and now one sentence of it. The accent
     comes from the collection's own theme (SeasonalTheme sets --gold), so it
     reads as Christmas here and would read correctly on another collection.
     Text and button sit on one line on a desk so the whole notice is about
     the height of a paragraph, not of a page. */
  .lp-window { padding-top: var(--s-4); }
  .lp-win-inner {
    border: 1px solid color-mix(in oklab, var(--gold) 38%, transparent);
    border-inline-start: 3px solid var(--gold);
    border-radius: 2px;
    background: color-mix(in oklab, var(--gold) 5%, transparent);
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  @media (min-width: 900px) {
    .lp-win-inner { flex-direction: row; align-items: center; gap: var(--s-6); }
    .lp-cta { flex: none; }
  }
  .lp-win-text { min-width: 0; }
  .lp-win-inner h2 {
    font-size: var(--t-xl);
    margin: var(--s-1) 0 var(--s-2);
  }
  .lp-win-inner p { margin: 0; max-width: 72ch; }

  /* One shared list style for the assurances. */
  .lp-bullets { list-style: none; margin: var(--s-3) 0 0; padding: 0; }
  .lp-bullets li {
    position: relative;
    padding-inline-start: 1.35em;
    margin-bottom: var(--s-2);
    font-size: var(--t-sm);
    max-width: 72ch;
  }
  .lp-bullets li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: .55em;
    width: .45em; height: .45em;
    border-radius: 50%;
    background: var(--gold);
  }
  .lp-bullets li:last-child { margin-bottom: 0; }

  /* Form and reassurance side by side on a desk, form first on a phone —
     the order in the markup is already the mobile order, so no reordering. */
  .lp-plan-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    align-items: start;
  }
  @media (min-width: 900px) {
    .lp-plan-grid { grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr); }
  }

  .lp-arg {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }
  @media (min-width: 900px) {
    .lp-arg { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); }
  }
  /* h3, not h2: these sit under the section's own heading, and a page where
     every block is an h2 gives a screen reader no shape to navigate by. */
  .lp-arg-block h3 { font-size: var(--t-lg); margin-bottom: var(--s-2); }
  .lp-arg-block p { max-width: 62ch; font-size: var(--t-sm); }

  .lp-langs { padding-top: 0; }
  .lp-lang-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .lp-lang-row .eyebrow { margin: 0; }
  .lp-lang-row a { font-size: var(--t-sm); }
</style>
