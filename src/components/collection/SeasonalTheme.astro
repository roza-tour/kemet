    filter: drop-shadow(0 6px 10px rgba(0,0,0,.35)); }
  .sth-bulb { animation: sth-blink 2.4s ease-in-out infinite; }
  .sth-k0 { animation-delay: 0s; } .sth-k1 { animation-delay: -.8s; } .sth-k2 { animation-delay: -1.6s; }
  @keyframes sth-blink { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
