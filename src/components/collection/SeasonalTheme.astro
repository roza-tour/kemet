)}

{theme === "sun-festival" && (
  <div class="sth sth-sun" aria-hidden="true">
    {/* Radiating solar burst */}
    <svg class="sth-rays" viewBox="0 0 400 200" width="400" height="200" preserveAspectRatio="xMidYMin slice">
      <defs>
        <radialGradient id="sunGlow" cx="50%" cy="0%" r="70%">
          <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".38" />
          <stop offset="55%" stop-color="#D9822B" stop-opacity=".12" />
          <stop offset="100%" stop-color="#D9822B" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="200" fill="url(#sunGlow)" />
      <g stroke="#E8A33D" stroke-width="1" opacity=".3">
        {[...Array(19)].map((_, i) => {
          const a = (Math.PI * i) / 18;
