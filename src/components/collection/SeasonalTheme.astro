---
// SeasonalTheme — gives a collection page its own visual identity: a shifted
// accent palette, a themed ornament band beneath the nav, and a soft background
// motif. All artwork is inline SVG (no external requests, scales cleanly) and
// every animation is disabled under prefers-reduced-motion.
//
// Themes: ramadan (crescents + fanous lanterns, emerald & gold)
//         christmas (stars + evergreen, silver-gold on deep pine)
//         sun-festival (solar burst + falcon disc, amber)
//         easter (Holy Week: crossed palm fronds + lilies, violet & gold)
//         autumn (the date harvest: a palm crown hung with dates, copper)
//         summer (a slow sun over a Mediterranean swell and a felucca, azure)
//         carnival (confetti and streamers, Brazil's green, gold and rose)
//         eclipse (the corona around a black sun, pearl on deep indigo)
//         family (hot-air balloons and a camel caravan, turquoise and sun)
//         sunrise (a photograph of the plateau in low sun, light breathing over it)
//         feast (the food evening: plates of the dishes themselves, steam, spice
//                dust; saffron, tomato and mint on espresso)
import type { SeasonalTheme } from "@/types";
import { creditFor } from "@/data/photoCredits";
import { srcsetFor } from "@/utils/images";

interface Props {
  theme: SeasonalTheme;
}
const { theme } = Astro.props;

/**
 * A palm frond as hairlines: a quadratic stem (p0 → c → p1) with leaflets on
 * both sides, shortening towards the tip. Used by the Holy Week palms and the
 * date-harvest crown.
 */
function frond(p0: [number, number], c: [number, number], p1: [number, number], n = 13, len = 15): string {
  const segs: string[] = [`M${p0[0]} ${p0[1]} Q${c[0]} ${c[1]} ${p1[0]} ${p1[1]}`];
  for (let i = 1; i <= n; i++) {
    const t = i / (n + 1);
    const x = (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * c[0] + t ** 2 * p1[0];
    const y = (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * c[1] + t ** 2 * p1[1];
    let tx = 2 * (1 - t) * (c[0] - p0[0]) + 2 * t * (p1[0] - c[0]);
    let ty = 2 * (1 - t) * (c[1] - p0[1]) + 2 * t * (p1[1] - c[1]);
    const m = Math.hypot(tx, ty) || 1;
    tx /= m; ty /= m;
    const l = len * (1 - t * 0.7);
    for (const side of [1, -1]) {
      const ex = x + (-ty * side * 0.85 + tx * 0.55) * l;
      const ey = y + (tx * side * 0.85 + ty * 0.55) * l;
      segs.push(`M${x.toFixed(1)} ${y.toFixed(1)} L${ex.toFixed(1)} ${ey.toFixed(1)}`);
    }
  }
  return segs.join(" ");
}

/** A lily seen from the side: three petals over a short stem. */
function lily(x: number, y: number): string {
  return [
    `M${x} ${y + 26} V${y + 8}`,
    `M${x} ${y + 8} C${x - 10} ${y + 4} ${x - 15} ${y - 6} ${x - 13} ${y - 12} C${x - 7} ${y - 6} ${x - 2} ${y - 2} ${x} ${y + 8} Z`,
    `M${x} ${y + 8} C${x + 10} ${y + 4} ${x + 15} ${y - 6} ${x + 13} ${y - 12} C${x + 7} ${y - 6} ${x + 2} ${y - 2} ${x} ${y + 8} Z`,
    `M${x} ${y + 8} C${x - 4} ${y - 2} ${x - 3} ${y - 12} ${x} ${y - 17} C${x + 3} ${y - 12} ${x + 4} ${y - 2} ${x} ${y + 8} Z`,
  ].join(" ");
}

/**
 * Points along a row of swags hung between `posts` evenly spaced posts across
 * a 1200-wide band: each swag dips `dip` below `y`. Used for the Ramadan
 * bunting and the Christmas lights.
 */
function swag(y: number, dip: number, step: number, swags = 2): Array<{ x: number; y: number }> {
  const out: Array<{ x: number; y: number }> = [];
  const w = 1200 / swags;
  for (let x = step / 2; x < 1200; x += step) {
    const t = (x % w) / w;
    out.push({ x, y: y + 4 * dip * t * (1 - t) });
  }
  return out;
}
const swagPath = (y: number, dip: number, swags = 2) =>
  Array.from({ length: swags }, (_, i) => {
    const w = 1200 / swags;
    return `M${i * w} ${y} Q${i * w + w / 2} ${y + 2 * dip} ${(i + 1) * w} ${y}`;
  }).join(" ");

/** Khayamiya colours — the appliqué tent cloth of Cairo's Tentmakers' Street. */
const KHAYAMIYA = ["#B8452F", "#D9B45A", "#2F7E66", "#2E5E9E", "#E8DCC0"];
const GLASS = ["#2F7E66", "#A33B3B", "#2E5E9E", "#C98A2E"];
/** Playground colours for the family pages: coral, sun, mint, sky, lilac. */
const FUN = ["#FF6B6B", "#FFD166", "#06D6A0", "#4CC9F0", "#B388EB"];

/**
 * The sunrise pages open on a photograph, not a drawing: the sun clearing the
 * horizon beside the pyramids of Giza, the open sky above it left for the
 * words. Its licence asks for a credit, printed in the corner of the hero and
 * listed in data/photoCredits.ts. SUN is where the sun sits in the frame, as
 * fractions of its width and height, so the warm bloom laid over it stays on
 * it at every crop. HORIZON is where the pyramids stand.
 */
const SUNRISE_PHOTO = "/images/stock/giza-pyramids-sunrise-sky.webp";
const SUNRISE_SIZE = { w: 2400, h: 1440 };
const SUN = { x: 0.755, y: 0.606 };
const sunriseCredit = creditFor(SUNRISE_PHOTO);

/**
 * The plates on the feast's table — the evening's own dishes, in our own
 * photographs or ones that need no credit (CC0), since a plate has nowhere to
 * print one. `hot` ones steam.
 */
const FEAST_PLATES = [
  { src: "/images/food/koshari-sauce-pour.webp", w: 720, h: 900, hot: true, pos: "50% 62%" },
  { src: "/images/food/ful-medames-bowl.webp", w: 702, h: 437, hot: true },
  { src: "/images/food/kunafa-pistachio.webp", w: 736, h: 920, hot: false },
  { src: "/images/food/hamam-mahshi.webp", w: 735, h: 478, hot: true },
];
/** Spice on the table: sesame, chilli, cumin, parsley. */
const SPICE = ["#F3E3C3", "#E8623A", "#B5793F", "#7DBE5A"];

/** A cluster of dates hanging from a stalk at (x, y). */
function dates(x: number, y: number): Array<{ cx: number; cy: number }> {
  const out: Array<{ cx: number; cy: number }> = [];
  [[0], [-4, 4], [-8, 0, 8], [-6, 2, 9], [-3, 5]].forEach((row, r) =>
    row.forEach((dx) => out.push({ cx: x + dx, cy: y + 8 + r * 6 })),
  );
  return out;
}
---

{theme === "ramadan" && (
  <div class="sth sth-ramadan" aria-hidden="true">
    {/* Zeena: the khayamiya-coloured bunting strung across every Egyptian
        street in Ramadan, with a string of small lights beneath it */}
    <svg class="sth-zeena" viewBox="0 0 1200 120" width="1200" height="120" preserveAspectRatio="xMidYMin slice">
      <path d={swagPath(10, 26, 3)} fill="none" stroke="#D9B45A" stroke-width="1.2" opacity=".55" />
      {swag(10, 26, 34, 3).map((f, i) => (
        <g>
          <path d={`M${f.x - 13} ${f.y} L${f.x + 13} ${f.y} L${f.x} ${f.y + 24} Z`} fill={KHAYAMIYA[i % 5]} opacity=".88" />
          <path d={`M${f.x - 6} ${f.y + 3} L${f.x + 6} ${f.y + 3} L${f.x} ${f.y + 14} Z`} fill={KHAYAMIYA[(i + 2) % 5]} opacity=".7" />
        </g>
      ))}
      <path d={swagPath(48, 30, 2)} fill="none" stroke="#D9B45A" stroke-width=".8" opacity=".35" />
      {swag(48, 30, 30, 2).map((l, i) => (
        <circle class={`sth-bulb sth-k${i % 3}`} cx={l.x} cy={l.y + 2} r="2.6" fill="#FBEFC4" />
      ))}
    </svg>
    {/* Hanging fanous lanterns, coloured glass, each with its own glow */}
    <div class="sth-lanterns">
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
        <div class={`sth-lantern sth-l${i % 4}`}>
          <span class="sth-cord"></span>
          <span class="sth-halo"></span>
          <svg viewBox="0 0 40 62" width="44" height="68">
            <defs>
              <linearGradient id={`lg${i}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".98" />
                <stop offset="55%" stop-color="#D9B45A" stop-opacity=".88" />
                <stop offset="100%" stop-color="#A87E32" stop-opacity=".8" />
              </linearGradient>
            </defs>
            <path d="M20 2 L26 8 H14 Z" fill="#D9B45A" />
            <rect x="12" y="8" width="16" height="3" rx="1" fill="#D9B45A" />
            <path d="M11 11 H29 L33 24 L29 46 H11 L7 24 Z" fill={`url(#lg${i})`} stroke="#F7E6AE" stroke-width=".8" />
            <path d="M15 15 L20 20 L25 15 L25 38 L20 43 L15 38 Z" fill={GLASS[i % 4]} opacity=".75" />
            <path d="M9.5 23 L13 16 L13 40 Z M30.5 23 L27 16 L27 40 Z" fill={GLASS[(i + 1) % 4]} opacity=".55" />
            <circle cx="20" cy="29" r="3.2" fill="#FFF6DA" opacity=".9" />
            <path d="M20 20 V43" stroke="#F7E6AE" stroke-width=".6" opacity=".6" />
            <rect x="13" y="46" width="14" height="3" rx="1" fill="#D9B45A" />
            <path d="M20 49 V56" stroke="#D9B45A" stroke-width="1" />
            <circle cx="20" cy="58" r="2.6" fill="#D9B45A" />
          </svg>
        </div>
      ))}
    </div>
    {/* Crescent and star, with a few stars of their own */}
    <svg class="sth-crescent" viewBox="0 0 120 120" width="150" height="150">
      <path d="M78 18a44 44 0 1 0 26 74A36 36 0 1 1 78 18Z" fill="#D9B45A" fill-opacity=".14" stroke="#F7E6AE" stroke-width="2" opacity=".85" />
      <path d="M96 30l3.2 7.4 8 .8-6 5.4 1.7 7.9-6.9-4.2-6.9 4.2 1.7-7.9-6-5.4 8-.8Z" fill="#FBEFC4" opacity=".9" />
    </svg>
  </div>
)}

