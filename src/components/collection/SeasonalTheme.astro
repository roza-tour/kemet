  @media(max-width:600px){ .sth-lotus{ transform:translateX(-50%) scale(1); top:88px; } .themed-honeymoon .phero { padding-top: 212px; } }

  /* Family — balloons and a caravan, turquoise and sun */
  .themed-family {
    --gold: #F2C46D; --gold-bright: #FFF0CF; --gold-deep: #B48A3A;
