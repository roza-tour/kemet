    </svg>
    {/* Ornament band: a garland swag hung with baubles, crowned by a star */}
    <div class="sth-band sth-xband">
      <svg viewBox="0 0 460 104" width="460" height="104">
        <defs>
          <linearGradient id="xgar" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#3E9E6E" stop-opacity="0" />
            <stop offset="22%" stop-color="#3E9E6E" stop-opacity=".8" />
            <stop offset="50%" stop-color="#E3C579" stop-opacity=".9" />
            <stop offset="78%" stop-color="#3E9E6E" stop-opacity=".8" />
