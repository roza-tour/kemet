  .themed-christmas { --atmos-base: #0B1611;
    --atmos: radial-gradient(1000px 600px at 50% 0%, rgba(62,158,110,.28), transparent 62%), radial-gradient(720px 520px at 0% 40%, rgba(192,57,43,.20), transparent 66%), radial-gradient(720px 520px at 100% 70%, rgba(227,197,121,.10), transparent 66%), linear-gradient(180deg, #102219 0%, #0B1611 50%, #09110D 100%); }
  .themed-ramadan { --atmos-base: #07130F;
    --atmos: radial-gradient(1000px 600px at 50% 0%, rgba(47,126,102,.34), transparent 62%), radial-gradient(720px 520px at 100% 40%, rgba(224,190,106,.13), transparent 66%), radial-gradient(720px 520px at 0% 75%, rgba(46,94,158,.16), transparent 66%), linear-gradient(180deg, #0B1E18 0%, #07130F 50%, #060E0C 100%); }
  .themed-easter { --atmos-base: #120D1C;
