---
// SeasonalTheme — gives a collection page its own visual identity: a shifted
// accent palette, a themed ornament band beneath the nav, and a soft background
// motif. All artwork is inline SVG (no external requests, scales cleanly) and
// every animation is disabled under prefers-reduced-motion.
//
// Themes: ramadan (crescents + fanous lanterns, emerald & gold)
//         christmas (stars + evergreen, silver-gold on deep pine)
//         sun-festival (solar burst + falcon disc, amber)
import type { SeasonalTheme } from "@/types";

interface Props {
  theme: SeasonalTheme;
}
const { theme } = Astro.props;
---

{theme === "ramadan" && (
  <div class="sth sth-ramadan" aria-hidden="true">
    {/* Hanging fanous lanterns */}
    <div class="sth-lanterns">
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <div class={`sth-lantern sth-l${i % 4}`}>
          <span class="sth-cord"></span>
          <svg viewBox="0 0 40 62" width="34" height="53">
            <defs>
              <linearGradient id={`lg${i}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".95" />
                <stop offset="55%" stop-color="#D9B45A" stop-opacity=".8" />
                <stop offset="100%" stop-color="#A87E32" stop-opacity=".7" />
              </linearGradient>
            </defs>
            {/* crown */}
            <path d="M20 2 L26 8 H14 Z" fill="#D9B45A" opacity=".9" />
            <rect x="12" y="8" width="16" height="3" rx="1" fill="#D9B45A" opacity=".85" />
            {/* body */}
            <path d="M11 11 H29 L33 24 L29 46 H11 L7 24 Z" fill={`url(#lg${i})`} stroke="#D9B45A" stroke-width=".8" />
            {/* glass panes */}
            <path d="M15 15 L20 20 L25 15 L25 38 L20 43 L15 38 Z" fill="#2F7E66" opacity=".45" />
            <path d="M20 20 V43" stroke="#F7E6AE" stroke-width=".6" opacity=".5" />
            {/* base + tassel */}
            <rect x="13" y="46" width="14" height="3" rx="1" fill="#D9B45A" opacity=".9" />
            <path d="M20 49 V56" stroke="#D9B45A" stroke-width="1" opacity=".8" />
            <circle cx="20" cy="58" r="2.6" fill="#D9B45A" opacity=".85" />
          </svg>
        </div>
      ))}
    </div>
    {/* Crescent + star */}
    <svg class="sth-crescent" viewBox="0 0 120 120" width="120" height="120">
      <path d="M78 18a44 44 0 1 0 26 74A36 36 0 1 1 78 18Z" fill="none" stroke="#D9B45A" stroke-width="2" opacity=".55" />
      <path d="M96 30l3.2 7.4 8 .8-6 5.4 1.7 7.9-6.9-4.2-6.9 4.2 1.7-7.9-6-5.4 8-.8Z" fill="#F7E6AE" opacity=".6" />
    </svg>
  </div>
)}

{theme === "christmas" && (
  <div class="sth sth-christmas" aria-hidden="true">
    {/* Starfield */}
    <div class="sth-stars">
      {[...Array(22)].map((_, i) => (
        <span class={`sth-star sth-s${i % 5}`} style={`left:${(i * 4.5 + (i % 3) * 2.2) % 98}%;top:${(i * 7 + (i % 4) * 9) % 88}%`}></span>
      ))}
    </div>
    {/* Ornament band: a garland swag hung with baubles, crowned by a star */}
    <div class="sth-band">
      <svg viewBox="0 0 460 92" width="460" height="92">
        <defs>
          <linearGradient id="xgar" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#D9B45A" stop-opacity="0" />
            <stop offset="22%" stop-color="#D9B45A" stop-opacity=".75" />
            <stop offset="50%" stop-color="#FFF6DA" stop-opacity=".9" />
            <stop offset="78%" stop-color="#D9B45A" stop-opacity=".75" />
            <stop offset="100%" stop-color="#D9B45A" stop-opacity="0" />
          </linearGradient>
        </defs>
        {/* garland swag */}
        <path d="M10 30 Q230 76 450 30" fill="none" stroke="url(#xgar)" stroke-width="1.4" />
        {/* hanging baubles */}
        <g opacity=".9">
          <path d="M118 46v9" stroke="#D9B45A" stroke-width="1" opacity=".65" />
          <circle cx="118" cy="60" r="5.5" fill="none" stroke="#D9B45A" stroke-width="1.3" />
          <circle cx="118" cy="58" r="1.6" fill="#FFF6DA" opacity=".7" />
          <path d="M342 46v9" stroke="#D9B45A" stroke-width="1" opacity=".65" />
          <circle cx="342" cy="60" r="5.5" fill="none" stroke="#D9B45A" stroke-width="1.3" />
          <circle cx="342" cy="58" r="1.6" fill="#FFF6DA" opacity=".7" />
          <path d="M230 58v10" stroke="#D9B45A" stroke-width="1" opacity=".55" />
          <circle cx="230" cy="74" r="4" fill="none" stroke="#2F7E66" stroke-width="1.3" opacity=".9" />
        </g>
        {/* crowning eight-point star */}
        <path d="M230 2 L236 22 L256 28 L236 34 L230 54 L224 34 L204 28 L224 22 Z"
              fill="#FFF6DA" opacity=".9" />
        <path d="M230 14 L232.6 25.4 L244 28 L232.6 30.6 L230 42 L227.4 30.6 L216 28 L227.4 25.4 Z"
              fill="#fff" opacity=".65" />
        {/* small flanking stars */}
        <path d="M158 26l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="#D9B45A" opacity=".7" />
        <path d="M302 26l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="#D9B45A" opacity=".7" />
      </svg>
    </div>
  </div>
)}

{theme === "sun-festival" && (
  <div class="sth sth-sun" aria-hidden="true">
    {/* Radiating solar burst */}
    <svg class="sth-rays" viewBox="0 0 400 200" width="400" height="200" preserveAspectRatio="xMidYMin slice">
      <defs>
        <radialGradient id="sunGlow" cx="50%" cy="0%" r="70%">
          <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".38" />
          <stop offset="55%" stop-color="#D9822B" stop-opacity=".12" />
          <stop offset="100%" stop-color="#D9822B" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="200" fill="url(#sunGlow)" />
      <g stroke="#E8A33D" stroke-width="1" opacity=".3">
        {[...Array(19)].map((_, i) => {
          const a = (Math.PI * i) / 18;
          return <line x1="200" y1="6" x2={200 + Math.cos(a) * -220} y2={6 + Math.sin(a) * 220} />;
        })}
      </g>
      {/* winged solar disc */}
      <circle cx="200" cy="16" r="11" fill="#E8A33D" opacity=".85" />
      <path d="M189 16q-26 -9 -46 -2 22 3 46 6Z M211 16q26 -9 46 -2 -22 3 -46 6Z" fill="#D9B45A" opacity=".65" />
    </svg>
  </div>
)}

<style is:global>
  /* ---------------------------------------------------------------------
     Shared theme scaffolding
     --------------------------------------------------------------------- */
  .sth { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 1; }

  /* Themed pages get a scoped accent + ground shift. The page article carries
     .themed-<name>; everything reads through the existing custom properties,
     so components need no changes. */
  .themed-ramadan {
    --gold: #E0BE6A; --gold-bright: #FBEFC4; --gold-deep: #9C7A2E;
    --line: rgba(47,126,102,.26); --line-2: rgba(224,190,106,.44);
  }
  .themed-ramadan .phero {
    background:
      radial-gradient(760px 400px at 50% 0%, rgba(47,126,102,.20), transparent 62%),
      radial-gradient(600px 320px at 50% 6%, rgba(247,230,174,.12), transparent 60%);
  }
  .themed-christmas {
    --gold: #E3C579; --gold-bright: #FFF6DA; --gold-deep: #A8823A;
    --line: rgba(255,255,255,.16); --line-2: rgba(227,197,121,.46);
  }
  .themed-christmas .phero {
    background:
      radial-gradient(780px 420px at 50% 0%, rgba(47,126,102,.16), transparent 60%),
      radial-gradient(560px 300px at 50% 2%, rgba(255,246,218,.16), transparent 62%);
  }
  .themed-sun-festival {
    --gold: #E8A33D; --gold-bright: #FBE2A6; --gold-deep: #A9631C;
    --line: rgba(232,163,61,.24); --line-2: rgba(232,163,61,.46);
  }
  .themed-sun-festival .phero {
    background: radial-gradient(820px 440px at 50% 0%, rgba(232,163,61,.20), transparent 62%);
  }

  /* Make the page hero the positioning context for the ornament layer, and keep
     the heading/breadcrumb above it. */
  .themed-ramadan .phero,
  .themed-christmas .phero,
  .themed-sun-festival .phero { position: relative; }
  .themed-ramadan .phero > .wrap,
  .themed-christmas .phero > .wrap,
  .themed-sun-festival .phero > .wrap { position: relative; z-index: 2; }
  /* Give the ornament room to breathe above the heading. */
  .themed-ramadan .phero { padding-top: 214px; }
  .themed-sun-festival .phero { padding-top: 206px; }
  .themed-christmas .phero { padding-top: 200px; }

  /* ---------------------------------------------------------------------
     Ramadan — hanging fanous lanterns + crescent
     --------------------------------------------------------------------- */
  /* Hang below the fixed nav (86px) so lanterns never cross the menu. */
  .sth-lanterns { position: absolute; top: 94px; left: 0; right: 0; display: flex;
    justify-content: space-around; padding: 0 4%; }
  .sth-lantern { position: relative; display: flex; flex-direction: column; align-items: center;
    transform-origin: top center; animation: sth-sway 7s ease-in-out infinite; opacity: .85;
    filter: drop-shadow(0 6px 18px rgba(217,180,90,.28)); }
  .sth-cord { display: block; width: 1px; background: linear-gradient(180deg, rgba(217,180,90,.55), rgba(217,180,90,.15)); }
  .sth-l0 { animation-delay: 0s; }      .sth-l0 .sth-cord { height: 46px; }
  .sth-l1 { animation-delay: -1.6s; }   .sth-l1 .sth-cord { height: 82px; }
  .sth-l2 { animation-delay: -3.1s; }   .sth-l2 .sth-cord { height: 30px; }
  .sth-l3 { animation-delay: -4.7s; }   .sth-l3 .sth-cord { height: 64px; }
  @keyframes sth-sway { 0%,100% { transform: rotate(-2.2deg); } 50% { transform: rotate(2.2deg); } }
  .sth-crescent { position: absolute; right: 5%; top: 46%; opacity: .5;
    filter: drop-shadow(0 0 22px rgba(217,180,90,.3)); }
  @media(max-width:900px){ .sth-lantern:nth-child(n+5){ display:none; } .sth-crescent{ width:78px;height:78px;right:3%;top:52%; } }
  @media(max-width:600px){ .sth-lantern:nth-child(n+4){ display:none; } .sth-crescent{ display:none; } }

  /* ---------------------------------------------------------------------
     Christmas & New Year — starfield + ornament band
     --------------------------------------------------------------------- */
  .sth-stars { position: absolute; inset: 0; }
  .sth-star { position: absolute; width: 3px; height: 3px; border-radius: 50%;
    background: #FFF6DA; opacity: .5; box-shadow: 0 0 8px rgba(255,246,218,.75);
    animation: sth-twinkle 4.5s ease-in-out infinite; }
  .sth-s0 { animation-delay: 0s; }    .sth-s1 { animation-delay: -.9s; width:2px;height:2px; }
  .sth-s2 { animation-delay: -1.8s; } .sth-s3 { animation-delay: -2.7s; width:4px;height:4px; }
  .sth-s4 { animation-delay: -3.6s; width:2px;height:2px; }
  @keyframes sth-twinkle { 0%,100% { opacity: .18; transform: scale(.85); } 50% { opacity: .85; transform: scale(1.15); } }
  .sth-band { position: absolute; left: 50%; top: 104px; transform: translateX(-50%); opacity: .8; }
  @media(max-width:600px){ .sth-band{ transform:translateX(-50%) scale(.78); top:88px; } }

  /* ---------------------------------------------------------------------
     Abu Simbel Sun Festival — solar burst
     --------------------------------------------------------------------- */
  .sth-rays { position: absolute; top: 88px; left: 50%; transform: translateX(-50%);
    width: min(1100px, 130%); height: auto; opacity: .9; }
  .themed-sun-festival .phero h1 { text-shadow: 0 0 42px rgba(232,163,61,.22); }

  @media (prefers-reduced-motion: reduce) {
    .sth-lantern, .sth-star { animation: none !important; }
  }
</style>
