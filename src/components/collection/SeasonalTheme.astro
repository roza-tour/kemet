    --gold: #E3C579; --gold-bright: #FFF6DA; --gold-deep: #A8823A;
    --line: rgba(255,255,255,.16); --line-2: rgba(227,197,121,.46);
  }
  .themed-christmas .phero {
    background:
      radial-gradient(780px 420px at 50% 0%, rgba(47,126,102,.16), transparent 60%),
