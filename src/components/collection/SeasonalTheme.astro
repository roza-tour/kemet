---
// SeasonalTheme — gives a collection page its own visual identity: a shifted
// accent palette, a themed ornament band beneath the nav, and a soft background
// motif. All artwork is inline SVG (no external requests, scales cleanly) and
// every animation is disabled under prefers-reduced-motion.
//
// Themes: ramadan (crescents + fanous lanterns, emerald & gold)
//         christmas (stars + evergreen, silver-gold on deep pine)
//         sun-festival (solar burst + falcon disc, amber)
//         easter (Holy Week: crossed palm fronds + lilies, violet & gold)
//         autumn (the date harvest: a palm crown hung with dates, copper)
//         summer (a slow sun over a Mediterranean swell and a felucca, azure)
//         carnival (confetti and streamers, Brazil's green, gold and rose)
//         eclipse (the corona around a black sun, pearl on deep indigo)
import type { SeasonalTheme } from "@/types";

interface Props {
  theme: SeasonalTheme;
}
const { theme } = Astro.props;

/**
 * A palm frond as hairlines: a quadratic stem (p0 → c → p1) with leaflets on
 * both sides, shortening towards the tip. Used by the Holy Week palms and the
 * date-harvest crown.
 */
function frond(p0: [number, number], c: [number, number], p1: [number, number], n = 13, len = 15): string {
  const segs: string[] = [`M${p0[0]} ${p0[1]} Q${c[0]} ${c[1]} ${p1[0]} ${p1[1]}`];
  for (let i = 1; i <= n; i++) {
    const t = i / (n + 1);
    const x = (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * c[0] + t ** 2 * p1[0];
    const y = (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * c[1] + t ** 2 * p1[1];
    let tx = 2 * (1 - t) * (c[0] - p0[0]) + 2 * t * (p1[0] - c[0]);
    let ty = 2 * (1 - t) * (c[1] - p0[1]) + 2 * t * (p1[1] - c[1]);
    const m = Math.hypot(tx, ty) || 1;
    tx /= m; ty /= m;
    const l = len * (1 - t * 0.7);
    for (const side of [1, -1]) {
      const ex = x + (-ty * side * 0.85 + tx * 0.55) * l;
      const ey = y + (tx * side * 0.85 + ty * 0.55) * l;
      segs.push(`M${x.toFixed(1)} ${y.toFixed(1)} L${ex.toFixed(1)} ${ey.toFixed(1)}`);
    }
  }
  return segs.join(" ");
}

/** A lily seen from the side: three petals over a short stem. */
function lily(x: number, y: number): string {
  return [
    `M${x} ${y + 26} V${y + 8}`,
    `M${x} ${y + 8} C${x - 10} ${y + 4} ${x - 15} ${y - 6} ${x - 13} ${y - 12} C${x - 7} ${y - 6} ${x - 2} ${y - 2} ${x} ${y + 8} Z`,
    `M${x} ${y + 8} C${x + 10} ${y + 4} ${x + 15} ${y - 6} ${x + 13} ${y - 12} C${x + 7} ${y - 6} ${x + 2} ${y - 2} ${x} ${y + 8} Z`,
    `M${x} ${y + 8} C${x - 4} ${y - 2} ${x - 3} ${y - 12} ${x} ${y - 17} C${x + 3} ${y - 12} ${x + 4} ${y - 2} ${x} ${y + 8} Z`,
  ].join(" ");
}

/** A cluster of dates hanging from a stalk at (x, y). */
function dates(x: number, y: number): Array<{ cx: number; cy: number }> {
  const out: Array<{ cx: number; cy: number }> = [];
  [[0], [-4, 4], [-8, 0, 8], [-6, 2, 9], [-3, 5]].forEach((row, r) =>
    row.forEach((dx) => out.push({ cx: x + dx, cy: y + 8 + r * 6 })),
  );
  return out;
}
---

{theme === "ramadan" && (
  <div class="sth sth-ramadan" aria-hidden="true">
    {/* Hanging fanous lanterns */}
    <div class="sth-lanterns">
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <div class={`sth-lantern sth-l${i % 4}`}>
          <span class="sth-cord"></span>
          <svg viewBox="0 0 40 62" width="34" height="53">
            <defs>
              <linearGradient id={`lg${i}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".95" />
                <stop offset="55%" stop-color="#D9B45A" stop-opacity=".8" />
                <stop offset="100%" stop-color="#A87E32" stop-opacity=".7" />
              </linearGradient>
            </defs>
            {/* crown */}
            <path d="M20 2 L26 8 H14 Z" fill="#D9B45A" opacity=".9" />
            <rect x="12" y="8" width="16" height="3" rx="1" fill="#D9B45A" opacity=".85" />
            {/* body */}
            <path d="M11 11 H29 L33 24 L29 46 H11 L7 24 Z" fill={`url(#lg${i})`} stroke="#D9B45A" stroke-width=".8" />
            {/* glass panes */}
            <path d="M15 15 L20 20 L25 15 L25 38 L20 43 L15 38 Z" fill="#2F7E66" opacity=".45" />
            <path d="M20 20 V43" stroke="#F7E6AE" stroke-width=".6" opacity=".5" />
            {/* base + tassel */}
            <rect x="13" y="46" width="14" height="3" rx="1" fill="#D9B45A" opacity=".9" />
            <path d="M20 49 V56" stroke="#D9B45A" stroke-width="1" opacity=".8" />
            <circle cx="20" cy="58" r="2.6" fill="#D9B45A" opacity=".85" />
          </svg>
        </div>
      ))}
    </div>
    {/* Crescent + star */}
    <svg class="sth-crescent" viewBox="0 0 120 120" width="120" height="120">
      <path d="M78 18a44 44 0 1 0 26 74A36 36 0 1 1 78 18Z" fill="none" stroke="#D9B45A" stroke-width="2" opacity=".55" />
      <path d="M96 30l3.2 7.4 8 .8-6 5.4 1.7 7.9-6.9-4.2-6.9 4.2 1.7-7.9-6-5.4 8-.8Z" fill="#F7E6AE" opacity=".6" />
    </svg>
  </div>
)}

{theme === "christmas" && (
  <div class="sth sth-christmas" aria-hidden="true">
    {/* Starfield */}
    <div class="sth-stars">
      {[...Array(22)].map((_, i) => (
        <span class={`sth-star sth-s${i % 5}`} style={`left:${(i * 4.5 + (i % 3) * 2.2) % 98}%;top:${(i * 7 + (i % 4) * 9) % 88}%`}></span>
      ))}
    </div>
    {/* Ornament band: a garland swag hung with baubles, crowned by a star */}
    <div class="sth-band">
      <svg viewBox="0 0 460 92" width="460" height="92">
        <defs>
          <linearGradient id="xgar" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#D9B45A" stop-opacity="0" />
            <stop offset="22%" stop-color="#D9B45A" stop-opacity=".75" />
            <stop offset="50%" stop-color="#FFF6DA" stop-opacity=".9" />
            <stop offset="78%" stop-color="#D9B45A" stop-opacity=".75" />
            <stop offset="100%" stop-color="#D9B45A" stop-opacity="0" />
          </linearGradient>
        </defs>
        {/* garland swag */}
        <path d="M10 30 Q230 76 450 30" fill="none" stroke="url(#xgar)" stroke-width="1.4" />
        {/* hanging baubles */}
        <g opacity=".9">
          <path d="M118 46v9" stroke="#D9B45A" stroke-width="1" opacity=".65" />
          <circle cx="118" cy="60" r="5.5" fill="none" stroke="#D9B45A" stroke-width="1.3" />
          <circle cx="118" cy="58" r="1.6" fill="#FFF6DA" opacity=".7" />
          <path d="M342 46v9" stroke="#D9B45A" stroke-width="1" opacity=".65" />
          <circle cx="342" cy="60" r="5.5" fill="none" stroke="#D9B45A" stroke-width="1.3" />
          <circle cx="342" cy="58" r="1.6" fill="#FFF6DA" opacity=".7" />
          <path d="M230 58v10" stroke="#D9B45A" stroke-width="1" opacity=".55" />
          <circle cx="230" cy="74" r="4" fill="none" stroke="#2F7E66" stroke-width="1.3" opacity=".9" />
        </g>
        {/* crowning eight-point star */}
        <path d="M230 2 L236 22 L256 28 L236 34 L230 54 L224 34 L204 28 L224 22 Z"
              fill="#FFF6DA" opacity=".9" />
        <path d="M230 14 L232.6 25.4 L244 28 L232.6 30.6 L230 42 L227.4 30.6 L216 28 L227.4 25.4 Z"
              fill="#fff" opacity=".65" />
        {/* small flanking stars */}
        <path d="M158 26l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="#D9B45A" opacity=".7" />
        <path d="M302 26l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z" fill="#D9B45A" opacity=".7" />
      </svg>
    </div>
  </div>
)}

{theme === "spring" && (
  <div class="sth sth-spring" aria-hidden="true">
    {/* Drifting blossom petals */}
    <div class="sth-petals">
      {[...Array(14)].map((_, i) => (
        <span class={`sth-petal sth-p${i % 5}`} style={`left:${(i * 7.3 + (i % 3) * 3) % 96}%`}></span>
      ))}
    </div>
    {/* Garland of painted eggs + spring shoots */}
    <div class="sth-band sth-spring-band">
      <svg viewBox="0 0 420 84" width="420" height="84">
        <defs>
          <linearGradient id="spgar" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#7FB086" stop-opacity="0" />
            <stop offset="30%" stop-color="#7FB086" stop-opacity=".7" />
            <stop offset="70%" stop-color="#7FB086" stop-opacity=".7" />
            <stop offset="100%" stop-color="#7FB086" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path d="M14 26 Q210 66 406 26" fill="none" stroke="url(#spgar)" stroke-width="1.4" />
        {/* painted eggs hanging from the vine */}
        {[
          { x: 96, y: 50, c: "#D9B45A" },
          { x: 168, y: 58, c: "#C06B3A" },
          { x: 252, y: 58, c: "#4385A0" },
          { x: 324, y: 50, c: "#9A4456" },
        ].map((e) => (
          <g opacity=".9">
            <path d={`M${e.x} ${e.y - 12}v6`} stroke="#7FB086" stroke-width="1" opacity=".7" />
            <ellipse cx={e.x} cy={e.y + 4} rx="7" ry="9.5" fill="none" stroke={e.c} stroke-width="1.5" />
            <path d={`M${e.x - 6} ${e.y + 2}q6 3 12 0 M${e.x - 6} ${e.y + 7}q6 3 12 0`} stroke={e.c} stroke-width="1" fill="none" opacity=".75" />
          </g>
        ))}
        {/* young shoots */}
        <g stroke="#7FB086" stroke-width="1.5" fill="none" opacity=".85" stroke-linecap="round">
          <path d="M210 24v-16M210 14q-8-4-10-11M210 16q8-5 11-12" />
        </g>
        <circle cx="210" cy="6" r="2.6" fill="#F7E6AE" opacity=".85" />
      </svg>
    </div>
  </div>
)}

{theme === "red-sea" && (
  <div class="sth sth-redsea" aria-hidden="true">
    {/* Light shafts through water + rolling swell */}
    <div class="sth-shafts"></div>
    <svg class="sth-swell" viewBox="0 0 1200 120" width="1200" height="120" preserveAspectRatio="none">
      <path d="M0 74 Q150 44 300 74 T600 74 T900 74 T1200 74 V120 H0Z" fill="#2C8E86" opacity=".14" />
      <path d="M0 88 Q150 62 300 88 T600 88 T900 88 T1200 88 V120 H0Z" fill="#4385A0" opacity=".12" />
      <path d="M0 74 Q150 44 300 74 T600 74 T900 74 T1200 74" fill="none" stroke="#7FD8CE" stroke-width="1" opacity=".3" />
    </svg>
    {/* Rising bubbles */}
    <div class="sth-bubbles">
      {[...Array(10)].map((_, i) => (
        <span class={`sth-bubble sth-b${i % 4}`} style={`left:${(i * 9.5 + (i % 3) * 4) % 94}%`}></span>
      ))}
    </div>
  </div>
)}

{theme === "honeymoon" && (
  <div class="sth sth-honeymoon" aria-hidden="true">
    {/* Soft rose-gold glow + a delicate lotus pair */}
    <div class="sth-glow"></div>
    {/* A lotus in bloom on two entwined stems — the Egyptian emblem of union */}
    <svg class="sth-lotus" viewBox="0 0 200 96" width="200" height="96">
      <g stroke="#E8B4A0" stroke-width="1.5" fill="none" opacity=".9" stroke-linejoin="round">
        {/* outer petals */}
        <path d="M100 54 C 82 52, 66 46, 54 36 C 70 34, 88 42, 100 54 Z" />
        <path d="M100 54 C 118 52, 134 46, 146 36 C 130 34, 112 42, 100 54 Z" />
        {/* inner petals */}
        <path d="M100 54 C 88 44, 80 32, 76 20 C 88 26, 96 40, 100 54 Z" />
        <path d="M100 54 C 112 44, 120 32, 124 20 C 112 26, 104 40, 100 54 Z" />
        {/* central petal */}
        <path d="M100 54 C 94 40, 94 24, 100 10 C 106 24, 106 40, 100 54 Z" />
        {/* entwined stems */}
        <path d="M100 56 C 96 68, 84 76, 72 82" />
        <path d="M100 56 C 104 68, 116 76, 128 82" />
      </g>
      <circle cx="100" cy="34" r="2.2" fill="#F7E6AE" opacity=".85" />
      <path d="M100 86l1.6 4.4 4.4 1.6-4.4 1.6-1.6 4.4-1.6-4.4-4.4-1.6 4.4-1.6Z" fill="#F7E6AE" opacity=".6" />
    </svg>
  </div>
)}

{theme === "eid" && (
  <div class="sth sth-eid" aria-hidden="true">
    {/* Festive bunting — two swags of pennant flags */}
    <svg class="sth-bunting" viewBox="0 0 460 70" width="460" height="70">
      <path d="M8 12 Q230 52 452 12" fill="none" stroke="#D9B45A" stroke-width="1.2" opacity=".7" />
      {[36,96,156,216,276,336,396].map((x, i) => {
        const y = 12 + Math.sin(((x - 8) / 444) * Math.PI) * 38;
        const c = ["#2F7E66", "#D9B45A", "#9A4456", "#4385A0"][i % 4];
        return <path d={`M${x - 9} ${y} L${x + 9} ${y} L${x} ${y + 17} Z`} fill={c} opacity=".8" />;
      })}
    </svg>
    <svg class="sth-eid-moon" viewBox="0 0 90 90" width="86" height="86">
      <path d="M60 12a34 34 0 1 0 20 58A28 28 0 1 1 60 12Z" fill="none" stroke="#D9B45A" stroke-width="2" opacity=".6" />
      <path d="M72 24l2.4 5.6 6 .6-4.5 4 1.3 6-5.2-3.2-5.2 3.2 1.3-6-4.5-4 6-.6Z" fill="#F7E6AE" opacity=".7" />
    </svg>
  </div>
)}

{theme === "sun-festival" && (
  <div class="sth sth-sun" aria-hidden="true">
    {/* Radiating solar burst */}
    <svg class="sth-rays" viewBox="0 0 400 200" width="400" height="200" preserveAspectRatio="xMidYMin slice">
      <defs>
        <radialGradient id="sunGlow" cx="50%" cy="0%" r="70%">
          <stop offset="0%" stop-color="#F7E6AE" stop-opacity=".38" />
          <stop offset="55%" stop-color="#D9822B" stop-opacity=".12" />
          <stop offset="100%" stop-color="#D9822B" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="400" height="200" fill="url(#sunGlow)" />
      <g stroke="#E8A33D" stroke-width="1" opacity=".3">
        {[...Array(19)].map((_, i) => {
          const a = (Math.PI * i) / 18;
          return <line x1="200" y1="6" x2={200 + Math.cos(a) * -220} y2={6 + Math.sin(a) * 220} />;
        })}
      </g>
      {/* winged solar disc */}
      <circle cx="200" cy="16" r="11" fill="#E8A33D" opacity=".85" />
      <path d="M189 16q-26 -9 -46 -2 22 3 46 6Z M211 16q26 -9 46 -2 -22 3 -46 6Z" fill="#D9B45A" opacity=".65" />
    </svg>
  </div>
)}

{theme === "easter" && (
  <div class="sth sth-easter" aria-hidden="true">
    <div class="sth-easter-glow"></div>
    {/* Holy Week: two palm fronds for Palm Sunday, crossed beneath three lilies */}
    <div class="sth-band sth-easter-band">
      <svg viewBox="0 0 440 104" width="440" height="104">
        <g stroke="#C9B0E2" stroke-width="1.1" fill="none" opacity=".8" stroke-linecap="round">
          <path d={frond([214, 92], [150, 74], [70, 30])} />
          <path d={frond([226, 92], [290, 74], [370, 30])} />
        </g>
        <g fill="none" stroke="#F3EAFB" stroke-width="1.3" stroke-linejoin="round" opacity=".92">
          <path d={lily(196, 46)} />
          <path d={lily(244, 46)} />
          <path d={lily(220, 30)} />
        </g>
        <g fill="#E3C579" opacity=".85">
          <circle cx="196" cy="44" r="1.6" /><circle cx="244" cy="44" r="1.6" /><circle cx="220" cy="28" r="1.6" />
        </g>
        <path d="M220 2l1.8 5 5 1.8-5 1.8-1.8 5-1.8-5-5-1.8 5-1.8Z" fill="#FFF6DA" opacity=".75" />
      </svg>
    </div>
  </div>
)}

{theme === "autumn" && (
  <div class="sth sth-autumn" aria-hidden="true">
    {/* Warm motes drifting in low autumn light */}
    <div class="sth-motes">
      {[...Array(12)].map((_, i) => (
        <span class={`sth-mote sth-m${i % 4}`} style={`left:${(i * 8.3 + (i % 3) * 3.5) % 95}%`}></span>
      ))}
    </div>
    {/* The date harvest — Egypt's autumn: a palm crown hung with ripe clusters */}
    <div class="sth-band sth-autumn-band">
      <svg viewBox="0 0 440 108" width="440" height="108">
        <g stroke="#E0A46A" stroke-width="1.1" fill="none" opacity=".8" stroke-linecap="round">
          <path d={frond([220, 18], [160, 6], [96, 50], 12, 13)} />
          <path d={frond([220, 18], [280, 6], [344, 50], 12, 13)} />
          <path d={frond([220, 18], [176, 22], [140, 72], 10, 11)} />
          <path d={frond([220, 18], [264, 22], [300, 72], 10, 11)} />
        </g>
        <path d="M206 30 L214 52 M234 30 L226 52" stroke="#A5632E" stroke-width="1.2" opacity=".8" />
        {[...dates(213, 50), ...dates(227, 50)].map((d, i) => (
          <ellipse cx={d.cx} cy={d.cy} rx="2.6" ry="3.6" fill={i % 3 === 0 ? "#C9773A" : "#A5632E"} opacity=".9" />
        ))}
        <circle cx="220" cy="17" r="3" fill="#F8DFC4" opacity=".75" />
      </svg>
    </div>
  </div>
)}

{theme === "summer" && (
  <div class="sth sth-summer" aria-hidden="true">
    {/* A high summer sun with a slowly turning ring of rays */}
    <svg class="sth-summer-sun" viewBox="0 0 200 200" width="200" height="200">
      <defs>
        <radialGradient id="smSun" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FFF0C2" stop-opacity=".95" />
          <stop offset="45%" stop-color="#F0C24B" stop-opacity=".75" />
          <stop offset="100%" stop-color="#F0C24B" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="100" cy="100" r="96" fill="url(#smSun)" opacity=".35" />
      <g class="sth-summer-rays" stroke="#F0C24B" stroke-width="1.4" stroke-linecap="round" opacity=".55">
        {[...Array(16)].map((_, i) => {
          const a = (Math.PI * 2 * i) / 16;
          const r1 = 40, r2 = i % 2 ? 58 : 70;
          return <line x1={100 + Math.cos(a) * r1} y1={100 + Math.sin(a) * r1} x2={100 + Math.cos(a) * r2} y2={100 + Math.sin(a) * r2} />;
        })}
      </g>
      <circle cx="100" cy="100" r="30" fill="#F0C24B" opacity=".8" />
      <circle cx="100" cy="100" r="22" fill="#FFF0C2" opacity=".5" />
    </svg>
    {/* The Mediterranean swell, and a felucca crossing it */}
    <svg class="sth-swell sth-summer-swell" viewBox="0 0 1200 120" width="1200" height="120" preserveAspectRatio="none">
      <path d="M0 76 Q150 50 300 76 T600 76 T900 76 T1200 76 V120 H0Z" fill="#4FA3D6" opacity=".14" />
      <path d="M0 92 Q150 70 300 92 T600 92 T900 92 T1200 92 V120 H0Z" fill="#2E7FB3" opacity=".12" />
      <path d="M0 76 Q150 50 300 76 T600 76 T900 76 T1200 76" fill="none" stroke="#BFE3F7" stroke-width="1" opacity=".35" />
    </svg>
    <svg class="sth-felucca" viewBox="0 0 80 70" width="80" height="70">
      <path d="M38 6 L40 54 L12 52 Z" fill="#FFF0C2" opacity=".55" />
      <path d="M41 14 L64 52 L42 53 Z" fill="#FFF0C2" opacity=".35" />
      <path d="M8 56 Q40 64 72 56 L66 62 Q40 68 14 62 Z" fill="#F0C24B" opacity=".55" />
    </svg>
  </div>
)}

{theme === "carnival" && (
  <div class="sth sth-carnival" aria-hidden="true">
    {/* Falling confetti */}
    <div class="sth-confetti">
      {[...Array(26)].map((_, i) => (
        <span class={`sth-conf sth-c${i % 6}`} style={`left:${(i * 3.9 + (i % 5) * 1.7) % 97}%`}></span>
      ))}
    </div>
    {/* Serpentine streamers swagged across the top */}
    <svg class="sth-streamers" viewBox="0 0 1200 140" width="1200" height="140" preserveAspectRatio="none">
      <path d="M0 20 C150 90 300 -10 450 60 S750 0 900 70 S1100 10 1200 40" fill="none" stroke="#2DBE6C" stroke-width="2.2" opacity=".55" />
      <path d="M0 50 C160 0 320 100 480 40 S780 110 960 40 S1120 90 1200 30" fill="none" stroke="#F2C230" stroke-width="2.2" opacity=".55" />
      <path d="M0 80 C140 40 300 120 460 70 S760 30 940 90 S1110 50 1200 80" fill="none" stroke="#E0457B" stroke-width="2" opacity=".5" />
      <path d="M0 34 C170 70 330 10 500 50 S800 90 980 24 S1130 60 1200 56" fill="none" stroke="#3E8EDE" stroke-width="1.6" opacity=".45" />
    </svg>
  </div>
)}

{theme === "eclipse" && (
  <div class="sth sth-eclipse" aria-hidden="true">
    <div class="sth-stars">
      {[...Array(26)].map((_, i) => (
        <span class={`sth-star sth-s${i % 5}`} style={`left:${(i * 3.9 + (i % 4) * 2.4) % 98}%;top:${(i * 6.7 + (i % 5) * 8) % 86}%`}></span>
      ))}
    </div>
    {/* Totality: the Moon's black disc, the corona around it, and the diamond ring */}
    <svg class="sth-corona" viewBox="0 0 260 260" width="190" height="190">
      <defs>
        <radialGradient id="ecCor" cx="50%" cy="50%" r="50%">
          <stop offset="28%" stop-color="#FFFFFF" stop-opacity=".9" />
          <stop offset="36%" stop-color="#E4E8FF" stop-opacity=".45" />
          <stop offset="60%" stop-color="#9AA6E0" stop-opacity=".12" />
          <stop offset="100%" stop-color="#9AA6E0" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle class="sth-corona-glow" cx="130" cy="130" r="128" fill="url(#ecCor)" />
      <g stroke="#F4F6FF" stroke-linecap="round" opacity=".32">
        {[...Array(28)].map((_, i) => {
          const a = (Math.PI * 2 * i) / 28 + (i % 3) * 0.05;
          const r2 = 52 + ((i * 37) % 5) * 13;
          return <line x1={130 + Math.cos(a) * 40} y1={130 + Math.sin(a) * 40} x2={130 + Math.cos(a) * r2} y2={130 + Math.sin(a) * r2} stroke-width={i % 4 === 0 ? 1.4 : 0.7} />;
        })}
      </g>
      <circle cx="130" cy="130" r="37" fill="#07080F" />
      <circle cx="130" cy="130" r="37" fill="none" stroke="#FFFFFF" stroke-width=".8" opacity=".55" />
      {/* the diamond ring: the first bead of sunlight at the Moon's edge */}
      <circle cx="157" cy="105" r="3.2" fill="#FFFFFF" />
      <path d="M157 91 L158.6 103.4 L171 105 L158.6 106.6 L157 119 L155.4 106.6 L143 105 L155.4 103.4 Z" fill="#FFFFFF" opacity=".85" />
    </svg>
