---
// CustomerGallery — a continuous, seamless auto-scrolling wall of real Kemet
// guests. Uniform square photographs (identical 680x680 crop) drift at a
// slow, even pace; the full set is rendered twice so the loop is infinite
// with no gaps. Pure CSS motion (one GPU transform), paused on hover, frozen
// under prefers-reduced-motion. No controls, no JS.
import SectionHeader from "@/components/SectionHeader.astro";
import { srcsetFor, SIZES } from "@/utils/images";
import { clientPhotos } from "@/data/clientPhotos";

interface Props {
  no?: string;
  eyebrow?: string;
}
const { no, eyebrow = "Our Travellers" } = Astro.props;

const photos = clientPhotos;
---
<section class="cgal-sec">
  <div class="wrap">
    <SectionHeader sym="travellers" no={no} eyebrow={eyebrow} title="Real journeys, real joy"
      text="Not stock photography — our own guests, at the moments Egypt became theirs. From first mornings at the Great Pyramid to a wedding on the plateau, these are the journeys we design." />
  </div>

  <div class="cgal" role="img" aria-label="A continuous gallery of photographs of Kemet guests travelling across Egypt">
    <div class="cgal-track">
      {photos.map((p) => (
        <figure class="cgal-item"><img src={p.src} srcset={srcsetFor(p.src)} sizes={srcsetFor(p.src) ? SIZES.thumb : undefined} alt={p.alt} width="680" height="680" loading="lazy" decoding="async" /></figure>
      ))}
      {photos.map((p) => (
        <figure class="cgal-item" aria-hidden="true"><img src={p.src} srcset={srcsetFor(p.src)} sizes={srcsetFor(p.src) ? SIZES.thumb : undefined} alt="" width="680" height="680" loading="lazy" decoding="async" /></figure>
      ))}
    </div>
  </div>
  <div class="wrap cgal-more">
    <a class="more" href="/travellers.html">Our travellers, on film <span aria-hidden="true">→</span></a>
  </div>
</section>
