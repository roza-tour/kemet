---
// SymbolIcon — one of the gold glyphs, referenced rather than redrawn.
//
// The shape itself is defined once per page by SvgDefs as <symbol id="sym-…">;
// this emits an <svg> wrapping a <use>. It used to write the whole path data
// inline at every appearance, which on the FAQ meant 127 copies of 19 shapes —
// 53KB of one page, and 2.6MB across the site, all of it repetition.
//
// The outer <svg> keeps the viewBox, class and accessibility attributes, so
// nothing styling or reading these icons had to change.
//
// Usage: <SymbolIcon name="ankh" title="Ankh — key of life" />
import { GLYPHS } from "@/data/glyphs";
interface Props {
  /** Glyph key — see src/data/glyphs.ts. */
  name: string;
  /** Accessible label; when omitted the icon is decorative. */
  title?: string;
  class?: string;
}
const { name, title = "", class: className = "" } = Astro.props;
// Fail the build on a name that does not exist. The Greco-Roman identity
// asked for "column" while the glyph is keyed "greco", so it rendered an empty
// <svg> on nine pages — invisible, valid HTML, and silent for as long as it
// took to count the icons. A missing glyph is a typo, and a typo should stop
// the build, not ship a blank.
if (!Object.hasOwn(GLYPHS, name)) {
  throw new Error(`SymbolIcon: no glyph named "${name}". Known: ${Object.keys(GLYPHS).join(", ")}`);
}
---
<svg
    viewBox="0 0 100 100"
    class={className}
    role={title ? "img" : "presentation"}
    aria-hidden={title ? undefined : "true"}
    aria-label={title || undefined}
><use href={`#sym-${name}`} /></svg>
