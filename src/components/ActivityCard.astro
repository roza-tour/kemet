---
import type { Activity } from "@/types";
import Placeholder from "@/components/Placeholder.astro";

interface Props {
  activity: Activity;
  /** Link prefix back to the site root ("" at root, "../" in subfolders). */
  base?: string;
}
const { activity, base = "" } = Astro.props;
// Activities with a slug have a detail page; any without stay as plain cards.
const href = activity.slug ? `${base}activities/${activity.slug}.html` : undefined;
const Tag = href ? "a" : "article";
---
<Tag
  class="jcard reveal"
  data-tilt
  href={href}
  aria-label={href ? `${activity.title} — ${activity.place}` : undefined}
>
  <div style="position:relative">
    <span class="tag">{activity.place}</span>
    <Placeholder
      label={activity.title}
      src={activity.image?.src}
      alt={activity.image?.alt}
      width={activity.image?.width}
      height={activity.image?.height}
    />
  </div>
  <div class="body">
    <h3>{activity.title}</h3>
    <div class="route">{activity.place}</div>
    <p>{activity.blurb}</p>
    {href && (
      <div class="meta">
        <span class="route" style="margin:0">Explore</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
    )}
  </div>
</Tag>
