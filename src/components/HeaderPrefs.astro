---
// HeaderPrefs — language and currency, in the header, on every page.
//
// LANGUAGE: the same links as LangSwitch (the footer one), now where a
// visitor looks first. On a translated page each entry opens THIS page in that
// language; on an untranslated page it opens that language's home page, with
// no hreflang — those are navigation, not alternates (see LangSwitch).
// Links only: nothing switches language on its own.
//
// CURRENCY: prices are set in euros and stay in euros. Choosing another
// currency adds an approximate figure under each price marked data-eur; the
// choice is remembered on this device only (Base.astro runs it). Rates live
// in config/site.ts (FX).
//
// Both panels are <details>, so they open and close without any script.
import { LOCALE_META, localeOfRoute, basePrefixFor } from "@/config/i18n";
import { allAlternatesFor } from "@/config/alternates";
import { publicPath } from "@/utils/links";
import { CURRENCIES, FX } from "@/config/site";
import type { SiteLocale } from "@/config/i18n";

interface Props {
  /** Route file of the current page. */
  route: string;
  locale?: SiteLocale;
}
const { route, locale } = Astro.props;

const alternates = allAlternatesFor(route).filter((a) => a.hreflang !== "x-default");
const homes = allAlternatesFor("index.html").filter((a) => a.hreflang !== "x-default");
const isTranslated = alternates.length > 1;
const entries = isTranslated ? alternates : homes;
const current = (localeOfRoute(route) ?? locale ?? "en") as SiteLocale;
const base = basePrefixFor(route);

/** The word "Currency" and the one-line rate note, in the page's language. */
const WORDS: Record<SiteLocale, { currency: string; note: string }> = {
  en: { currency: "Currency", note: "Prices are in euros. Other currencies are approximate." },
  de: { currency: "Währung", note: "Preise in Euro. Andere Währungen sind Richtwerte." },
  it: { currency: "Valuta", note: "Prezzi in euro. Le altre valute sono indicative." },
  es: { currency: "Moneda", note: "Precios en euros. Las demás monedas son orientativas." },
  fr: { currency: "Devise", note: "Prix en euros. Les autres devises sont indicatives." },
  ru: { currency: "Валюта", note: "Цены в евро. Другие валюты указаны ориентировочно." },
  id: { currency: "Mata uang", note: "Harga dalam euro. Mata uang lain hanya perkiraan." },
  ms: { currency: "Mata wang", note: "Harga dalam euro. Mata wang lain hanyalah anggaran." },
  pt: { currency: "Moeda", note: "Preços em euros. As outras moedas são aproximadas." },
  ar: { currency: "العملة", note: "الأسعار باليورو، والعملات الأخرى تقريبية." },
};
const w = WORDS[current] ?? WORDS.en;
const fxData = JSON.stringify(Object.fromEntries(CURRENCIES.filter((c) => c.code !== "EUR").map((c) => [c.code, FX[c.code as keyof typeof FX]])));
const symData = JSON.stringify(Object.fromEntries(CURRENCIES.map((c) => [c.code, c.symbol])));
---
<div class="hprefs">
  {entries.length > 1 && (
    <details class="hp hp-lang">
      <summary aria-label={LOCALE_META[current].language}><span>{LOCALE_META[current].short}</span></summary>
      <div class="hp-panel">
        <ul>
          {entries.map((a) => {
            const loc = a.hreflang as SiteLocale;
            const own = loc === current;
            return (
              <li>
                <a
                  href={`${base}${publicPath(a.route)}` || "/"}
                  hreflang={isTranslated ? a.hreflang : undefined}
                  lang={a.hreflang}
                  class={own ? "is-current" : undefined}
                  aria-current={own && isTranslated ? "true" : undefined}
                ><span>{LOCALE_META[loc].endonym}</span><b>{LOCALE_META[loc].short}</b></a>
              </li>
            );
          })}
        </ul>
      </div>
    </details>
  )}
  {entries.length > 1 && <span class="hp-sep" aria-hidden="true"></span>}
  <details class="hp hp-cur" data-fx={fxData} data-sym={symData}>
    <summary aria-label={w.currency}><span data-cur-label>EUR</span></summary>
    <div class="hp-panel">
      <ul>
        {CURRENCIES.map((c) => (
          <li><button type="button" data-cur={c.code} aria-pressed={c.code === "EUR" ? "true" : "false"}><span>{c.code}</span><b>{c.symbol}</b></button></li>
        ))}
      </ul>
      <p class="hp-note">{w.note}</p>
    </div>
  </details>
</div>

<style is:global>
  /* Language, currency and Contact are each drawn as a CARTOUCHE — the ring
     that encloses a royal name: an oval with elongated ends (not a pill), a gold
     hairline, a dark gap and a second fainter hairline inside, and the knotted
     tie bar standing across one end. The bar sits at the inline end, so on
     Arabic pages it moves to the left with the reading direction. */
  .nav-end { display: flex; align-items: center; gap: 18px; }
  .hprefs, .nav-end .nav-cta { --c-h: 38px; position: relative; isolation: isolate; height: var(--c-h);
    margin-inline-end: 3px; border-radius: 30px / 50%; }
  .hprefs { display: flex; align-items: center; padding: 0 10px; border: 1px solid rgba(217,180,90,.62);
    background: radial-gradient(120% 140% at 50% 0%, rgba(217,180,90,.16), rgba(217,180,90,.02) 65%);
    box-shadow: inset 0 0 0 2px rgba(11,9,7,.55), inset 0 0 0 3px rgba(217,180,90,.38), 0 10px 26px -16px rgba(217,180,90,.55);
    transition: border-color .4s, box-shadow .4s; }
  .hprefs:hover, .hprefs:focus-within { border-color: var(--gold-bright);
    box-shadow: inset 0 0 0 2px rgba(11,9,7,.55), inset 0 0 0 3px rgba(217,180,90,.55), 0 0 22px -6px rgba(217,180,90,.6); }
  /* The tie bar. */
  .hprefs::after, .nav-end .nav-cta::after { content: ""; position: absolute; inset-inline-end: -3px; top: -5px; bottom: -5px;
    width: 4px; border-radius: 1px; pointer-events: none;
    background: linear-gradient(180deg, #F7E6AE, #D9B45A 45%, #9C7A2E);
    box-shadow: 0 0 0 1px rgba(11,9,7,.85), 0 0 10px rgba(217,180,90,.45); }

  /* Contact: the same cartouche, the word itself in gold. */
  .nav-end .nav-cta { display: inline-flex; align-items: center; padding: 0 22px; border: 0; background: none;
    font-family: var(--ff-display); font-size: .82rem; font-weight: 400; letter-spacing: .26em; text-transform: uppercase;
    color: #E9CF85; transition: color .4s; }
  .nav-end .nav-cta::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    border: 1px solid rgba(217,180,90,.62);
    background: radial-gradient(120% 140% at 50% 0%, rgba(217,180,90,.16), rgba(217,180,90,.02) 65%);
    box-shadow: inset 0 0 0 2px rgba(11,9,7,.55), inset 0 0 0 3px rgba(217,180,90,.38), 0 10px 26px -16px rgba(217,180,90,.55);
    transition: background .4s, box-shadow .4s, border-color .4s; }
  /* Hover fills the ring with gold, as a name cut in gold leaf. */
  .nav-end .nav-cta:hover, .nav-end .nav-cta:focus-visible { color: #1A140C; background: none; }
  .nav-end .nav-cta:hover::before, .nav-end .nav-cta:focus-visible::before { border-color: #F7E6AE;
    background: linear-gradient(180deg, #F7E6AE, #D9B45A 55%, #B8955A);
    box-shadow: inset 0 0 0 3px rgba(247,230,174,.0), inset 0 0 0 4px rgba(26,20,12,.35), 0 0 24px -6px rgba(217,180,90,.7); }
  .nav-end .nav-cta:focus-visible { outline: 2px solid rgba(247,230,174,.6); outline-offset: 4px; }

  .hp-sep { width: 5px; height: 5px; flex: none; transform: rotate(45deg);
    background: linear-gradient(135deg, #F7E6AE, #B8955A); box-shadow: 0 0 6px rgba(217,180,90,.6); }
  .hp { position: relative; }
  .hp > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 7px;
    height: 36px; padding: 0 11px; white-space: nowrap;
    font-family: var(--ff-display); font-size: .9rem; font-weight: 400; letter-spacing: .16em; }
  .hp > summary span { background: linear-gradient(180deg, #F7E6AE 10%, #D9B45A 60%, #A8862F);
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hp > summary::-webkit-details-marker { display: none; }
  .hp > summary::after { content: ""; width: 4px; height: 4px; border-right: 1px solid var(--gold);
    border-bottom: 1px solid var(--gold); transform: rotate(45deg) translate(-1px, -1px); opacity: .75;
    transition: transform .3s; }
  .hp[open] > summary::after { transform: rotate(-135deg) translate(-1px, -1px); }
  .hp > summary:focus-visible { outline: 2px solid rgba(247,230,174,.6); outline-offset: 2px; border-radius: 999px; }

  .hp-panel { position: absolute; top: calc(100% + 14px); inset-inline-end: -14px; z-index: 130; min-width: 230px;
    background: linear-gradient(180deg, rgba(20,16,11,.985), rgba(11,9,7,.985));
    border: 1px solid rgba(217,180,90,.32); border-radius: 3px;
    box-shadow: 0 30px 70px -28px rgba(0,0,0,.95), inset 0 0 0 1px rgba(11,9,7,.9), inset 0 0 0 2px rgba(217,180,90,.08);
    padding: 18px 0 10px; }
  /* A gold rule across the top with a lozenge at its centre. */
  .hp-panel::before { content: ""; position: absolute; top: 8px; left: 18px; right: 18px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(217,180,90,.7), transparent); }
  .hp-panel::after { content: ""; position: absolute; top: 5px; left: calc(50% - 3.5px); width: 7px; height: 7px;
    transform: rotate(45deg); background: #0B0907; border: 1px solid rgba(217,180,90,.8); }
  .hp-panel ul { list-style: none; margin: 0; padding: 0; }
  .hp-panel a, .hp-panel button { display: flex; align-items: baseline; justify-content: space-between; gap: 18px;
    width: 100%; padding: 8px 20px; background: none; border: 0; cursor: pointer; text-align: start;
    color: var(--bone); font-family: var(--ff-display); font-size: 1rem; font-weight: 300; letter-spacing: .01em;
    text-transform: none; white-space: nowrap; transition: background .25s, color .25s; }
  .hp-panel a::after { display: none; }
  .hp-panel b { font-family: var(--ff-body); font-weight: 400; color: var(--gold); letter-spacing: .2em; font-size: var(--t-nano);
    direction: ltr; unicode-bidi: isolate; } /* "US$" stays "US$" on Arabic pages */
  .hp-panel a:hover, .hp-panel button:hover { background: linear-gradient(90deg, rgba(217,180,90,.12), transparent); color: var(--gold-bright); }
  .hp-panel .is-current, .hp-panel [aria-pressed="true"] { color: var(--gold-bright); }
  .hp-panel .is-current span::before, .hp-panel [aria-pressed="true"] span::before { content: ""; display: inline-block;
    width: 5px; height: 5px; margin-inline-end: 9px; transform: rotate(45deg) translateY(-2px); background: var(--gold); }
  .hp-cur .hp-panel ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: 4px; }
  .hp-cur .hp-panel button { font-family: var(--ff-body); font-size: var(--t-tiny); letter-spacing: .14em; padding: 8px 18px; }
  .hp-cur .hp-panel button b { letter-spacing: .06em; font-size: var(--t-micro); }
  .hp-note { margin: 10px 20px 2px; padding-top: 10px; border-top: 1px solid rgba(217,180,90,.18);
    font-size: var(--t-nano); line-height: 1.55; color: var(--muted-2); white-space: normal; max-width: 250px; font-style: italic; }

  /* Laptop widths: the bar carries four menus, the search and these controls,
     so everything tightens a notch before the burger takes over. */
  @media (max-width: 1320px) and (min-width: 1081px) {
    .hp > summary { padding: 0 8px; letter-spacing: .12em; }
    .hprefs { padding: 0 7px; }
    .nav-end { gap: 14px; }
    .nav-end .nav-cta { padding: 0 16px; letter-spacing: .2em; }
  }
  @media (max-width: 1080px) {
    .nav-end { margin-inline-start: auto; gap: 14px; }
    .nav-end .nav-cta { margin-left: 0; margin-inline-end: 10px; padding: 0 16px; letter-spacing: .2em; }
  }
  @media (max-width: 420px) {
    .nav-end { gap: 11px; }
    .hprefs, .nav-end .nav-cta { --c-h: 34px; border-radius: 22px / 50%; margin-inline-end: 4px; }
    .hprefs { padding: 0 4px; }
    .hprefs::after, .nav-end .nav-cta::after { inset-inline-end: -2px; top: -4px; bottom: -4px; width: 3px; }
    .hp > summary { height: 32px; padding: 0 6px; gap: 4px; font-size: .8rem; letter-spacing: .08em; }
    .nav-end .nav-cta { padding: 0 11px; font-size: .7rem; letter-spacing: .12em; margin-inline-end: 8px; }
    .hp-panel { position: fixed; top: 76px; inset-inline: 12px; min-width: 0; }
  }
</style>
