---
// FilmRow — our own footage, in a row of its own.
//
// Never inside a photo gallery: a gallery advances on its own on a phone and
// a film must not slide away while it plays, and a film tile among photos
// read as one more photograph until somebody noticed the controls.
//
// The films sit side by side at the SAME HEIGHT whatever their shape — each
// one's share of the row is its own width-to-height ratio, so a phone-shot
// vertical film and a landscape one line up top and bottom without either
// being cropped. On a phone they stack, and a vertical film is held to a
// width that leaves the page around it.
//
// preload="none": nothing but the poster is fetched until play is pressed,
// so a page with three films costs three small posters.
import type { Film } from "@/types/primitives";

interface Props {
  films: Film[];
}
const { films } = Astro.props;
---
<div class="films">
  {films.map((f) => (
    <figure class="film" style={`--ar:${f.width}/${f.height};flex-grow:${(f.width / f.height).toFixed(4)}`} data-tall={f.height > f.width ? "" : undefined}>
      <div class="film-frame">
        <video
          controls
          playsinline
          preload="none"
          poster={f.poster}
          width={f.width}
          height={f.height}
          aria-label={f.alt}
        >
          <source src={f.src} type="video/mp4" />
        </video>
      </div>
      <figcaption>{f.label}</figcaption>
    </figure>
  ))}
</div>

<style>
  .films { display: flex; gap: var(--s-4); align-items: flex-start; }
  .film { margin: 0; flex-basis: 0; min-width: 0; }
  .film-frame {
    position: relative; aspect-ratio: var(--ar); overflow: hidden;
    border: 1px solid var(--line-2); border-radius: 2px;
    background: linear-gradient(150deg, #1A1510, #0C0F13);
    box-shadow: 0 18px 40px -28px rgba(0, 0, 0, .75);
  }
  .film video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .film figcaption {
    margin-top: var(--s-2);
    font-size: var(--t-nano); letter-spacing: .24em; text-transform: uppercase; color: var(--muted-2);
  }
  @media (max-width: 680px) {
    .films { flex-direction: column; align-items: stretch; }
    .film { flex-basis: auto; }
    .film[data-tall] { width: min(100%, 300px); margin-inline: auto; }
  }
</style>
