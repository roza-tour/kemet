---
// ContactForm — the direct "Message us" form on contact.html.
// Posts to /contact-handler.php (public/contact-handler.php), which delivers
// to the site mailbox via the cPanel server. Success/failure comes back as
// ?sent=1|0#message-us and is shown by the small inline script below.
import type { LandingFormLabels } from "@/types";

interface Props {
  heading?: string;
  subtext?: string;
  /**
   * Where a NO-JAVASCRIPT submit should land. The handler redirects to
   * /contact.html by default, which is right when the form IS the contact
   * page and wrong everywhere else — a visitor who sends an enquiry from a
   * campaign page and is dropped onto a different page has lost the thread,
   * and the enquiry they can no longer see is the one they send again. Posted
   * as a field and re-checked against a strict pattern server-side; see
   * contact-handler.php.
   */
  returnTo?: string;
  /**
   * What the visitor was looking at, written into the email. The handler
   * already works out how someone found the site from the server's own
   * analytics trail, but that trail is empty for anyone whose browser blocks
   * the script — and on a page carrying ad spend, "which page produced this
   * enquiry" is the question the money depends on. Stated by the page itself,
   * it is always there.
   */
  context?: string;
  /** Placeholders worth tailoring when the page is about specific dates. */
  datesPlaceholder?: string;
  messagePlaceholder?: string;
  /**
   * Every label, option and button, for a page that is not in English. The
   * default below is the English contact page's own wording, so nothing
   * changes where this prop is not passed. The select VALUES are fixed
   * English keys either way — contact-handler.php re-checks them and writes
   * the enquiry to the inbox in English whichever language it was sent in.
   */
  labels?: LandingFormLabels;
}
const EN: LandingFormLabels = {
  nameLabel: "Your name *",
  emailLabel: "Email *",
  phoneLabel: "Phone / WhatsApp",
  datesLabel: "Travel dates",
  messageLabel: "Your message *",
  partyLabel: "Who is travelling",
  paceLabel: "Pace",
  priorityLabel: "What matters more",
  chooseLabel: "Choose, if you like",
  partyOptions: [
    "Two of us",
    "A family with children",
    "Three generations, or older travellers",
    "A private group",
    "Just me",
  ],
  paceOptions: [
    "Unhurried — late starts, fewer sites a day",
    "Balanced",
    "Full days — as much as we can see",
  ],
  priorityOptions: [
    "Comfort first",
    "A balance of comfort and cost",
    "Keeping the cost down",
  ],
  submit: "Send message",
  sending: "Sending…",
  okNote: "Thank you — your message has been sent. We will reply within one business day.",
  errNote:
    "Something went wrong and the message was not sent. Please check your name, email and message — or write to us on WhatsApp instead.",
  honeypotLabel: "Website",
};

const {
  heading = "Send us a message",
  subtext = "Write to us directly — your message lands in our inbox and we reply within one business day.",
  returnTo,
  context,
  datesPlaceholder = "e.g. 10–20 October, flexible",
  messagePlaceholder = "Tell us where you want to go and what you would love to see.",
  labels,
} = Astro.props;

const t = labels ?? EN;

// The option VALUES, in the order their labels are given. Fixed English keys,
// never translated: contact-handler.php accepts only these and maps them back
// to English words for the email, so a German enquiry still reads correctly
// in an inbox nobody reads German in.
const PARTY_VALUES = ["couple", "family", "generations", "group", "solo"] as const;
const PACE_VALUES = ["unhurried", "balanced", "full"] as const;
const PRIORITY_VALUES = ["comfort", "balance", "cost"] as const;
---
<div class="enq-panel reveal" id="message-us">
  <div class="enq-head">
    <h2>{heading}</h2>
    {subtext && <p>{subtext}</p>}
  </div>

  {/* role/aria-live so the outcome is announced. A visually-revealed <div>
      tells a sighted visitor the message was sent and tells a screen-reader
      user nothing at all. */}
  <div class="cform-note cform-note--ok" role="status" aria-live="polite" hidden>{t.okNote}</div>
  <div class="cform-note cform-note--err" role="alert" hidden>{t.errNote}</div>

  <form class="cform" method="post" action="/contact-handler.php">
    {/* Honeypot — hidden from humans, bots fill it and get silently dropped. */}
    <label class="cform-hp" aria-hidden="true">
      {t.honeypotLabel}
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    {/* Filled in by the page's own script at the moment of sending: seconds
        the visitor spent on the page. A bot posting straight to the handler
        never runs the script, so it arrives empty — see contact-handler.php. */}
    <input type="hidden" name="kt" value="" />
    {returnTo && <input type="hidden" name="return" value={returnTo} />}
    {context && <input type="hidden" name="context" value={context} />}
    {/* The Google Ads click id, parked in sessionStorage by GoogleTag.astro
        when the visitor arrived and filled in below at send time. It reaches
        the enquiry email only, so that a booking which closes six weeks later
        can still be uploaded against the click that paid for it. */}
    <input type="hidden" name="gclid" value="" />

    <div class="cform-grid">
      <label>
        <span>{t.nameLabel}</span>
        <input type="text" name="name" required maxlength="120" autocomplete="name" />
      </label>
      <label>
        <span>{t.emailLabel}</span>
        <input type="email" name="email" required maxlength="200" autocomplete="email" />
      </label>
      <label>
        <span>{t.phoneLabel}</span>
        <input type="tel" name="phone" maxlength="40" autocomplete="tel" />
      </label>
      <label>
        <span>{t.datesLabel}</span>
        <input type="text" name="dates" maxlength="120" placeholder={datesPlaceholder} />
      </label>
      {/* Three optional questions that decide the shape of a reply: who the
          journey has to suit, how fast it can go, and whether comfort or cost
          leads. The last one is the one this business is built around — a
          traveller who answers "comfort first" is quoted the flight version
          and the late starts before they have to ask. The values are fixed and
          re-checked by contact-handler.php, which ignores anything else. */}
      <label>
        <span>{t.partyLabel}</span>
        <select name="party">
          <option value="">{t.chooseLabel}</option>
          {PARTY_VALUES.map((v, i) => <option value={v}>{t.partyOptions[i]}</option>)}
        </select>
      </label>
      <label>
        <span>{t.paceLabel}</span>
        <select name="pace">
          <option value="">{t.chooseLabel}</option>
          {PACE_VALUES.map((v, i) => <option value={v}>{t.paceOptions[i]}</option>)}
        </select>
      </label>
      <label class="cform-full">
        <span>{t.priorityLabel}</span>
        <select name="priority">
          <option value="">{t.chooseLabel}</option>
          {PRIORITY_VALUES.map((v, i) => <option value={v}>{t.priorityOptions[i]}</option>)}
        </select>
      </label>
      <label class="cform-full">
        <span>{t.messageLabel}</span>
        <textarea name="message" required rows="6" maxlength="5000" placeholder={messagePlaceholder}></textarea>
      </label>
    </div>

    {/* The "Sending…" label is read by the script below from this attribute,
        so the button's busy state is in the page's own language too. */}
    <button type="submit" class="btn btn-solid" data-sending={t.sending}>{t.submit}</button>
  </form>
</div>

<script is:inline>
  (function () {
    // Fallback path (no-JS submits land back here with ?sent=1|0).
    // The analytics layer (scripts/enhance) counts enquiries from this event.
    // It is dispatched from the paths that KNOW the outcome — never from the
    // submit handler, which fires before the server has answered and would
    // have counted every failed send as a conversion.
    var report = function (ok) {
      document.dispatchEvent(new CustomEvent("kemet:enquiry", { detail: { ok: ok } }));
    };

    var sent = new URLSearchParams(location.search).get("sent");
    if (sent !== null) {
      report(sent === "1");
      var note = document.querySelector(sent === "1" ? ".cform-note--ok" : ".cform-note--err");
      if (note) note.hidden = false;
      if (sent === "1") { var f0 = document.querySelector(".cform"); if (f0) f0.reset(); }
      var target = document.getElementById("message-us");
      if (target) target.scrollIntoView({ block: "start" });
    }

    // Time on the page, written into the hidden field as the form is sent.
    // Registered before the enhanced handler below so FormData picks it up;
    // it also runs on a plain submit when fetch is unavailable.
    var t0 = Date.now();
    var fk = document.querySelector(".cform");
    if (fk && fk.kt) fk.addEventListener("submit", function () {
      fk.kt.value = String(Math.round((Date.now() - t0) / 1000));
      // Same moment, same reason: both paths below pick it up from the field.
      try {
        var gid = sessionStorage.getItem("kemet_gclid");
        if (gid && fk.gclid) fk.gclid.value = gid;
      } catch (e) {}
    });

    // Enhanced path — submit in place, no page reload.
    var form = document.querySelector(".cform");
    if (!form || !window.fetch) return;
    var ok = document.querySelector(".cform-note--ok");
    var err = document.querySelector(".cform-note--err");
    var btn = form.querySelector('button[type="submit"]');
    var btnLabel = btn ? btn.textContent : "";

    // Gentle live validation: mark a required field once the visitor leaves it.
    form.querySelectorAll("input[required], textarea[required], input[type=email]").forEach(function (el) {
      el.addEventListener("blur", function () {
        el.classList.toggle("cform-bad", !el.checkValidity() && el.value !== "");
      });
      el.addEventListener("input", function () { el.classList.remove("cform-bad"); });
    });

    form.addEventListener("submit", function (ev) {
      if (!form.checkValidity()) return;      // let the browser show its message
      ev.preventDefault();
      if (btn) { btn.disabled = true; btn.textContent = btn.dataset.sending || "Sending…"; }
      if (ok) ok.hidden = true; if (err) err.hidden = true;

      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { "X-Requested-With": "fetch" },
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          report(!!(d && d.ok));
          if (d && d.ok) {
            form.reset();
            if (ok) { ok.hidden = false; ok.scrollIntoView({ block: "center", behavior: "smooth" }); }
          } else if (err) { err.hidden = false; err.scrollIntoView({ block: "center", behavior: "smooth" }); }
        })
        .catch(function () {
          // Network hiccup — fall back to the classic full-page submit.
          form.removeAttribute("data-enhanced");
          form.submit();
        })
        .finally(function () {
          if (btn) { btn.disabled = false; btn.textContent = btnLabel; }
        });
    });
  })();
</script>

<style>
  .cform input.cform-bad, .cform textarea.cform-bad {
    border-color: #C0564A !important;
    box-shadow: 0 0 0 1px rgba(192, 86, 74, .35);
  }
  .cform button[disabled] { opacity: .65; cursor: wait; }
</style>
