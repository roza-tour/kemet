---
// AccessInvite — the one interruption on the site, and what it is allowed to say.
//
// WHY IT IS NOT A DISCOUNT
// The obvious version of this is "sign up and get 10% off". It was asked for
// and it is the wrong mechanic for this business. The site states, in its own
// words, that it is not the cheapest and does not quote low to recover the
// difference later; a discount on the first screen contradicts that, tells the
// visitor the published price has slack in it, and teaches them to negotiate
// before they have seen what they are buying. Worse, it selects for the
// price-sensitive — the opposite of the traveller this brand is written for.
//
// What is offered instead is the thing this business genuinely has and cannot
// manufacture more of: ACCESS. The sun reaches the sanctuary at Abu Simbel on
// two mornings a year. Christmas and New Year on the river is one set of
// cabins. The dahabiya is a handful of weeks. First notice of those is worth
// more to the right traveller than money off, and it costs nothing to give.
//
// WHEN IT APPEARS
// Once. On the way out (desktop) or past the middle of a page (touch, where
// there is no exit intent), never before 20 seconds, and never on the legal or
// contact pages where a visitor is already mid-task. Dismissing it or joining
// puts it away for good on that device.
import { site } from "@/config/site";
---
<div class="ainv" id="access-invite" hidden aria-hidden="true">
  <div class="ainv-scrim" data-close></div>
  <div class="ainv-box" role="dialog" aria-modal="true" aria-labelledby="ainv-h" aria-describedby="ainv-p">
    <button type="button" class="ainv-x" data-close aria-label="Close">×</button>

    <div class="eyebrow">By invitation</div>
    <h2 id="ainv-h">The dates that run out</h2>
    <p id="ainv-p">
      The sun reaches the inner sanctuary at Abu Simbel on two mornings a year.
      Christmas and New Year on the Nile is one set of cabins. The dahabiya is a
      handful of weeks. We write when those open — and when the season turns in
      Egypt. A few times a year, never more.
    </p>

    <form class="ainv-form" id="ainv-form" method="post" action="/subscribe.php" novalidate>
      <input type="hidden" name="source" value="invite" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="ainv-hp" />

      <label class="ainv-field">
        <span class="ainv-label">Your email address</span>
        <input type="email" name="email" required autocomplete="email"
               placeholder="you@example.com" inputmode="email" />
      </label>

      <label class="ainv-consent">
        <input type="checkbox" name="consent" value="1" required />
        <span>Yes — send me seasonal notes and first notice of limited dates.
              I can unsubscribe at any time.</span>
      </label>

      <button type="submit" class="btn btn-solid ainv-go">Keep me posted</button>
      <p class="ainv-fine" id="ainv-msg" role="status" aria-live="polite">
        No offers, no forwarding your address. <a href="/privacy.html">How we handle it</a>.
      </p>
    </form>
  </div>
</div>

<script is:inline define:vars={{ wa: site.whatsapp }}>
  (function () {
    var KEY = "kemet-invite-v1";
    var root = document.getElementById("access-invite");
    if (!root) return;

    // Never interrupt a visitor who is already in a transaction or reading the
    // terms — and never on a page reached from an email we sent.
    var path = location.pathname;
    if (/(contact|booking|privacy|terms|unsubscribe)/.test(path)) return;
    try { if (localStorage.getItem(KEY)) return; } catch (e) { return; }

    var opened = false, lastFocus = null;

    function remember() { try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} }

    function open() {
      if (opened) return;
      opened = true;
      lastFocus = document.activeElement;
      root.hidden = false;
      root.setAttribute("aria-hidden", "false");
      requestAnimationFrame(function () { root.classList.add("is-open"); });
      var f = root.querySelector('input[type="email"]');
      if (f) setTimeout(function () { f.focus(); }, 420);
      detach();
    }

    function close() {
      root.classList.remove("is-open");
      root.setAttribute("aria-hidden", "true");
      setTimeout(function () { root.hidden = true; }, 300);
      remember();
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    root.addEventListener("click", function (e) {
      if (e.target.closest("[data-close]")) { e.preventDefault(); close(); }
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && opened && !root.hidden) close();
      // Keep the tab ring inside the dialog while it is open.
      if (e.key === "Tab" && opened && !root.hidden) {
        var f = root.querySelectorAll('button, input, a[href]');
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // --- What opens it ------------------------------------------------------
    var armed = false;
    var onOut = function (e) { if (armed && e.clientY <= 0) open(); };
    var onScroll = function () {
      if (!armed) return;
      var d = document.documentElement;
      var pct = (scrollY + innerHeight) / Math.max(d.scrollHeight, 1);
      if (pct > 0.55) open();
    };
    function detach() {
      document.removeEventListener("mouseout", onOut);
      removeEventListener("scroll", onScroll);
    }
    // Twenty seconds before anything can fire: long enough that it never lands
    // on someone who has just arrived and is still deciding where they are.
    setTimeout(function () {
      armed = true;
      document.addEventListener("mouseout", onOut);
      addEventListener("scroll", onScroll, { passive: true });
    }, 20000);

    // --- Submitting ---------------------------------------------------------
    var form = document.getElementById("ainv-form");
    var msg = document.getElementById("ainv-msg");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var email = form.email.value.trim();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { msg.textContent = "That email address does not look right."; return; }
      if (!form.consent.checked) { msg.textContent = "Please tick the box so we know you want to hear from us."; return; }

      var btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.textContent = "Sending…";

      var body = new FormData(form);
      body.set("locale", document.documentElement.lang || "en");

      fetch(form.action, { method: "POST", body: body, headers: { "X-Requested-With": "fetch" } })
        .then(function (r) { return r.json(); })
        .catch(function () { return { ok: false }; })
        .then(function (r) {
          if (r && r.ok) {
            remember();
            form.innerHTML = '<p class="ainv-done">Thank you — you\'re on the list.<br>'
              + 'We\'ll write when the season turns, and first when the limited dates open.</p>';
          } else {
            btn.disabled = false; btn.textContent = "Keep me posted";
            msg.textContent = (r && r.message) ||
              "That didn't go through. Message us on WhatsApp and we'll add you by hand.";
          }
        });
    });
  })();
</script>

<style is:global>
  /* Inert until opened: hidden removes it from layout and paint entirely, so
     this costs nothing on a page where it never fires. */
  .ainv[hidden] { display: none !important; }
  .ainv { position: fixed; inset: 0; z-index: 300; display: flex;
    align-items: center; justify-content: center; padding: 24px; }
  .ainv-scrim { position: absolute; inset: 0; background: rgba(6,5,3,.78);
    backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    opacity: 0; transition: opacity .3s ease; }
  .ainv.is-open .ainv-scrim { opacity: 1; }

  .ainv-box { position: relative; width: min(520px, 100%); padding: 44px 44px 36px;
    border: 1px solid var(--line-2); border-radius: 2px;
    background: linear-gradient(165deg, rgba(30,25,18,.98), rgba(13,16,20,.98));
    box-shadow: 0 40px 100px -20px rgba(0,0,0,.75);
    opacity: 0; transform: translateY(14px); transition: opacity .4s ease, transform .4s cubic-bezier(.22,.61,.36,1); }
  .ainv.is-open .ainv-box { opacity: 1; transform: none; }

  .ainv-x { position: absolute; top: 6px; right: 6px; width: 44px; height: 44px;
    background: none; border: 0; color: var(--muted-2); font-size: 1.5rem;
    line-height: 1; cursor: pointer; transition: color .25s; }
  .ainv-x:hover { color: var(--gold-bright); }

  .ainv-box h2 { font-family: var(--ff-display); font-weight: 300;
    font-size: clamp(1.5rem, 3.4vw, 1.95rem); color: var(--bone); margin: 14px 0 14px; }
  .ainv-box > .eyebrow { font-size: .62rem; }
  .ainv-box p { color: var(--muted); font-size: .93rem; line-height: 1.8; margin: 0 0 24px; }

  .ainv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .ainv-label { display: block; font-size: .62rem; letter-spacing: .22em;
    text-transform: uppercase; color: var(--muted-2); margin-bottom: 9px; }
  .ainv-field input { width: 100%; padding: 15px 16px; background: rgba(255,255,255,.04);
    border: 1px solid var(--line-2); border-radius: 2px; color: var(--bone);
    font-family: var(--ff-body); font-size: .95rem; transition: border-color .3s; }
  .ainv-field input:focus { outline: none; border-color: var(--gold); }
  .ainv-field input::placeholder { color: var(--muted-2); opacity: .7; }

  .ainv-consent { display: flex; gap: 11px; align-items: flex-start; margin: 16px 0 20px;
    color: var(--muted); font-size: .82rem; line-height: 1.6; cursor: pointer; }
  .ainv-consent input { margin-top: 3px; width: 16px; height: 16px; flex: none; accent-color: var(--gold); }

  .ainv-go { width: 100%; text-align: center; }
  .ainv-fine { color: var(--muted-2); font-size: .76rem; line-height: 1.65;
    margin: 16px 0 0 !important; text-align: center; }
  .ainv-fine a { color: var(--muted); border-bottom: 1px solid var(--line-2); }
  .ainv-done { color: var(--gold-bright); font-size: .95rem; line-height: 1.85;
    text-align: center; margin: 0 !important; }

  @media (max-width: 520px) { .ainv-box { padding: 36px 24px 28px; } }
  @media (prefers-reduced-motion: reduce) {
    .ainv-scrim, .ainv-box { transition: none; }
  }
</style>
