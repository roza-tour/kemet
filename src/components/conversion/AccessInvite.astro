---
// AccessInvite — the one interruption on the site, and what it is allowed to say.
//
// WHY IT IS NOT A DISCOUNT
// The obvious version of this is "sign up and get 10% off". It was asked for
// and it is the wrong mechanic for this business. The site states, in its own
// words, that it is not the cheapest and does not quote low to recover the
// difference later; a discount on the first screen contradicts that, tells the
// visitor the published price has slack in it, and teaches them to negotiate
// before they have seen what they are buying. Worse, it selects for the
// price-sensitive — the opposite of the traveller this brand is written for.
//
// What is offered instead is the thing this business genuinely has and cannot
// manufacture more of: ACCESS. The sun reaches the sanctuary at Abu Simbel on
// two mornings a year. Christmas and New Year on the river is one set of
// cabins. The dahabiya is a handful of weeks. First notice of those is worth
// more to the right traveller than money off, and it costs nothing to give.
//
// WHEN IT APPEARS
// Once. On the way out (desktop) or past the middle of a page (touch, where
// there is no exit intent), never before 20 seconds, and never on the legal or
// contact pages where a visitor is already mid-task. Dismissing it or joining
// puts it away for good on that device.
import SymbolIcon from "@/components/SymbolIcon.astro";
---
<div class="ainv" id="access-invite" hidden aria-hidden="true">
  <div class="ainv-scrim" data-close></div>
  <div class="ainv-box" role="dialog" aria-modal="true" aria-labelledby="ainv-h" aria-describedby="ainv-p">
    {/* The inset gold rule is the hero's own frame (.hframe), brought down to
        this scale — the site's existing pharaonic furniture rather than a new
        decorative language invented for one dialog. */}
    <span class="ainv-frame" aria-hidden="true"></span>
    <button type="button" class="ainv-x" data-close aria-label="Close">×</button>

    {/* The sun, because the sun is literally the offer: the two mornings a year
        it reaches the sanctuary at Abu Simbel. */}
    <div class="ainv-sym" aria-hidden="true"><SymbolIcon name="sun" /></div>

    <div class="eyebrow">By invitation</div>
    <h2 id="ainv-h">The dates that run out</h2>

    <div class="ainv-frieze" aria-hidden="true">
      <SymbolIcon name="ankh" /><SymbolIcon name="lotus" /><SymbolIcon name="scarab" />
      <SymbolIcon name="lotus" /><SymbolIcon name="ankh" />
    </div>

    <p id="ainv-p">
      Two sunrises a year at Abu Simbel. One set of cabins at New Year.
      We write when they open.
    </p>

    <form class="ainv-form" id="ainv-form" method="post" action="/subscribe.php" novalidate>
      <input type="hidden" name="source" value="invite" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="ainv-hp" />

      <label class="ainv-field">
        <span class="ainv-label">Your email</span>
        <input type="email" name="email" required autocomplete="email"
               placeholder="you@example.com" inputmode="email" />
      </label>

      <label class="ainv-consent">
        <input type="checkbox" name="consent" value="1" required />
        <span>Yes — write to me. I can unsubscribe at any time.</span>
      </label>

      <button type="submit" class="btn btn-solid ainv-go">Keep me posted</button>
      <p class="ainv-fine" id="ainv-msg" role="status" aria-live="polite">
        A few times a year. <a href="/privacy.html">How we handle it</a>.
      </p>
    </form>
  </div>
</div>

<script>import "../../scripts/invite.client.js";</script>

<style is:global>
  /* Inert until opened: hidden removes it from layout and paint entirely, so
     this costs nothing on a page where it never fires. */
  .ainv[hidden] { display: none !important; }
  .ainv { position: fixed; inset: 0; z-index: 300; display: flex;
    align-items: center; justify-content: center; padding:var(--s-4); }
  .ainv-scrim { position: absolute; inset: 0; background: rgba(6,5,3,.78);
    backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px);
    opacity: 0; transition: opacity .3s ease; }
  .ainv.is-open .ainv-scrim { opacity: 1; }

  /* The box is a doorway, not a card: a narrow portrait, a heavier gold rule
     inset from the edge the way the hero frames its photograph, and everything
     centred on an axis. Egyptian design is symmetry and a border — not textures
     of sandstone, which on a dark screen only ever look like a stock image. */
  .ainv-box { position: relative; width: min(440px, 100%);
    padding:52px var(--s-6) var(--s-6); text-align: center;
    border: 1px solid var(--line-2); border-radius: 0;
    background:
      radial-gradient(420px 220px at 50% 0%, rgba(217,180,90,.09), transparent 70%),
      linear-gradient(165deg, rgba(32,26,18,.99), rgba(12,15,19,.99));
    box-shadow: 0 40px 100px -20px rgba(0,0,0,.8);
    opacity: 0; transform: translateY(14px);
    transition: opacity .4s ease, transform .4s cubic-bezier(.22,.61,.36,1); }
  .ainv.is-open .ainv-box { opacity: 1; transform: none; }

  /* The inset rule — the hero's .hframe at dialog scale. */
  .ainv-frame { position: absolute; inset: 9px; border: 1px solid rgba(217,180,90,.26);
    pointer-events: none; }

  .ainv-x { position: absolute; top: 2px; right: 2px; width: 44px; height: 44px;
    background: none; border: 0; color: var(--muted-2); font-size:var(--t-lg);
    line-height: 1; cursor: pointer; transition: color .25s; z-index: 2; }
  .ainv-x:hover { color: var(--gold-bright); }

  .ainv-sym { width: 46px; height: 52px; margin: 0 auto 22px;
    filter: drop-shadow(0 6px 18px rgba(217,180,90,.3)); }
  .ainv-sym svg { width: 100%; height: 100%; }

  .ainv-box > .eyebrow { font-size:var(--t-nano); letter-spacing: .38em; }
  .ainv-box h2 { font-family: var(--ff-display); font-weight: 300;
    font-size: clamp(1.55rem, 3.6vw, 1.95rem); color: var(--bone);
    margin:var(--s-2) 0 0; line-height: 1.22; }

  /* A five-glyph band, the site's frieze cut to the width of a dialog. */
  .ainv-frieze { display: flex; justify-content: center; align-items: center;
    gap:var(--s-4); margin:var(--s-4) 0; padding:var(--s-2) 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    background: linear-gradient(90deg, transparent, rgba(217,180,90,.05), transparent); }
  .ainv-frieze svg { width: 14px; height: 18px; flex: 0 0 auto; opacity: .45; }

  .ainv-box p { color: var(--muted); font-size:var(--t-sm); line-height: 1.85;
    margin: 0 auto 28px; max-width: 320px; }

  .ainv-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .ainv-label { display: block; font-size:var(--t-nano); letter-spacing: .24em;
    text-transform: uppercase; color: var(--muted-2); margin-bottom:var(--s-1); text-align: left; }
  .ainv-field input { width: 100%; padding:var(--s-2) var(--s-3); text-align: center; background: rgba(255,255,255,.04);
    border: 1px solid var(--line-2); border-radius: 2px; color: var(--bone);
    font-family: var(--ff-body); font-size:var(--t-sm); transition: border-color .3s; }
  .ainv-field input:focus { outline: none; border-color: var(--gold); }
  .ainv-field input::placeholder { color: var(--muted-2); opacity: .7; }

  .ainv-consent { display: flex; gap:var(--s-2); align-items: center; justify-content: center;
    margin:var(--s-3) 0 var(--s-3); color: var(--muted); font-size:var(--t-tiny); line-height: 1.6;
    cursor: pointer; text-align: left; }
  .ainv-consent input { width: 15px; height: 15px; flex: none; accent-color: var(--gold); }

  .ainv-go { width: 100%; text-align: center; }
  .ainv-fine { color: var(--muted-2); font-size:var(--t-tiny); line-height: 1.65;
    margin: 16px 0 0 !important; text-align: center; }
  .ainv-fine a { color: var(--muted); border-bottom: 1px solid var(--line-2); }
  .ainv-done { color: var(--gold-bright); font-size:var(--t-sm); line-height: 1.85;
    text-align: center; margin: 0 !important; }

  @media (max-width: 520px) {
    .ainv-box { padding:var(--s-6) var(--s-4) var(--s-5); }
    .ainv-frame { inset: 7px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ainv-scrim, .ainv-box { transition: none; }
  }
</style>
