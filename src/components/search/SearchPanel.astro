---
// SearchPanel — the results list for the search field in the nav.
//
// It is rendered here, at body level, rather than beside the input: results
// are links, and any link inside .navlinks inherits the nav's uppercase,
// letter-spacing and nowrap. The first version put the panel in the nav and
// every result came out in spaced capitals with its description clipped. So
// the panel lives outside the nav and is positioned under the field at runtime.
//
// COST DISCIPLINE. Nothing here loads on a normal page view: /search-index.json
// (18KB gzipped) is fetched the first time someone touches the field, then
// kept for the session. No third-party widget, no external request.
//
// It also answers a question the site could not answer before — what visitors
// are looking for. Every search is reported to the analytics layer, and a
// search that returns NOTHING is reported separately. That second list is the
// most direct statement of demand the site can produce: people saying, in
// their own words, what they came for and did not find.
---
<div class="sp" id="sp" hidden>
  <ul class="sres" id="sres" role="listbox" aria-label="Search results"></ul>
</div>

<script>import "../../scripts/search.client.js";</script>

<style is:global>
  .sp { position: fixed; z-index: 130; background: #14100B;
    border: 1px solid var(--line-2); box-shadow: 0 34px 80px -28px rgba(0,0,0,.92);
    max-height: 70vh; overflow-y: auto; }
  .sp[hidden] { display: none; }

  .sres { list-style: none; margin: 0; padding: 0; }
  .sres li + li { border-top: 1px solid rgba(217,180,90,.1); }
  .sres a { display: grid; grid-template-columns: 1fr auto; gap:2px var(--s-3);
    padding:var(--s-2) var(--s-3); transition: background .2s; }
  .sres a:hover, .sres li[aria-selected="true"] a { background: rgba(217,180,90,.07); }
  .sres-k { grid-column: 1; font-size: .55rem; letter-spacing: .26em;
    text-transform: uppercase; color: var(--gold); }
  .sres-m { grid-column: 2; grid-row: 1 / span 2; align-self: center; text-align: right;
    font-size:var(--t-micro); color: var(--muted-2); white-space: nowrap; }
  .sres-t { grid-column: 1; font-family: var(--ff-display); font-size:var(--t-base);
    color: var(--bone); line-height: 1.3; }
  .sres-d { grid-column: 1; font-size:var(--t-tiny); color: var(--muted); line-height: 1.55;
    margin-top: 3px; }
  .sres-none { padding:var(--s-3); color: var(--muted); font-size:var(--t-sm); line-height: 1.75; }
  .sres-none b { color: var(--bone); font-weight: 400; }
  .sres-none a { display: inline; padding: 0; color: var(--gold);
    border-bottom: 1px solid rgba(217,180,90,.4); }

  @media(max-width:680px){
    .sres a { grid-template-columns: 1fr; padding:var(--s-2) var(--s-3); }
    .sres-m { grid-column: 1; grid-row: auto; text-align: left; margin-top: 4px; }
  }
</style>
