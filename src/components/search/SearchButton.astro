---
// SearchButton — the trigger only.
//
// Kept apart from the panel on purpose. When the overlay markup lived inside
// .navlinks it inherited that block's `text-transform:uppercase`,
// `letter-spacing:.3em` and `white-space:nowrap`, so every result title
// rendered in spaced capitals and every description was clipped at the panel
// edge. The panel is now a sibling of the nav at body level, where nothing is
// inherited; only this small trigger sits in the navigation.
---
<a
  class="sbtn"
  href="/sitemap.html"
  id="sbtn"
  role="button"
  aria-label="Search the site"
  aria-haspopup="dialog"
>
  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="8.5" cy="8.5" r="5.6" fill="none" stroke="currentColor" stroke-width="1.5" />
    <line x1="12.7" y1="12.7" x2="17.4" y2="17.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span class="sbtn-label">Search</span>
</a>
