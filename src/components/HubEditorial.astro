---
// HubEditorial — the editorial body for a section hub.
//
// The five hubs were the thinnest pages on the site while competing for its
// broadest queries. This renders the argument, the numbered sections, an
// optional decision table and the FAQ, from one data record per hub.
import Frieze from "@/components/Frieze.astro";
import Faq from "@/components/Faq.astro";
import type { HubEditorial } from "@/data/hubs";

interface Props {
  hub: HubEditorial;
  /** FAQ block heading. */
  faqHeading?: string;
}
const { hub, faqHeading = "Questions, answered" } = Astro.props;
---
<section style="padding-top:0">
  <div class="wrap he-wrap">
    <Frieze />

    <div class="sec-head reveal">
      <div class="eyebrow">{hub.eyebrow}</div>
      <h2>{hub.heading}</h2>
      <div class="rule"></div>
    </div>

    <p class="he-lede reveal">{hub.lede}</p>

    <div class="he-sections">
      {hub.sections.map((s, i) => (
        <div class="he-sec reveal">
          <span class="he-n">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </div>
      ))}
    </div>

    {hub.table && (
      <div class="he-table-block reveal">
        <h3>{hub.table.heading}</h3>
        <p class="he-table-intro">{hub.table.intro}</p>
        <div class="he-scroll">
          <table class="he-table">
            <thead>
              <tr>{hub.table.columns.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {hub.table.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.value}</td>
                  <td class="he-note">{r.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <Frieze />

    <Faq items={hub.faqs} heading={faqHeading} />
  </div>
</section>

<style>
  .he-wrap { max-width: 940px; }
  .he-lede { font-family: var(--ff-display); font-weight: 300; font-size: 1.3rem;
    line-height: 1.68; color: var(--bone); margin: 0 0 34px; max-width: 820px; }

  .he-sec { display: grid; grid-template-columns: 58px 1fr; gap: 22px;
    padding: 26px 0; border-bottom: 1px solid var(--line); }
  .he-sec:last-child { border-bottom: 0; }
  .he-n { font-family: var(--ff-display); font-size: 1.7rem; color: var(--gold);
    line-height: 1.2; width: 58px; }
  .he-sec h3 { font-size: 1.24rem; color: var(--bone); margin: 0 0 10px; }
  .he-sec p { color: var(--muted); font-size: .96rem; line-height: 1.88; margin: 0; }

  .he-table-block { margin-top: 34px; }
  .he-table-block h3 { font-size: 1.35rem; color: var(--bone); margin: 0 0 8px; }
  .he-table-intro { color: var(--muted); font-size: .95rem; line-height: 1.75;
    margin: 0 0 20px; max-width: 720px; }
  /* Wide content scrolls inside its own box — the page body never scrolls sideways. */
  .he-scroll { overflow-x: auto; }
  .he-table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .he-table th, .he-table td { text-align: left; vertical-align: top;
    padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); }
  .he-table thead th { font-family: var(--ff-body); font-weight: 400; font-size: .64rem;
    letter-spacing: .26em; text-transform: uppercase; color: var(--gold);
    border-bottom-color: var(--line-2); }
  .he-table tbody th { font-weight: 400; color: var(--gold-bright);
    font-family: var(--ff-display); font-size: 1.02rem; white-space: nowrap; }
  .he-table td { color: var(--muted); font-size: .93rem; line-height: 1.7; }
  .he-table .he-note { color: var(--muted-2); font-size: .88rem; }

  @media(max-width:680px){
    .he-lede { font-size: 1.15rem; }
    /* Site-wide phone rule: the numeral sits above its heading so the copy
       returns to the page gutter. */
    .he-sec { display: block; padding: 22px 0; }
    .he-n { display: block; width: auto; font-size: 1.25rem; margin-bottom: 8px; }
    .he-table th, .he-table td { padding: 12px 14px 12px 0; }
  }
</style>
