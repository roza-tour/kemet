---
// Home hero — cinematic editorial: full-bleed photography, dark veil, inset
// hairline frame, H1, lede and actions. The old plaque lockup is retired.
//
// The words say what the journey IS, not the brand tagline. The tagline ("The
// Land. The Legacy. The Journey.") held this H1 until the dashboard showed the
// English home keeping a visitor 13 seconds, 21% of the way down, while the
// German home — which opens "no coach, no fixed departures, no strangers on
// your itinerary" — kept them over a minute. The tagline lives on in the
// footer and the ribbon. Same elements, same lengths: only the text changed.
import { site } from "@/config/site";
import { srcsetFor, SIZES } from "@/utils/images";
---
<header class="hero">
  <div class="bg">
    <img
      src="/images/giza/giza-great-pyramid-clear-sky.webp"
      srcset={srcsetFor("/images/giza/giza-great-pyramid-clear-sky.webp")}
      sizes={SIZES.full}
      alt="The Great Pyramid of Khufu on the Giza plateau against a clear desert sky"
      width="1600"
      height="1062"
      fetchpriority="high"
    />
  </div>
  <div class="veil" aria-hidden="true"></div>
  <div class="hframe" aria-hidden="true"></div>
  <div class="hero-inner wrap">
    <div class="kicker"><span class="kline" aria-hidden="true"></span><span class="eyebrow">{site.eyebrow}</span></div>
    <h1>Egypt, privately.<br /><em>At your pace.</em></h1>
    <p class="lede">
      No coach, no fixed departures, no strangers on your itinerary. Private
      journeys through Egypt — the Pyramids, Luxor, a Nile cruise to Aswan — with
      your own licensed Egyptologist and driver, 4- and 5-star hotels, and days paced
      around the heat. Every price in writing before you pay.
    </p>
    <div class="hero-actions">
      <a href="tours.html" class="btn btn-solid">Explore the Journeys</a>
      <a href="collections/egypt-at-an-easy-pace.html" class="btn btn-ghost">Egypt at an Easy Pace</a>
    </div>
  </div>
  <div class="hfoot" aria-hidden="true">
    <span>Est. Cairo — {site.meaning}</span>
    <span class="mid">Scroll<i></i></span>
    <span class="end">Tailor-made · Private · 4 &amp; 5-Star</span>
  </div>
</header>
