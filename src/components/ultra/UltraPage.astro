---
// Kemet Ultra — the top tier, in every language the site is published in.
// Rendered by src/pages/ultra-luxury-egypt.astro (English) and by one small
// route file per locale (src/pages/<locale>/<slug>.astro).
//
// THE DESIGN LANGUAGE
// Inherited whole from the former VIP page, which this replaces: an engraved
// invitation rather than a travel website — drawn ornament instead of boxes,
// metal instead of colour fields, cartouche frames with cut corners, a
// winged-sun crest, lotus dividers, and silk edges in crimson and emerald.
// Everything is scoped under .vip; nothing leaks to the other pages.
//
// WHY THIS PAGE NOW STATES PRICES, WHEN VIP DID NOT
// VIP described four programmes and quoted each per brief. A page at the top
// of the market that names no figure reads, to a person and to an answer
// engine alike, as a page with something to hide — and the engines filled the
// silence by describing another company's products under our name. These four
// journeys are built from priced components (see data/ultra/journeys.ts), so
// the figure is stated, per person, for two and for four. Anything beyond them
// is still arranged per brief, and the page says so.
import Base from "@/layouts/Base.astro";
import { srcsetFor, SIZES } from "@/utils/images";
import SymbolIcon from "@/components/SymbolIcon.astro";
import { ultraJourneys, PEAK, ULTRA_PER_DAY } from "@/data/ultra/journeys";
import type { UltraText } from "@/data/ultra/types";
import { answerPageSchema, ORG_ID } from "@/schemas/jsonld";

import { marketCountries } from "@/data/markets";
import { whatsappLink, mailtoLink, canonical } from "@/utils/links";
import { LOCALE_META, type SiteLocale } from "@/config/i18n";

interface Props {
  locale: SiteLocale;
  /** This page's route, e.g. "ultra-luxury-egypt.html" or "de/ultra-luxusreisen-aegypten.html". */
  route: string;
  text: UltraText;
}
const { locale, route, text: T } = Astro.props;
const meta = LOCALE_META[locale];

const money = new Intl.NumberFormat(meta.formatLocale, { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
const eur = (n: number) => money.format(n);
const p2 = ultraJourneys.map((j) => j.price2);
const p4 = ultraJourneys.map((j) => j.price4);
const figures = {
  from2: eur(Math.min(...p2)), to2: eur(Math.max(...p2)),
  from4: eur(Math.min(...p4)), to4: eur(Math.max(...p4)),
  perDayLow: eur(ULTRA_PER_DAY.low), perDayHigh: eur(ULTRA_PER_DAY.high),
  peak: PEAK,
};
const answer = T.answer(figures);
const faqs = T.faqs(figures);

const wa = whatsappLink(T.whatsapp);
const mail = mailtoLink(T.mailSubject, T.mailBody);
const stayName = (hotel: string) => (hotel === "Dahabiya" ? T.dahabiya : hotel);

const homeRoute = locale === "en" ? "index.html" : `${locale}/index.html`;
const pageUrl = canonical(route);

const jsonld: Record<string, unknown>[] = [
  { ...answerPageSchema({ route, name: T.metaTitle, description: T.metaDescription, question: T.question, answer }), inLanguage: meta.tag },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `Kemet Ultra — ${T.metaTitle.split("|")[0].trim()}`,
    serviceType: "Fully private, ultra-luxury travel in Egypt",
    provider: { "@id": ORG_ID },
    areaServed: { "@type": "Country", name: "Egypt" },
    url: pageUrl,
    inLanguage: meta.tag,
    audience: { "@type": "Audience", audienceType: "Travellers seeking fully private, exclusive-use luxury travel in Egypt", geographicArea: marketCountries() },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Kemet Ultra journeys",
      itemListElement: ultraJourneys.map((j) => {
        const jt = T.journeys[j.id];
        return {
          "@type": "Offer",
          url: `${pageUrl}#${j.id}`,
          price: j.price2,
          priceCurrency: "EUR",
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: j.price2,
            priceCurrency: "EUR",
            referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitText: "person (party of two)" },
          },
          availability: "https://schema.org/InStock",
          itemOffered: {
            "@type": "TouristTrip",
            name: jt.title,
            description: jt.kicker,
            touristType: "Luxury private travel",
            itinerary: {
              "@type": "ItemList",
              numberOfItems: jt.days.length,
              itemListElement: jt.days.map((d, i) => ({ "@type": "ListItem", position: i + 1, name: `${T.labels.day} ${i + 1}: ${d.t}`, description: d.d })),
            },
          },
        };
      }),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: meta.tag,
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: meta.home, item: canonical(homeRoute) },
      { "@type": "ListItem", position: 2, name: T.crumb, item: pageUrl },
    ],
  },
];
---
<Base
  title={T.metaTitle}
  description={T.metaDescription}
  active={route}
  jsonld={jsonld}
  keywords={T.keywords}
  showCta={false}
  ogImage="/images/luxor/luxor-karnak-hypostyle-hall.webp"
  ogImageAlt="The hypostyle hall of Karnak Temple in low light"
>
  <div class="vip">

    <svg class="vdefs" aria-hidden="true" focusable="false">
      {/* Winged sun — the crest. Two swept wings, a disk, twin uraei drops. */}
      <symbol id="v-wing" viewBox="0 0 340 72">
        <g fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="170" cy="30" r="15" fill="currentColor" fill-opacity=".14" />
          <circle cx="170" cy="30" r="15" />
          <circle cx="170" cy="30" r="9.5" />
          <path d="M153 32 C120 8 62 4 8 26 C60 22 96 30 128 44 C138 48 150 44 153 32 Z" />
          <path d="M150 36 C118 22 74 20 30 32" stroke-opacity=".55" />
          <path d="M146 41 C120 33 92 32 58 39" stroke-opacity=".35" />
          <path d="M187 32 C220 8 278 4 332 26 C280 22 244 30 212 44 C202 48 190 44 187 32 Z" />
          <path d="M190 36 C222 22 266 20 310 32" stroke-opacity=".55" />
          <path d="M194 41 C220 33 248 32 282 39" stroke-opacity=".35" />
          <path d="M162 46 q-3 10 2 18 M178 46 q3 10 -2 18" stroke-opacity=".8" />
        </g>
      </symbol>
      {/* Lotus divider — a bloom between two long hairlines. */}
      <symbol id="v-lotus" viewBox="0 0 480 40">
        <g fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M240 32 C232 22 230 12 240 4 C250 12 248 22 240 32 Z" />
          <path d="M240 32 C228 26 218 24 210 28 C220 14 230 12 236 14" stroke-opacity=".7" />
          <path d="M240 32 C252 26 262 24 270 28 C260 14 250 12 244 14" stroke-opacity=".7" />
          <path d="M0 32 H198" stroke-opacity=".5" />
          <path d="M282 32 H480" stroke-opacity=".5" />
          <path d="M198 32 l6 -4 6 4 -6 4 Z" fill="currentColor" stroke="none" />
          <path d="M270 32 l6 -4 6 4 -6 4 Z" fill="currentColor" stroke="none" />
        </g>
      </symbol>
    </svg>

    {/* ── Hero: engraved invitation over Karnak ─────────────────────────── */}
    <header class="vhero">
      <div class="vhero-bg" aria-hidden="true"></div>
      <div class="vhero-veil" aria-hidden="true"></div>
      <div class="vsheen" aria-hidden="true"></div>
      <div class="vcart" aria-hidden="true">
        <i class="vd vd-tl"></i><i class="vd vd-tr"></i>
        <i class="vd vd-bl"></i><i class="vd vd-br"></i>
      </div>
      <div class="wrap vhero-in">
        <svg class="vcrest" aria-hidden="true"><use href="#v-wing" /></svg>
        <p class="vtag"><span></span>{T.heroTag}<span></span></p>
        <h1>{T.h1[0]}<br /><em>{T.h1[1]}</em></h1>
        <svg class="vdiv" aria-hidden="true"><use href="#v-lotus" /></svg>
        <p class="vlede">{T.lede}</p>
        <div class="vhero-acts">
          <a href={wa} class="vbtn" target="_blank" rel="noopener"><span>{T.ctaPrimary}</span></a>
          <a href={mail} class="vlink-quiet">{T.ctaQuiet}</a>
        </div>
      </div>
      <div class="vband" aria-hidden="true"></div>
    </header>

    {/* ── The three facts, set as engraved medallions ───────────────────── */}
    <section class="vfacts">
      <div class="wrap vfacts-in">
        {T.facts.map(([head, sub], i) => (
          <div class="vfact">
            <span class="vmed" aria-hidden="true"><SymbolIcon name={["ankh", "sun", "eye"][i]} /></span>
            <b>{head}</b>
            <span class="vfact-sub">{sub}</span>
          </div>
        ))}
      </div>
    </section>

    {/* ── The answer, quotable on its own (speakable: .answer-box) ──────── */}
    <section class="answer-box vanswer">
      <div class="wrap">
        <div class="vanswer-in">
          <h2>{T.question}</h2>
          <p class="answer-body">{answer}</p>
        </div>
      </div>
    </section>

    {/* ── The journeys: framed plates with silk edges ───────────────────── */}
    <section class="vprogs">
      <div class="wrap">
        <div class="vhead">
          <p class="voverline"><span></span>{T.journeysOverline}<span></span></p>
          <h2>{T.journeysTitle[0]}<br />{T.journeysTitle[1]}</h2>
        </div>
      </div>

      {ultraJourneys.map((j, idx) => {
        const jt = T.journeys[j.id];
        return (
          <article class:list={["vplate", `is-${j.accent}`, idx % 2 === 1 && "is-flip"]} id={j.id}>
            <span class="vplate-ghost" aria-hidden="true">{j.numeral}</span>
            <div class="wrap vplate-in">
              <figure class="vframe">
                <span class="vframe-tick vt-tl" aria-hidden="true"></span>
                <span class="vframe-tick vt-tr" aria-hidden="true"></span>
                <span class="vframe-tick vt-bl" aria-hidden="true"></span>
                <span class="vframe-tick vt-br" aria-hidden="true"></span>
                <img src={j.image.src} srcset={srcsetFor(j.image.src)} sizes={srcsetFor(j.image.src) ? SIZES.beside : undefined}
                     alt={jt.title} width={j.image.width} height={j.image.height}
                     loading={idx === 0 ? "eager" : "lazy"} decoding="async" />
                <figcaption class="vframe-no" aria-hidden="true">{j.numeral}</figcaption>
              </figure>

              <div class="vtext">
                <p class="vmeta">
                  <span>{T.labels.duration(j.days, j.nights)}</span>
                  <i aria-hidden="true"></i>
                  <span>{jt.route}</span>
                </p>
                <h3>{jt.title}</h3>
                <p class="vkick">{jt.kicker}</p>
                <p class="vbody">{jt.body}</p>

                <div class="vprice">
                  <span class="vprice-from">{T.labels.from}</span>
                  <b>{eur(j.price2)}</b>
                  <span class="vprice-pp">{T.labels.perPersonTwo}</span>
                  <span class="vprice-four">{T.labels.perPersonFour(eur(j.price4))}</span>
                </div>

                <ul class="vincl">
                  {jt.highlights.map((h) => <li>{h}</li>)}
                </ul>
              </div>
            </div>

            <div class="wrap vdetail">
              <div class="vstays">
                <p class="vsub">{T.labels.stays}</p>
                <ol>
                  {j.stays.map((s) => (
                    <li>
                      <span class="vstay-n">{T.labels.nights(s.nights)}</span>
                      <b>{stayName(s.hotel)}</b>
                      <span class="vstay-where">{T.place[s.place]} · {T.room[s.room]}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <details class="vdays">
                <summary>{T.labels.dayByDay} <span>· {T.labels.duration(j.days, j.nights)}</span><i aria-hidden="true"></i></summary>
                <ol>
                  {jt.days.map((d, i) => (
                    <li><span class="vday-no">{T.labels.day} {i + 1}</span><b>{d.t}</b><p>{d.d}</p></li>
                  ))}
                </ol>
              </details>
              <div class="vfoot">
                <span class="vfoot-note">{T.labels.duration(j.days, j.nights)}</span>
                <a href={whatsappLink(T.whatsappJourney(jt.title))} target="_blank" rel="noopener" class="vfoot-link">
                  {T.labels.enquire(jt.title)} <b>→</b>
                </a>
              </div>
            </div>
            {idx < ultraJourneys.length - 1 && (
              <svg class="vdiv vdiv-sec" aria-hidden="true"><use href="#v-lotus" /></svg>
            )}
          </article>
        );
      })}

      <div class="wrap"><p class="vnote">{T.labels.priceNote(PEAK)}</p></div>
    </section>

    {/* ── How this tier is run ──────────────────────────────────────────── */}
    <section class="vhow">
      <div class="wrap">
        <p class="voverline"><span></span>{T.standardOverline}<span></span></p>
        <div class="vhow-grid">
          {T.standard.map((st, i) => (
            <div class="vhow-item">
              <span class="vhow-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h2>{st.title}</h2>
              <p>{st.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── The questions this clientele actually asks ────────────────────── */}
    <section class="vfaq">
      <div class="wrap">
        <p class="voverline"><span></span>{T.faqOverline}<span></span></p>
        <div class="vfaq-list">
          {faqs.map((f) => (
            <details class="vfaq-item">
              <summary>{f.q}<i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ── The close: an invitation card ─────────────────────────────────── */}
    <section class="vclose">
      <div class="wrap">
        <div class="vcard">
          <i class="vd vd-tl"></i><i class="vd vd-tr"></i>
          <i class="vd vd-bl"></i><i class="vd vd-br"></i>
          <svg class="vcrest vcrest-sm" aria-hidden="true"><use href="#v-wing" /></svg>
          <h2>{T.closeTitle}</h2>
          <p>{T.closeBody}</p>
          <div class="vhero-acts">
            <a href={wa} class="vbtn" target="_blank" rel="noopener"><span>{T.closeCta}</span></a>
            <a href={mail} class="vlink-quiet">{T.closeQuiet}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ==========================================================================
     Scoped palette. Ink is nearly black with a warm cast; the metals are three
     golds (deep, true, lit) so gradients read as metal rather than yellow; the
     crimson and emerald are dark enough to read as silk, not paint.
     ========================================================================== */
  .vip {
    --v-ink: #070503;
    --v-ink-2: #0D0A07;
    --v-cream: #F0E7D6;
    --v-cream-dim: #BCB09A;
    /* #8A8172, not #7A7263. The darker value measured 4.05:1 against this
       page's ground — under the 4.5:1 floor for text below 24px, on the page
       written for the clients least likely to forgive a squint. This one
       measures 5.01:1 and is the same grey to look at. */
    --v-faint: #8A8172;
    --v-gold-deep: #8A6D2A;
    --v-gold: #C2A24E;
    --v-gold-lit: #EFD9A0;
    --v-hair: rgba(194, 162, 78, .28);
    --v-hair-2: rgba(194, 162, 78, .55);
    --v-crimson: #7E1424;
    --v-crimson-lit: #A62436;
    --v-emerald: #0C4A39;
    --v-emerald-lit: #1A6B52;
    background:
      radial-gradient(110% 50% at 8% 4%, rgba(126, 20, 36, .12), transparent 60%),
      radial-gradient(110% 50% at 94% 30%, rgba(12, 74, 57, .1), transparent 60%),
      var(--v-ink);
    font-feature-settings: "liga", "kern";
    overflow: hidden;
  }
  .vip .wrap { max-width: 1220px; }
  .vdefs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* Overlines with flanking hairlines — nothing on this page is a bare label. */
  .voverline { display: flex; align-items: center; justify-content: center;
    gap:var(--s-4); font-size:var(--t-nano); letter-spacing: .5em; text-transform: uppercase;
    color: var(--v-gold); margin:0 0 var(--s-7); }
  .voverline span { width: 72px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--v-hair-2)); }
  .voverline span:last-child {
    background: linear-gradient(90deg, var(--v-hair-2), transparent); }

  /* Diamond joints used by every drawn frame. */
  .vd { position: absolute; width: 9px; height: 9px; transform: rotate(45deg);
    background: linear-gradient(135deg, var(--v-gold-lit), var(--v-gold-deep));
    box-shadow: 0 0 14px rgba(194, 162, 78, .55); }
  .vd-tl { top: -5px; left: -5px; } .vd-tr { top: -5px; right: -5px; }
  .vd-bl { bottom: -5px; left: -5px; } .vd-br { bottom: -5px; right: -5px; }

  /* ===== hero ============================================================ */
  .vhero { position: relative; min-height: 100vh; display: flex;
    align-items: center; justify-content: center; overflow: hidden;
    text-align: center; }
  /* ── WHY THIS HERO DOES NOT MOVE ─────────────────────────────────────────
     It used to: a 26s Ken Burns zoom (`vzoom`) on this layer and an 11s light
     sweep (`vsheen`) over it. Measured, they cost this page 23 of its 53
     frames per second — and the zoom's cost did not end with the animation.
     `forwards` leaves the final transform applied, which keeps a
     full-viewport layer promoted at a non-integer scale; the dust canvas
     composites over it on every frame, so every frame resamples it, forever.
     Stopping the transform entirely took the page from 30 to 53fps.

     30fps is a visible stutter. This is the page that says nothing here is
     rushed, written for the clients least willing to overlook a cheap finish —
     a hero that judders is worse than a hero that is still. The sheen stays as
     a fixed band of light across the engraving, which is what it looked like
     for most of its cycle anyway. */
  .vhero-bg { position: absolute; inset: 0;
    background: url("/images/luxor/luxor-karnak-hypostyle-hall.webp") center 30%/cover no-repeat; }
  .vhero-veil { position: absolute; inset: 0; background:
    radial-gradient(120% 90% at 50% 30%, rgba(7,5,3,.32) 0%, rgba(7,5,3,.86) 78%),
    linear-gradient(180deg, rgba(7,5,3,.55), rgba(7,5,3,.35) 40%, rgba(7,5,3,.96) 92%); }
  /* A fixed band of light across the engraving, struck a little off-centre so
     it reads as a shaft rather than a gradient. Wider and slightly stronger
     than the moving version, because it no longer has motion to be noticed by. */
  .vsheen { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 38%,
      rgba(239, 217, 160, .09) 50%, transparent 62%); }

  .vcart { position: absolute; inset: 118px 44px 44px; pointer-events: none;
    border: 1px solid var(--v-hair);
    /* cut corners: the hairline stops short of each corner */
    -webkit-mask: linear-gradient(#000, #000);
    }
  .vcart::before { content: ""; position: absolute; inset: 8px;
    border: 1px solid rgba(194, 162, 78, .13); }

  .vhero-in { position: relative; z-index: 2; padding: 170px 0 120px; }

  .vcrest { width: clamp(210px, 26vw, 320px); height: auto; aspect-ratio: 340/72;
    color: var(--v-gold); margin: 0 auto 30px; display: block;
    filter: drop-shadow(0 6px 26px rgba(194, 162, 78, .38)); }
  .vcrest-sm { width: 190px; margin-bottom:var(--s-4); }

  .vtag { display: inline-flex; align-items: center; gap:var(--s-3);
    font-size:var(--t-nano); letter-spacing: .52em; text-transform: uppercase;
    color: var(--v-gold-lit); margin:0 0 var(--s-6); }
  .vtag span { width: 44px; height: 1px; flex: none;
    background: linear-gradient(90deg, transparent, var(--v-hair-2)); }
  .vtag span:last-child { background: linear-gradient(90deg, var(--v-hair-2), transparent); }

  .vhero h1 { margin: 0; font-weight: 300;
    /* Same clamp as `.hero h1` in global.css, to the decimal. It used to be
       6.6rem against the site's 6.8rem, which rendered 105.6px here and
       108.8px on the home page — a 3px difference nobody chose and nobody
       could see, but it meant the site had three H1 sizes instead of two. */
    font-size: clamp(3rem, 7.6vw, 6.8rem); line-height: 1.03;
    color: var(--v-cream); letter-spacing: .01em;
    text-shadow: 0 4px 60px rgba(0,0,0,.6); }
  .vhero h1 em { font-style: italic; font-weight: 300;
    background: linear-gradient(176deg, #FFF4D6 8%, #E3C36A 48%, #A5822F 90%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 8px 42px rgba(194, 162, 78, .4));
    padding-bottom: .08em; }

  .vdiv { width: clamp(280px, 40vw, 480px); height: auto; aspect-ratio: 480/40;
    color: var(--v-gold); display: block; margin: 34px auto 30px; opacity: .9; }
  .vdiv-sec { margin: 96px auto 0; opacity: .55; width: min(480px, 72vw); }

  .vlede { max-width: 620px; margin: 0 auto; color: var(--v-cream-dim);
    font-size:var(--t-base); line-height: 2; }

  .vhero-acts { display: flex; align-items: center; justify-content: center;
    gap:var(--s-5); flex-wrap: wrap; margin-top:var(--s-6); }
  /* The button is a jewel: gold bevel border, dark body, gold sheen on hover. */
  .vbtn { position: relative; display: inline-flex; padding: 1px;
    background: linear-gradient(160deg, var(--v-gold-lit), var(--v-gold-deep) 55%, var(--v-gold-lit));
    box-shadow: 0 18px 44px -18px rgba(194, 162, 78, .55); }
  .vbtn span { display: inline-flex; align-items: center; padding:var(--s-3) var(--s-6);
    background: linear-gradient(180deg, #191308, #0C0905);
    color: var(--v-gold-lit); font-size:var(--t-nano); letter-spacing: .34em;
    text-transform: uppercase; transition: background .5s, color .5s; }
  .vbtn:hover span { background: linear-gradient(180deg, var(--v-gold-lit), var(--v-gold));
    color: #14100A; }
  .vlink-quiet { color: var(--v-faint); font-size:var(--t-tiny); letter-spacing: .06em;
    border-bottom: 1px solid rgba(194, 162, 78, .3); padding-bottom: 3px;
    transition: color .4s, border-color .4s; }
  .vlink-quiet:hover { color: var(--v-gold-lit); border-color: var(--v-gold); }

  .vband { position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: linear-gradient(90deg, transparent,
      var(--v-crimson) 25%, var(--v-gold) 50%, var(--v-emerald) 75%, transparent); }

  /* ===== the three facts ================================================= */
  .vfacts { border-bottom: 1px solid var(--v-hair);
    background: linear-gradient(180deg, var(--v-ink-2), transparent); }
  .vfacts-in { display: grid; grid-template-columns: repeat(3, 1fr);
    padding: 58px 0; }
