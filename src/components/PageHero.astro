---
// PageHero — the centred header used by every inner page: breadcrumb, an
// optional gold symbol, the H1 and a short lede. An optional hero image renders
// full-width beneath the header when `heroSrc` is supplied.
import SymbolIcon from "@/components/SymbolIcon.astro";
import Placeholder from "@/components/Placeholder.astro";

interface Props {
  title: string;
  text?: string;
  /** SymbolIcon name to show above the heading. */
  symbol?: string;
  /** Breadcrumb leaf label (the root is prepended automatically). */
  crumb?: string;
  /** Root crumb label and href — overridden on localised pages so the trail
   *  reads "Startseite · Sicherheit" and points at /de/, not at the English
   *  home page. */
  rootLabel?: string;
  rootHref?: string;
  /** Accepted for call-site consistency with the other hero components.
   *  No longer used here: the Home link is the absolute "/" at every depth. */
  base?: string;
  /** Optional hero photo shown beneath the header. */
  heroSrc?: string;
  heroAlt?: string;
  heroWidth?: number;
  heroHeight?: number;
}
const {
  title, text = "", symbol = "", crumb = "",
  rootLabel = "Home", rootHref = "/",
  heroSrc, heroAlt, heroWidth, heroHeight,
} = Astro.props;
---
<header class="phero">
  <div class="wrap">
    {crumb && (
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={rootHref}>{rootLabel}</a> · <span>{crumb}</span>
      </nav>
    )}
    {symbol && <div class="sym"><SymbolIcon name={symbol} /></div>}
    <h1>{title}</h1>
    {text && <p>{text}</p>}
  </div>
</header>
{heroSrc && (
  <section style="padding-top:18px;padding-bottom:0">
    <div class="wrap">
      <Placeholder class="tgallery reveal cur" src={heroSrc} alt={heroAlt ?? title} width={heroWidth} height={heroHeight} loading="eager" />
    </div>
  </section>
)}
