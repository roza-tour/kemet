---
// LangSwitch — the language chooser for pages that have translations.
//
// A LINK, never a redirect. Automatic language switching by browser header or
// IP is the classic way to make translated pages invisible to search: Googlebot
// crawls predominantly from the United States, so it would only ever be shown
// the English version and the other languages would never be indexed. The
// visitor chooses; nothing chooses for them.
//
// Renders nothing at all on pages with no translations.
import { alternatesFor, LOCALE_META, localeOfRoute, basePrefixFor } from "@/config/i18n";
import { publicPath } from "@/utils/links";
import type { SiteLocale } from "@/config/i18n";

interface Props {
  /** Route file of the current page. */
  route: string;
  /** Distinguishes the two placements (top of page and footer) so a screen
   *  reader's landmark list does not show two identically-named navigations. */
  label?: string;
}
const { route, label = "Language" } = Astro.props;

const alternates = alternatesFor(route).filter((a) => a.hreflang !== "x-default");
const current = localeOfRoute(route);
const base = basePrefixFor(route);

// TRANSLATED page → the switcher points at THIS page in each language, and
// those links carry hreflang because they really are alternates of each other.
//
// UNTRANSLATED page → it used to render nothing at all, which meant that on
// 190 of the site's 221 pages there was no way to discover that the site exists
// in eight languages. A French visitor landing on a destination page from
// search saw an English site and no exit. The switcher now falls back to
// linking each locale's HOME page.
//
// Those fallback links deliberately carry NO hreflang attribute. A destination
// page and a French home page are not translations of one another, and saying
// otherwise is the false alternate declaration that gets a cluster discarded.
// They are navigation, nothing more — which is exactly what they are for.
const homes = alternatesFor("index.html").filter((a) => a.hreflang !== "x-default");
const isTranslated = alternates.length > 1;
const entries = isTranslated ? alternates : homes;

// The visible word, in the language of the page it sits on. It used to be the
// literal string "Language" on every page, so an Indonesian page headed a
// block of Indonesian with an English label — the one word on the page that
// announced the translation was not itself translated.
const heading = LOCALE_META[(current ?? "en") as SiteLocale].language;
---
{entries.length > 1 && (
  <nav class="lsw" aria-label={label}>
    <span class="lsw-label">{heading}</span>
    <ul>
      {entries.map((a) => {
        const loc = a.hreflang as SiteLocale;
        const isCurrent = isTranslated ? loc === current : loc === current && current !== "en";
        return (
          <li>
            <a
              href={`${base}${publicPath(a.route)}` || "/"}
              hreflang={isTranslated ? a.hreflang : undefined}
              lang={a.hreflang}
              class={isCurrent ? "is-current" : undefined}
              aria-current={isCurrent ? "true" : undefined}
            >
              <b>{LOCALE_META[loc].short}</b>
              <span>{LOCALE_META[loc].endonym}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .lsw { display: flex; align-items: center; gap:var(--s-3); flex-wrap: wrap;
    padding:var(--s-2) 0 4px; border-bottom: 1px solid var(--line); margin-bottom:var(--s-1); }
  .lsw-label { font-size:var(--t-nano); letter-spacing: .28em; text-transform: uppercase;
    color: var(--muted-2); }
  .lsw ul { list-style: none; display: flex; gap:var(--s-1); margin: 0; padding: 0; flex-wrap: wrap; }
  .lsw a { display: inline-flex; align-items: baseline; gap:var(--s-1);
    padding:var(--s-1) var(--s-2); min-height: 44px; align-content: center; border-radius: 20px;
    border: 1px solid var(--line); transition: border-color .3s, color .3s, background .3s; }
  .lsw a b { font-weight: 500; font-size:var(--t-micro); letter-spacing: .12em; color: var(--muted); }
  .lsw a span { font-size:var(--t-tiny); color: var(--muted-2); }
  .lsw a:hover { border-color: var(--gold); }
  .lsw a:hover b, .lsw a:hover span { color: var(--gold-bright); }
  .lsw a.is-current { border-color: var(--gold); background: rgba(217,180,90,.08); }
  .lsw a.is-current b { color: var(--gold-bright); }
  .lsw a.is-current span { color: var(--gold); }

  @media(max-width:520px){
    .lsw a span { display: none; }
    .lsw a { padding:var(--s-1) var(--s-2); }
  }
</style>
