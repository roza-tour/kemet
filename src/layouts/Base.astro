---
import "@/styles/fonts.css";
import "@/styles/global.css";
import {
  site, OG_LOCALE,
  OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT,
  GEO_REGION, GEO_PLACENAME, GEO_POSITION,
} from "@/config/site";
import { relativePrefix } from "@/config/routes";
import { buildPageSeo } from "@/utils/seo";
import { siteSchema } from "@/schemas/jsonld";
import { enhanceScript } from "@/scripts/enhance";
import type { JsonLd } from "@/types";
import { localeOfRoute, alternatesFor, LOCALE_META } from "@/config/i18n";
import { canonical } from "@/utils/links";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import CTA from "@/components/CTA.astro";
import SvgDefs from "@/components/SvgDefs.astro";
import WhatsAppButton from "@/components/conversion/WhatsAppButton.astro";
import SeasonalSkin from "@/components/SeasonalSkin.astro";

interface Props {
  title?: string;
  description?: string;
  /** Route file of this page, e.g. "tours.html" — drives canonical + active nav. */
  active?: string;
  /** Page-specific structured data. */
  jsonld?: JsonLd | JsonLd[];
  showCta?: boolean;
  /** When true, tell crawlers not to index this page (e.g. the 404 page). */
  noindex?: boolean;
  /** Comma-separated keywords for this page (falls back to the site default). */
  keywords?: string;
  /** Share-image overrides. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { active = "index.html", jsonld, showCta = true } = Astro.props;

// Resolve SEO once, so every page inherits the same defaults (utils/seo).
const { title, description, canonicalUrl, ogImage, ogImageAlt, keywords } = buildPageSeo({
  title: Astro.props.title,
  description: Astro.props.description,
  route: active,
  keywords: Astro.props.keywords,
  ogImage: Astro.props.ogImage,
  ogImageAlt: Astro.props.ogImageAlt,
});
// Link prefix so shared nav/footer resolve from any directory depth.
// Root pages → "" (output unchanged); /destinations/* → "../".
const base = relativePrefix(active);
const pageLd = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];

// --- Localisation -----------------------------------------------------------
// The locale is derived from the route, and the hreflang set comes from the
// translation registry, so a page can never declare an alternate that another
// page does not declare back. Pages with no translations emit only the
// site-wide English/x-default pair.
const pageLocale = localeOfRoute(active);
const htmlLang = LOCALE_META[pageLocale].tag;
const alternates = alternatesFor(active);
// og:locale follows the page, and the other members of the group are declared
// as og:locale:alternate so social previews resolve to the right language.
const OG_LOCALE_BY_LANG: Record<string, string> = {
  en: OG_LOCALE, de: "de_DE", it: "it_IT", es: "es_ES",
};
const ogLocale = OG_LOCALE_BY_LANG[pageLocale] ?? OG_LOCALE;
const ogLocaleAlternates = alternates
  .filter((a) => a.hreflang !== "x-default" && a.hreflang !== pageLocale)
  .map((a) => OG_LOCALE_BY_LANG[a.hreflang])
  .filter(Boolean);
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google Search Console — site ownership verification (HTML-tag method). -->
  <meta name="google-site-verification" content="KpsvY-0-G6RYJRLd8UJLs2pI5eBHZPFHsaWbJIEhDIw" />
  <!--
    Bing Webmaster Tools — site ownership verification.
    Bing accepts any one of three proofs; we ship two so a single point of
    failure cannot un-verify the site: this meta tag, and the XML file at
    /BingSiteAuth.xml (public/BingSiteAuth.xml, byte-identical to the file Bing
    issued). Both carry the same code. Leave both in place permanently —
    Bing re-checks ownership periodically and removing the proof drops the site.
    This matters beyond Bing itself: Bing's index feeds ChatGPT Search,
    Copilot, DuckDuckGo and Yahoo, and it is the endpoint our IndexNow ping
    in update.sh notifies on every publish.
  -->
  <meta name="msvalidate.01" content="5D3CF7281731A894F620497D79317F74" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />
  {/* hreflang. Where a page has translations the set is generated from the
      registry in config/i18n and is self-referential and reciprocal — the
      requirement Google enforces before it will honour any of it. Pages with no
      translations keep the site-wide English/x-default pair. */}
  {alternates.length > 0
    ? alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={canonical(alt.route)} />
      ))
    : (
      <>
        <link rel="alternate" hreflang="en" href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}
  {/* Let search + answer engines show large images and full snippets (rich
      results / AI answers). Pages flagged noindex opt out. */}
  {Astro.props.noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  {!Astro.props.noindex && <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />}
  <meta name="author" content={site.name} />
  <meta name="publisher" content={site.name} />
  {/* Geo-targeting */}
  <meta name="geo.region" content={GEO_REGION} />
  <meta name="geo.placename" content={GEO_PLACENAME} />
  <meta name="geo.position" content={GEO_POSITION} />
  <meta name="ICBM" content={GEO_POSITION.replace(";", ", ")} />
  <meta name="theme-color" content="#0B0907" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={ogLocale} />
  {ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
  <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  {/* Fonts are self-hosted (src/styles/fonts.css → /fonts/*.woff2) — no
      external font requests. */}
  {siteSchema().map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
  {pageLd.map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <canvas id="dust" aria-hidden="true"></canvas>
  <SvgDefs />
  <Nav active={active} base={base} />
  <SeasonalSkin />
  <main id="main"><slot /></main>
  {showCta && <CTA base={base} />}
  <Footer base={base} route={active} />
  <WhatsAppButton />
  <script is:inline set:html={enhanceScript}></script>
</body>
</html>
